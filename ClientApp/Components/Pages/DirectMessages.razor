@page "/dm"
@inject ApiClientService Api
@inject AuthStateProvider Auth
@inject ChatClientService Chat

<div class="dm-layout">
    <aside class="contacts-list">
        <div class="contacts-header">
            <h4>Contacts</h4>
        </div>
        @foreach (var contact in _contacts)
        {
            <div class="contact-item @(contact.Id == _selectedContactId ? "active" : "")"
                 @onclick="() => SelectContact(contact)">
                <span class="contact-name">@contact.DisplayName</span>
                <span class="contact-username">@@@contact.UserName</span>
            </div>
        }

        @if (_contacts.Length == 0)
        {
            <div class="empty-state">No conversations yet</div>
        }
    </aside>

    <section class="dm-chat-area">
        @if (_selectedContact != null)
        {
            <div class="dm-header">
                <h4>@_selectedContact.DisplayName</h4>
                <span class="dm-username">@@@_selectedContact.UserName</span>
            </div>

            <div class="dm-messages">
                @foreach (var msg in _messages)
                {
                    <div class="dm-message @(msg.SenderId == Auth.CurrentUser?.Id ? "own" : "")">
                        <div class="dm-message-header">
                            <span class="dm-sender">@msg.SenderName</span>
                            <span class="dm-time">@msg.SentAt.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                        <div class="dm-content">@msg.Content</div>
                        @if (msg.Attachments.Length > 0)
                        {
                            <div class="dm-attachments">
                                @foreach (var att in msg.Attachments)
                                {
                                    <a href="@att.Url" target="_blank" class="dm-att-link">@att.FileName</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="dm-input">
                <textarea @bind="_messageText" @onkeydown="HandleKeyDown" placeholder="Type a message..." rows="1"></textarea>
                <button class="btn-primary" @onclick="SendMessage" disabled="@string.IsNullOrWhiteSpace(_messageText)">Send</button>
            </div>
        }
        else
        {
            <div class="no-contact-selected">
                <p>Select a contact to start messaging</p>
            </div>
        }
    </section>
</div>

@code {
    private UserInfo[] _contacts = [];
    private Guid? _selectedContactId;
    private UserInfo? _selectedContact;
    private List<PrivateMessage> _messages = [];
    private string _messageText = "";

    protected override async Task OnInitializedAsync()
    {
        Chat.OnPrivateMessageReceived += OnPrivateMessageReceived;

        try
        {
            _contacts = await Api.GetContactsAsync();
        }
        catch { }
    }

    private async Task SelectContact(UserInfo contact)
    {
        _selectedContactId = contact.Id;
        _selectedContact = contact;
        _messages.Clear();

        try
        {
            await Chat.MarkPrivateMessageReadAsync(contact.Id);
            var msgs = await Api.GetPrivateMessagesAsync(contact.Id);
            _messages = msgs.Reverse().ToList();
        }
        catch { }

        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText) || _selectedContactId == null) return;
        var text = _messageText;
        _messageText = "";
        try
        {
            await Chat.SendPrivateMessageAsync(_selectedContactId.Value, text);
        }
        catch { }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void OnPrivateMessageReceived(PrivateMessage message)
    {
        if (message.SenderId == _selectedContactId || message.RecipientId == _selectedContactId)
        {
            _messages.Add(message);
            InvokeAsync(StateHasChanged);
        }
    }
}
