@page "/voice"
@inject AuthStateProvider Auth
@inject ChatClientService Chat
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="voice-layout">
    <div class="voice-header">
        <h4>Voice / Video Room</h4>
        @if (_roomId != Guid.Empty)
        {
            <span class="room-label">Room: @_roomId</span>
        }
    </div>

    <div class="video-grid">
        <div class="video-cell local">
            <video id="localVideo" autoplay muted playsinline></video>
            <span class="video-label">You</span>
        </div>
        @foreach (var userId in _participants)
        {
            <div class="video-cell">
                <video id="remoteVideo-@userId" autoplay playsinline></video>
                <span class="video-label">@userId.ToString()[..8]</span>
            </div>
        }
    </div>

    <div class="voice-controls">
        @if (!_inCall)
        {
            <button class="btn-primary" @onclick="JoinCall">Join Call</button>
        }
        else
        {
            <button class="btn-secondary" @onclick="ToggleMute">
                @(_isMuted ? "Unmute" : "Mute")
            </button>
            <button class="btn-secondary" @onclick="ToggleCamera">
                @(_cameraOff ? "Camera On" : "Camera Off")
            </button>
            <button class="btn-danger" @onclick="LeaveCall">Leave</button>
        }
    </div>
</div>

@code {
    private Guid _roomId;
    private bool _inCall;
    private bool _isMuted;
    private bool _cameraOff;
    private List<Guid> _participants = [];
    private JanusSessionInfo? _sessionInfo;

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var roomParam = query["room"];
        if (Guid.TryParse(roomParam, out var roomId))
        {
            _roomId = roomId;
        }

        Chat.OnUserJoinedVoiceVideo += OnParticipantJoined;
        Chat.OnUserLeftVoiceVideo += OnParticipantLeft;
        Chat.OnWebRtcSignalReceived += OnWebRtcSignal;
    }

    private async Task JoinCall()
    {
        if (_roomId == Guid.Empty) return;

        try
        {
            _sessionInfo = await Chat.JoinVoiceVideoAsync(_roomId);
            _inCall = true;

            await JS.InvokeVoidAsync("webrtc.init", _sessionInfo.JanusUrl, _sessionInfo.IceServers);
            await JS.InvokeVoidAsync("webrtc.startLocalStream", true, true);
        }
        catch { }
    }

    private async Task LeaveCall()
    {
        try
        {
            await Chat.LeaveVoiceVideoAsync(_roomId);
            await JS.InvokeVoidAsync("webrtc.stop");
            _inCall = false;
            _participants.Clear();
        }
        catch { }
    }

    private async Task ToggleMute()
    {
        _isMuted = !_isMuted;
        await JS.InvokeVoidAsync("webrtc.toggleMute", _isMuted);
    }

    private async Task ToggleCamera()
    {
        _cameraOff = !_cameraOff;
        await JS.InvokeVoidAsync("webrtc.toggleCamera", _cameraOff);
    }

    private void OnParticipantJoined(Guid roomId, Guid userId)
    {
        if (roomId != _roomId || userId == Auth.CurrentUser?.Id) return;
        if (!_participants.Contains(userId))
        {
            _participants.Add(userId);
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnParticipantLeft(Guid roomId, Guid userId)
    {
        if (roomId != _roomId) return;
        _participants.Remove(userId);
        InvokeAsync(StateHasChanged);
    }

    private async void OnWebRtcSignal(Guid roomId, Guid fromUserId, string signalType, string payload)
    {
        if (roomId != _roomId) return;
        try
        {
            await JS.InvokeVoidAsync("webrtc.handleSignal", fromUserId.ToString(), signalType, payload);
        }
        catch { }
    }
}
