<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChatApp.Ui.ViewModels"
             xmlns:models="using:Shared.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="ChatApp.Ui.Views.ShellView"
             x:DataType="vm:ShellViewModel">

  <UserControl.Resources>
    <!-- One attachment: inline image when decodable, file chip otherwise. Shared by
         room and DM message templates. -->
    <DataTemplate x:Key="AttachmentTemplate" x:DataType="vm:AttachmentItemViewModel">
      <Panel Margin="0,4,8,0">
        <Button Background="Transparent"
                Padding="0"
                Command="{Binding OpenCommand}"
                IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="{Binding FileName}">
          <Border CornerRadius="6" ClipToBounds="True">
            <Image Source="{Binding Image}"
                   MaxHeight="240"
                   MaxWidth="360"
                   Stretch="Uniform" />
          </Border>
        </Button>

        <Button Padding="10,6"
                Command="{Binding OpenCommand}"
                IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="📎" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FileName}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="220" />
            <TextBlock Text="{Binding SizeLabel}"
                       Opacity="0.6"
                       FontSize="11"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Panel>
    </DataTemplate>

  </UserControl.Resources>

  <Panel>
  <Grid ColumnDefinitions="240,*,Auto">

    <!-- Sidebar: rooms and direct messages -->
    <DockPanel Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">

      <Border DockPanel.Dock="Bottom" Padding="12" >
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
            <Button Content="⚙"
                    FontSize="16"
                    Padding="8,4"
                    Command="{Binding OpenSettingsCommand}"
                    Background="Transparent"
                    ToolTip.Tip="Settings" />
            <Button Content="Sign out"
                    Command="{Binding SignOutCommand}"
                    Background="Transparent" />
          </StackPanel>
          <TextBlock Text="{Binding CurrentUserName}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>

      <ScrollViewer>
        <StackPanel>
          <DockPanel Margin="12,12,12,6">
            <Button DockPanel.Dock="Right"
                    Content="+"
                    FontSize="14"
                    Padding="8,0"
                    Background="Transparent"
                    Command="{Binding OpenCreateRoomCommand}"
                    ToolTip.Tip="Create a room" />
            <TextBlock Text="Rooms"
                       FontWeight="SemiBold"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
          </DockPanel>

          <ListBox ItemsSource="{Binding RoomItems}"
                   SelectedItem="{Binding SelectedRoomItem}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RoomItemViewModel">
                <StackPanel>
                  <DockPanel>
                    <!-- Options: rename/delete gated to owner/Admin; notification mode
                         for everyone — muting a noisy room is personal, not moderation. -->
                    <Button DockPanel.Dock="Right"
                            Content="⋯"
                            FontSize="11"
                            Padding="5,0"
                            Background="Transparent"
                            ToolTip.Tip="Room options">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="Notifications">
                            <MenuItem Header="All messages"
                                      Command="{Binding NotifyAllCommand, x:DataType=vm:RoomItemViewModel}"
                                      CommandParameter="{Binding x:DataType=vm:RoomItemViewModel}" />
                            <MenuItem Header="Mentions only"
                                      Command="{Binding NotifyMentionsCommand, x:DataType=vm:RoomItemViewModel}"
                                      CommandParameter="{Binding x:DataType=vm:RoomItemViewModel}" />
                            <MenuItem Header="Muted"
                                      Command="{Binding NotifyMutedCommand, x:DataType=vm:RoomItemViewModel}"
                                      CommandParameter="{Binding x:DataType=vm:RoomItemViewModel}" />
                          </MenuItem>
                          <MenuItem Header="Rename room"
                                    IsVisible="{Binding CanManage, x:DataType=vm:RoomItemViewModel}"
                                    Command="{Binding RenameCommand, x:DataType=vm:RoomItemViewModel}"
                                    CommandParameter="{Binding x:DataType=vm:RoomItemViewModel}" />
                          <MenuItem Header="Delete room"
                                    IsVisible="{Binding CanManage, x:DataType=vm:RoomItemViewModel}"
                                    Command="{Binding DeleteCommand, x:DataType=vm:RoomItemViewModel}"
                                    CommandParameter="{Binding x:DataType=vm:RoomItemViewModel}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>

                    <!-- Unread badge, same look as the DM roster's. -->
                    <Border DockPanel.Dock="Right"
                            Background="#E11D48"
                            CornerRadius="8"
                            MinWidth="18"
                            Padding="5,1"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasUnread}">
                      <TextBlock Text="{Binding UnreadCount}"
                                 Foreground="White"
                                 FontSize="11"
                                 HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="🎥"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="#22C55E"
                                 IsVisible="{Binding HasActiveCall}" />
                      <TextBlock Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>

                  <!-- Call participants nested under the room, as in the Blazor
                       sidebar. Right-click one for moderation. -->
                  <ItemsControl ItemsSource="{Binding CallParticipants}" Margin="14,2,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CallParticipantItem">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,2"
                                    Background="Transparent">

                          <StackPanel.ContextFlyout>
                            <MenuFlyout>
                              <MenuItem Header="Kick from call"
                                        IsVisible="{Binding CanModerate, x:DataType=vm:CallParticipantItem}"
                                        Command="{Binding RemoveFromCallCommand, x:DataType=vm:CallParticipantItem}"
                                        CommandParameter="{Binding x:DataType=vm:CallParticipantItem}" />
                              <MenuItem Header="Move to room"
                                        IsVisible="{Binding CanMove, x:DataType=vm:CallParticipantItem}"
                                        ItemsSource="{Binding MoveTargets, x:DataType=vm:CallParticipantItem}">
                                <MenuItem.ItemContainerTheme>
                                  <ControlTheme TargetType="MenuItem"
                                                BasedOn="{StaticResource {x:Type MenuItem}}"
                                                x:DataType="vm:MoveTarget">
                                    <Setter Property="Header" Value="{Binding TargetName}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                  </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                              </MenuItem>
                              <MenuItem Header="Set role"
                                        IsVisible="{Binding AssignableRoles.Count, x:DataType=vm:CallParticipantItem}"
                                        ItemsSource="{Binding AssignableRoles, x:DataType=vm:CallParticipantItem}">
                                <MenuItem.ItemContainerTheme>
                                  <ControlTheme TargetType="MenuItem"
                                                BasedOn="{StaticResource {x:Type MenuItem}}"
                                                x:DataType="vm:RoleTarget">
                                    <Setter Property="Header" Value="{Binding Label}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                  </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                              </MenuItem>
                            </MenuFlyout>
                          </StackPanel.ContextFlyout>

                          <Border Width="18" Height="18"
                                  CornerRadius="9"
                                  Background="#B4842C">
                            <TextBlock Text="{Binding Initial}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>

                          <TextBlock Text="{Binding Name}"
                                     FontSize="12"
                                     Opacity="0.85"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />

                          <!-- Visible moderation entry point, as in the Blazor row. -->
                          <Button Content="⋯"
                                  FontSize="11"
                                  Padding="5,0"
                                  Background="Transparent"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding HasActions}"
                                  ToolTip.Tip="Moderation">
                            <Button.Flyout>
                              <MenuFlyout>
                                <MenuItem Header="Kick from call"
                                          IsVisible="{Binding CanModerate, x:DataType=vm:CallParticipantItem}"
                                          Command="{Binding RemoveFromCallCommand, x:DataType=vm:CallParticipantItem}"
                                          CommandParameter="{Binding x:DataType=vm:CallParticipantItem}" />
                                <MenuItem Header="Move to room"
                                          IsVisible="{Binding CanMove, x:DataType=vm:CallParticipantItem}"
                                          ItemsSource="{Binding MoveTargets, x:DataType=vm:CallParticipantItem}">
                                  <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem"
                                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                                  x:DataType="vm:MoveTarget">
                                      <Setter Property="Header" Value="{Binding TargetName}" />
                                      <Setter Property="Command" Value="{Binding Command}" />
                                      <Setter Property="CommandParameter" Value="{Binding}" />
                                    </ControlTheme>
                                  </MenuItem.ItemContainerTheme>
                                </MenuItem>
                                <MenuItem Header="Set role"
                                          IsVisible="{Binding AssignableRoles.Count, x:DataType=vm:CallParticipantItem}"
                                          ItemsSource="{Binding AssignableRoles, x:DataType=vm:CallParticipantItem}">
                                  <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem"
                                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                                  x:DataType="vm:RoleTarget">
                                      <Setter Property="Header" Value="{Binding Label}" />
                                      <Setter Property="Command" Value="{Binding Command}" />
                                      <Setter Property="CommandParameter" Value="{Binding}" />
                                    </ControlTheme>
                                  </MenuItem.ItemContainerTheme>
                                </MenuItem>
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="Direct messages"
                     Margin="12,16,12,6"
                     FontWeight="SemiBold"
                     Opacity="0.7" />

          <ListBox ItemsSource="{Binding Dm.Contacts}"
                   SelectedItem="{Binding Dm.SelectedContact}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContactItemViewModel">
                <DockPanel Background="Transparent">

                  <DockPanel.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="Mute notifications"
                                IsVisible="{Binding !IsMuted, x:DataType=vm:ContactItemViewModel}"
                                Command="{Binding MuteCommand, x:DataType=vm:ContactItemViewModel}"
                                CommandParameter="{Binding x:DataType=vm:ContactItemViewModel}" />
                      <MenuItem Header="Unmute notifications"
                                IsVisible="{Binding IsMuted, x:DataType=vm:ContactItemViewModel}"
                                Command="{Binding MuteCommand, x:DataType=vm:ContactItemViewModel}"
                                CommandParameter="{Binding x:DataType=vm:ContactItemViewModel}" />
                    </MenuFlyout>
                  </DockPanel.ContextFlyout>
                  <!-- Presence dot -->
                  <Ellipse DockPanel.Dock="Left"
                           Width="8" Height="8"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Fill="{Binding IsOnline, Converter={x:Static vm:DmConverters.OnlineBrush}}" />

                  <!-- Unread badge -->
                  <Border DockPanel.Dock="Right"
                          Background="#E11D48"
                          CornerRadius="8"
                          MinWidth="18"
                          Padding="5,1"
                          IsVisible="{Binding HasUnread}">
                    <TextBlock Text="{Binding UnreadCount}"
                               Foreground="White"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                  </Border>

                  <TextBlock Text="🔕"
                             DockPanel.Dock="Right"
                             FontSize="11"
                             Margin="4,0"
                             Opacity="0.6"
                             VerticalAlignment="Center"
                             IsVisible="{Binding IsMuted}" />

                  <TextBlock Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Main pane: shared call surface on top, then room chat or DM thread -->
    <DockPanel Grid.Column="1">

      <!-- Video sits above whichever transcript is open. Docked rather than given a
           grid row so it collapses to nothing between calls. -->
      <ContentControl DockPanel.Dock="Top"
                      Content="{Binding Call}"
                      IsVisible="{Binding IsInCall}"
                      MinHeight="260"
                      MaxHeight="520" />

      <Panel>

        <!-- ─── Room chat ───────────────────────────────────────── -->
        <DockPanel IsVisible="{Binding !IsDmOpen}">

          <Border DockPanel.Dock="Top" Padding="16,12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Join call"
                        Command="{Binding JoinCallCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding !IsInCall}"
                        Classes="accent" />
                <ToggleButton Content="{Binding IsMuted, Converter={x:Static BoolConverters.Not}, StringFormat='Mic {0}'}"
                              Command="{Binding ToggleMuteCommand}"
                              IsChecked="{Binding IsMuted, Mode=OneWay}"
                              IsVisible="{Binding IsInCall}" />
                <ToggleButton Content="Camera"
                              Command="{Binding ToggleCameraCommand}"
                              IsChecked="{Binding IsCameraOn, Mode=OneWay}"
                              IsEnabled="{Binding !IsBusy}"
                              IsVisible="{Binding IsInCall}" />
                <ToggleButton Content="Share"
                              Command="{Binding ToggleScreenShareCommand}"
                              IsChecked="{Binding IsScreenSharing, Mode=OneWay}"
                              IsEnabled="{Binding !IsBusy}"
                              IsVisible="{Binding IsInCall}"
                              ToolTip.Tip="Share a screen" />
                <Button Content="Leave"
                        Command="{Binding LeaveCallCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding IsInCall}" />
              </StackPanel>

              <Button DockPanel.Dock="Right"
                      Content="👥"
                      FontSize="14"
                      Margin="8,0,0,0"
                      Background="Transparent"
                      Command="{Binding Members.ToggleCommand}"
                      ToolTip.Tip="Members" />

              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedRoom.Name, FallbackValue='Select a room'}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding RoomCallSummary, StringFormat='📞 {0}'}"
                           FontSize="12"
                           Foreground="#22C55E"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding RoomCallSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding CallStatus}"
                           FontSize="12"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding CallStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" Padding="12">
            <StackPanel Spacing="6">

              <!-- Uploaded files waiting to be sent -->
              <ItemsControl ItemsSource="{Binding PendingAttachments}"
                            IsVisible="{Binding PendingAttachments.Count}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PendingAttachment">
                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        <Button Content="✕" FontSize="10" Padding="3,0"
                                Background="Transparent"
                                Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).RemovePendingAttachmentCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Mention autocomplete, floating above the composer -->
              <Border IsVisible="{Binding IsMentionPopupOpen}"
                      Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                      CornerRadius="6"
                      Padding="4"
                      BoxShadow="0 2 12 0 #44000000">
                <ItemsControl ItemsSource="{Binding MentionCandidates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MentionCandidate">
                      <Button HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="8,4"
                              Background="Transparent"
                              Click="OnMentionCandidateClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Handle}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Label}" Opacity="0.6"
                                     IsVisible="{Binding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Send"
                        Margin="8,0,0,0"
                        Command="{Binding SendCommand}"
                        Classes="accent" />
                <Button DockPanel.Dock="Right"
                        Content="📎"
                        Margin="8,0,0,0"
                        Command="{Binding AttachFileCommand}"
                        IsEnabled="{Binding !IsUploading}"
                        ToolTip.Tip="Attach files" />
                <TextBox x:Name="RoomComposer"
                         Watermark="Message  (@ to mention)"
                         Text="{Binding Draft}"
                         AcceptsReturn="False"
                         TextChanged="OnComposerTextChanged"
                         KeyDown="OnComposerKeyDown" />
              </DockPanel>
            </StackPanel>
          </Border>

          <TextBlock DockPanel.Dock="Bottom"
                     Text="{Binding Error}"
                     Margin="12,0"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Messages}" Margin="16,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageItemViewModel">
                  <!-- Messages that mention you carry a tinted bar, matching the
                       Blazor highlight. -->
                  <Border Margin="0,2"
                          Padding="8,4"
                          CornerRadius="4"
                          Background="{Binding IsMentioningMe, Converter={x:Static vm:DmConverters.MentionBackground}}">
                  <StackPanel Background="Transparent">

                    <StackPanel.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="Delete message"
                                  IsVisible="{Binding CanDelete, x:DataType=vm:MessageItemViewModel}"
                                  Command="{Binding DeleteCommand, x:DataType=vm:MessageItemViewModel}"
                                  CommandParameter="{Binding x:DataType=vm:MessageItemViewModel}" />
                      </MenuFlyout>
                    </StackPanel.ContextFlyout>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding SenderName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding SentAt, StringFormat='{}{0:t}'}" Opacity="0.5" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                               IsVisible="{Binding HasContent}" />

                    <ItemsControl ItemsSource="{Binding Attachments}"
                                  ItemTemplate="{StaticResource AttachmentTemplate}"
                                  IsVisible="{Binding HasAttachments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Link preview card; hidden until its background fetch lands. -->
                    <Button Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Stretch"
                            IsVisible="{Binding LinkPreview.HasPreview, FallbackValue=False}"
                            Command="{Binding LinkPreview.OpenCommand, FallbackValue={x:Null}}">
                      <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                              BorderThickness="3,0,0,0"
                              BorderBrush="#22C55E"
                              CornerRadius="4"
                              Padding="10,8"
                              Margin="0,4,0,0"
                              MaxWidth="440">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding LinkPreview.SiteName, FallbackValue=''}"
                                     FontSize="11" Opacity="0.6"
                                     IsVisible="{Binding LinkPreview.SiteName, FallbackValue='', Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Text="{Binding LinkPreview.Title, FallbackValue=''}"
                                     FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding LinkPreview.Description, FallbackValue=''}"
                                     FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                     MaxLines="3" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding LinkPreview.Description, FallbackValue='', Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <Image Source="{Binding LinkPreview.Image, FallbackValue={x:Null}}"
                                 MaxHeight="180" MaxWidth="400"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Left"
                                 IsVisible="{Binding LinkPreview.Image, FallbackValue={x:Null}, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                      </Border>
                    </Button>
                  </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- ─── Direct-message thread ───────────────────────────── -->
        <DockPanel IsVisible="{Binding IsDmOpen}">

          <Border DockPanel.Dock="Top" Padding="16,12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Call"
                        Command="{Binding StartDirectCallCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding !IsInCall}"
                        Classes="accent" />
                <ToggleButton Content="{Binding IsMuted, Converter={x:Static BoolConverters.Not}, StringFormat='Mic {0}'}"
                              Command="{Binding ToggleMuteCommand}"
                              IsChecked="{Binding IsMuted, Mode=OneWay}"
                              IsVisible="{Binding IsInCall}" />
                <ToggleButton Content="Camera"
                              Command="{Binding ToggleCameraCommand}"
                              IsChecked="{Binding IsCameraOn, Mode=OneWay}"
                              IsEnabled="{Binding !IsBusy}"
                              IsVisible="{Binding IsInCall}" />
                <ToggleButton Content="Share"
                              Command="{Binding ToggleScreenShareCommand}"
                              IsChecked="{Binding IsScreenSharing, Mode=OneWay}"
                              IsEnabled="{Binding !IsBusy}"
                              IsVisible="{Binding IsInCall}" />
                <Button Content="Leave"
                        Command="{Binding LeaveCallCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding IsInCall}" />
              </StackPanel>

              <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8"
                         VerticalAlignment="Center"
                         Fill="{Binding Dm.SelectedContact.IsOnline,
                                        FallbackValue={x:Null},
                                        Converter={x:Static vm:DmConverters.OnlineBrush}}" />
                <TextBlock Text="{Binding Dm.SelectedContact.Name, FallbackValue=''}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" Padding="12">
            <StackPanel Spacing="6">

              <ItemsControl ItemsSource="{Binding Dm.PendingAttachments}"
                            IsVisible="{Binding Dm.PendingAttachments.Count}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PendingAttachment">
                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        <Button Content="✕" FontSize="10" Padding="3,0"
                                Background="Transparent"
                                Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).Dm.RemovePendingAttachmentCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Send"
                        Margin="8,0,0,0"
                        Command="{Binding Dm.SendCommand}"
                        Classes="accent" />
                <Button DockPanel.Dock="Right"
                        Content="📎"
                        Margin="8,0,0,0"
                        Command="{Binding Dm.AttachFileCommand}"
                        IsEnabled="{Binding !Dm.IsUploading}"
                        ToolTip.Tip="Attach files" />
                <TextBox Watermark="Message"
                         Text="{Binding Dm.Draft}"
                         AcceptsReturn="False" />
              </DockPanel>
            </StackPanel>
          </Border>

          <TextBlock DockPanel.Dock="Bottom"
                     Text="{Binding Dm.Error}"
                     Margin="12,0"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Dm.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Dm.Messages}" Margin="16,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DmMessageItem">
                  <!-- Own messages hug the right edge, like every messenger. -->
                  <StackPanel Margin="0,6"
                              MaxWidth="520"
                              HorizontalAlignment="{Binding IsMine,
                                  Converter={x:Static vm:DmConverters.MessageAlignment}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding SenderName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding SentAt, StringFormat='{}{0:t}'}" Opacity="0.5" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="✓ read" Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                                 IsVisible="{Binding ShowRead}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                               IsVisible="{Binding HasContent}" />

                    <ItemsControl ItemsSource="{Binding Attachments}"
                                  ItemTemplate="{StaticResource AttachmentTemplate}"
                                  IsVisible="{Binding HasAttachments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Panel>
    </DockPanel>

    <!-- Members panel: room members plus the server directory. Room-scoped, so it
         yields to an open DM thread. -->
    <Border Grid.Column="2"
            Width="230"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            IsVisible="{Binding Members.IsVisible}">
      <Border.Styles>
        <Style Selector="TextBlock.role">
          <Setter Property="FontSize" Value="10" />
          <Setter Property="Opacity" Value="0.6" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </Border.Styles>

      <ScrollViewer>
        <StackPanel Margin="0,8">

          <StackPanel Margin="12,4,12,6" Spacing="2">
            <TextBlock Text="Server members"
                       FontWeight="SemiBold"
                       Opacity="0.7" />
            <TextBlock Text="{Binding Members.SelectedRoomName, StringFormat='Room: {0}'}"
                       FontSize="11"
                       Opacity="0.55"
                       IsVisible="{Binding Members.HasRoomSelected}" />
          </StackPanel>

          <!-- The Blazor in-call filter: during a call the list narrows to the people
               connected to it unless "Show all" lifts it. -->
          <DockPanel Margin="12,0,12,6" IsVisible="{Binding Members.IsInCall}">
            <ToggleSwitch DockPanel.Dock="Right"
                          IsChecked="{Binding Members.ShowAllDuringCall}"
                          OnContent="" OffContent="" />
            <TextBlock Text="Show all"
                       FontSize="11"
                       Opacity="0.6"
                       VerticalAlignment="Center" />
          </DockPanel>

          <TextBlock Text="{Binding Members.Error}"
                     Margin="12,0,12,6"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     IsVisible="{Binding Members.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <ItemsControl ItemsSource="{Binding Members.Members}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MemberItem">
                <DockPanel Margin="12,3" Background="Transparent">

                  <!-- Moderation. The commands are bound from the row item itself:
                       flyout popups live outside the visual tree, so $parent bindings
                       to the panel resolve to nothing and the items would do nothing. -->
                  <DockPanel.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="Kick from room"
                                IsVisible="{Binding CanKick, x:DataType=vm:MemberItem}"
                                Command="{Binding KickCommand, x:DataType=vm:MemberItem}"
                                CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                      <MenuItem Header="Remove from call"
                                IsVisible="{Binding CanKickFromCall, x:DataType=vm:MemberItem}"
                                Command="{Binding KickFromCallCommand, x:DataType=vm:MemberItem}"
                                CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                      <MenuItem Header="Make member"
                                IsVisible="{Binding CanMakeMember, x:DataType=vm:MemberItem}"
                                Command="{Binding MakeMemberCommand, x:DataType=vm:MemberItem}"
                                CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                      <MenuItem Header="Make moderator"
                                IsVisible="{Binding CanMakeModerator, x:DataType=vm:MemberItem}"
                                Command="{Binding MakeModeratorCommand, x:DataType=vm:MemberItem}"
                                CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                      <MenuItem Header="Make admin"
                                IsVisible="{Binding CanMakeAdmin, x:DataType=vm:MemberItem}"
                                Command="{Binding MakeAdminCommand, x:DataType=vm:MemberItem}"
                                CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                    </MenuFlyout>
                  </DockPanel.ContextFlyout>

                  <!-- The visible entry point, as in the Blazor app — right-click is
                       kept, but nobody discovers right-click. -->
                  <Button DockPanel.Dock="Right"
                          Content="⋯"
                          Padding="6,2"
                          Background="Transparent"
                          IsVisible="{Binding HasModeration}"
                          ToolTip.Tip="Moderation">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem Header="Kick from room"
                                  IsVisible="{Binding CanKick, x:DataType=vm:MemberItem}"
                                  Command="{Binding KickCommand, x:DataType=vm:MemberItem}"
                                  CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                        <MenuItem Header="Remove from call"
                                  IsVisible="{Binding CanKickFromCall, x:DataType=vm:MemberItem}"
                                  Command="{Binding KickFromCallCommand, x:DataType=vm:MemberItem}"
                                  CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                        <MenuItem Header="Make member"
                                  IsVisible="{Binding CanMakeMember, x:DataType=vm:MemberItem}"
                                  Command="{Binding MakeMemberCommand, x:DataType=vm:MemberItem}"
                                  CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                        <MenuItem Header="Make moderator"
                                  IsVisible="{Binding CanMakeModerator, x:DataType=vm:MemberItem}"
                                  Command="{Binding MakeModeratorCommand, x:DataType=vm:MemberItem}"
                                  CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                        <MenuItem Header="Make admin"
                                  IsVisible="{Binding CanMakeAdmin, x:DataType=vm:MemberItem}"
                                  Command="{Binding MakeAdminCommand, x:DataType=vm:MemberItem}"
                                  CommandParameter="{Binding x:DataType=vm:MemberItem}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>

                  <Ellipse DockPanel.Dock="Left"
                           Width="8" Height="8"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Fill="{Binding IsOnline, Converter={x:Static vm:DmConverters.OnlineBrush}}" />

                  <Button DockPanel.Dock="Right"
                          Content="✉"
                          Padding="6,2"
                          Background="Transparent"
                          IsVisible="{Binding CanMessage}"
                          Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).Members.MessageCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Message" />

                  <TextBlock Classes="role"
                             DockPanel.Dock="Right"
                             Margin="6,0"
                             Text="{Binding RoleLabel}"
                             IsVisible="{Binding HasRoleLabel}" />

                  <TextBlock Classes="role"
                             DockPanel.Dock="Right"
                             Margin="6,0"
                             Text="in room"
                             IsVisible="{Binding IsInSelectedRoom}" />

                  <TextBlock Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

  <!-- Settings overlay. A dimmed layer rather than a separate window, so it works
       identically on desktop and Android. -->
  <Panel IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}"
         Background="#88000000">
    <ContentControl Content="{Binding Settings}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24" />
  </Panel>

  <!-- Screen-share target picker, same overlay pattern. -->
  <Panel IsVisible="{Binding SharePicker, Converter={x:Static ObjectConverters.IsNotNull}}"
         Background="#88000000">
    <ContentControl Content="{Binding SharePicker}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24" />
  </Panel>

  <!-- Room create / rename / delete-confirm, one shared dialog -->
  <Panel IsVisible="{Binding IsRoomDialogOpen}"
         Background="#88000000">
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="10"
            Padding="24"
            MinWidth="340"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BoxShadow="0 8 32 0 #66000000">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding RoomDialogTitle}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBox Text="{Binding RoomDialogText}"
                 Watermark="Room name"
                 IsVisible="{Binding RoomDialogHasInput}" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelRoomDialogCommand}" />
          <Button Content="{Binding RoomDialogConfirmLabel}"
                  Classes="accent"
                  Command="{Binding ConfirmRoomDialogCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>

  <!-- Incoming private call -->
  <Panel IsVisible="{Binding IncomingCallerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
         Background="#88000000">
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="10"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BoxShadow="0 8 32 0 #66000000">
      <StackPanel Spacing="16" MinWidth="260">
        <TextBlock Text="Incoming call"
                   Opacity="0.7"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding IncomingCallerName}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="Accept"
                  Classes="accent"
                  MinWidth="100"
                  HorizontalContentAlignment="Center"
                  Command="{Binding AcceptIncomingCallCommand}" />
          <Button Content="Decline"
                  MinWidth="100"
                  HorizontalContentAlignment="Center"
                  Command="{Binding DeclineIncomingCallCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
  </Panel>
</UserControl>
