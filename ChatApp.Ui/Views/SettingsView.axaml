<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChatApp.Ui.ViewModels"
             xmlns:media="using:ChatApp.Core.Media"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="700"
             x:Class="ChatApp.Ui.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,16,0,6" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="0,3" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
          CornerRadius="10"
          Padding="20"
          MaxWidth="560"
          MaxHeight="720"
          BoxShadow="0 8 32 0 #66000000">
    <DockPanel>

      <TextBlock DockPanel.Dock="Top"
                 Text="Settings"
                 FontSize="20"
                 FontWeight="SemiBold" />

      <!-- Footer -->
      <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
        </StackPanel>

        <TextBlock Text="{Binding Error}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </DockPanel>

      <ScrollViewer>
        <StackPanel Margin="0,4,12,0">

          <!-- ─── Server ─────────────────────────────────────────── -->
          <TextBlock Classes="section" Text="Server" />

          <TextBox Text="{Binding ServerUrl}"
                   Watermark="https://chat.example.com" />

          <TextBlock Text="Enter a valid http(s) URL."
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     FontSize="12"
                     Margin="0,4,0,0"
                     IsVisible="{Binding ServerUrlInvalid}" />

          <TextBlock Text="Server changed — sign out and back in to connect to it."
                     Foreground="{DynamicResource SystemFillColorCautionBrush}"
                     FontSize="12"
                     Margin="0,4,0,0"
                     IsVisible="{Binding ServerChangePending}" />

          <!-- ─── Devices ────────────────────────────────────────── -->
          <TextBlock Classes="section" Text="Devices" />

          <Grid Classes="row" ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Microphone" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Microphones}"
                      SelectedItem="{Binding SelectedMicrophone}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="media:MediaDeviceInfo">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <!-- Level meter, driven by the mic test -->
          <Grid Classes="row" ColumnDefinitions="140,*" IsVisible="{Binding HasMediaEngine}">
            <TextBlock Classes="label" Text="Level" />
            <ProgressBar Grid.Column="1"
                         Minimum="0" Maximum="100"
                         Value="{Binding MicLevel}"
                         Height="6" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Speakers" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Speakers}"
                      SelectedItem="{Binding SelectedSpeaker}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="media:MediaDeviceInfo">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid Classes="row" ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Camera" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Cameras}"
                      SelectedItem="{Binding SelectedCamera}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="media:MediaDeviceInfo">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <!-- ─── Audio ──────────────────────────────────────────── -->
          <TextBlock Classes="section" Text="Audio" />

          <Grid Classes="row" ColumnDefinitions="140,*,52">
            <TextBlock Classes="label" Text="Mic volume" />
            <Slider Grid.Column="1" Minimum="0" Maximum="2" TickFrequency="0.05"
                    Value="{Binding MicrophoneVolume}" />
            <TextBlock Grid.Column="2" Classes="label" HorizontalAlignment="Right"
                       Text="{Binding MicrophoneVolume, StringFormat='{}{0:P0}'}" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="140,*,52">
            <TextBlock Classes="label" Text="Playback volume" />
            <Slider Grid.Column="1" Minimum="0" Maximum="2" TickFrequency="0.05"
                    Value="{Binding PlaybackVolume}" />
            <TextBlock Grid.Column="2" Classes="label" HorizontalAlignment="Right"
                       Text="{Binding PlaybackVolume, StringFormat='{}{0:P0}'}" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Noise suppression" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NoiseSuppressionEnabled}" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Voice gate (mute below threshold)" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding VoiceGateEnabled}" />
          </Grid>

          <StackPanel IsVisible="{Binding VoiceGateEnabled}">
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="Automatic threshold" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding VoiceGateAuto}" />
            </Grid>

            <Grid Classes="row" ColumnDefinitions="140,*,52"
                  IsVisible="{Binding !VoiceGateAuto}">
              <TextBlock Classes="label" Text="Threshold" />
              <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                      Value="{Binding VoiceGateThreshold}" />
              <TextBlock Grid.Column="2" Classes="label" HorizontalAlignment="Right"
                         Text="{Binding VoiceGateThreshold}" />
            </Grid>
          </StackPanel>

          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Push to talk" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PushToTalkEnabled}" />
          </Grid>

          <StackPanel IsVisible="{Binding PushToTalkEnabled}">
            <Grid Classes="row" ColumnDefinitions="140,*">
              <TextBlock Classes="label" Text="Key" />
              <TextBox Grid.Column="1" Text="{Binding PushToTalkKey}" MaxWidth="160"
                       HorizontalAlignment="Left" />
            </Grid>

            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="Play sound on toggle" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding PushToTalkSoundEnabled}" />
            </Grid>
          </StackPanel>

          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Notifications" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}" />
          </Grid>

          <!-- ─── Video ──────────────────────────────────────────── -->
          <TextBlock Classes="section" Text="Video" />

          <Grid Classes="row" ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Resolution" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Resolutions}"
                      SelectedItem="{Binding SelectedResolution}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Frame rate" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding FrameRates}"
                      SelectedItem="{Binding SelectedFps}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="140,*,64">
            <TextBlock Classes="label" Text="Bitrate" />
            <Slider Grid.Column="1" Minimum="1000" Maximum="20000" TickFrequency="250"
                    IsSnapToTickEnabled="True"
                    Value="{Binding BitrateKbps}" />
            <TextBlock Grid.Column="2" Classes="label" HorizontalAlignment="Right"
                       Text="{Binding BitrateKbps, StringFormat='{}{0} k'}" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Codec" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Codecs}"
                      SelectedItem="{Binding SelectedCodec}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="140,*">
            <TextBlock Classes="label" Text="Optimize for" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ContentHints}"
                      SelectedItem="{Binding SelectedContentHint}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="Hardware acceleration" />
              <TextBlock Classes="label" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                         Text="Encodes and decodes video on the GPU. Applies after a restart." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GpuAccelerationEnabled}" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="140,*"
                IsVisible="{Binding ShowGpuPreference}">
            <TextBlock Classes="label" Text="GPU" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding GpuPreferences}"
                      SelectedItem="{Binding SelectedGpuPreference}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Hide my own preview" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideLocalPreview}" />
          </Grid>

          <!-- ─── Screen share ───────────────────────────────────── -->
          <TextBlock Classes="section" Text="Screen share" />

          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Share system audio" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScreenShareAudioEnabled}" />
          </Grid>

          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Auto-adjust shared audio volume" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScreenShareAutoGainEnabled}" />
          </Grid>

          <TextBlock Text="Resolution and codec changes apply on the next call."
                     FontSize="12"
                     Opacity="0.55"
                     Margin="0,14,0,0" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
