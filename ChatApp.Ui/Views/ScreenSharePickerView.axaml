<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChatApp.Ui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="360"
             x:Class="ChatApp.Ui.Views.ScreenSharePickerView"
             x:Name="Root"
             x:DataType="vm:ScreenSharePickerViewModel">

  <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
          CornerRadius="10"
          Padding="20"
          MinWidth="380"
          MaxWidth="460"
          BoxShadow="0 8 32 0 #66000000">
    <DockPanel>

      <TextBlock DockPanel.Dock="Top"
                 Text="Share your screen"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Margin="0,0,0,12" />

      <Button DockPanel.Dock="Bottom"
              Content="Cancel"
              HorizontalAlignment="Right"
              Margin="0,12,0,0"
              Command="{Binding CancelCommand}" />

      <Panel>
        <ProgressBar IsIndeterminate="True"
                     Height="3"
                     VerticalAlignment="Top"
                     IsVisible="{Binding IsLoading}" />

        <TextBlock Text="{Binding Error}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <ItemsControl ItemsSource="{Binding Targets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShareTargetItem">
              <Button HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Margin="0,3"
                      Padding="14,10"
                      Command="{Binding #Root.((vm:ScreenSharePickerViewModel)DataContext).ChooseCommand}"
                      CommandParameter="{Binding}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right"
                             Text="{Binding Detail}"
                             Opacity="0.6"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
