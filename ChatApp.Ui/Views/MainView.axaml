<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChatApp.Ui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="ChatApp.Ui.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Panel>
    <!-- Auto-login runs before the first route is shown. -->
    <StackPanel IsVisible="{Binding IsStartingUp}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
      <TextBlock Text="ChatFlow" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <ProgressBar IsIndeterminate="True" Width="180" Height="3" />
    </StackPanel>

    <ContentControl Content="{Binding CurrentView}"
                    IsVisible="{Binding !IsStartingUp}" />
  </Panel>
</UserControl>
