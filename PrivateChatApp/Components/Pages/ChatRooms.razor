@page "/"
@implements IDisposable
@inject ChatRoomStore Store
@inject AuthStateProvider Auth
@inject NavigationManager Nav

<div class="rooms-layout">
    <aside class="room-list">
        <div class="room-list-header">
            <h4>Chat Rooms</h4>
            <button class="btn-primary btn-small" @onclick="ShowCreateRoom">+</button>
        </div>

        @if (_showCreateRoom)
        {
            <div class="create-room-form">
                <input @bind="_newRoomName" placeholder="Room name" />
                <input @bind="_newRoomDesc" placeholder="Description (optional)" />
                <label class="checkbox-label">
                    <input type="checkbox" @bind="_newRoomVoice" /> Voice
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="_newRoomVideo" /> Video
                </label>
                <div class="form-actions">
                    <button class="btn-primary btn-small" @onclick="CreateRoom">Create</button>
                    <button class="btn-secondary btn-small" @onclick="() => _showCreateRoom = false">Cancel</button>
                </div>
            </div>
        }

        @foreach (var room in Store.Rooms)
        {
            <div class="room-item @(room.Id == Store.SelectedRoomId ? "active" : "")"
                 @onclick="() => SelectRoom(room.Id)">
                <span class="room-name">@room.Name</span>
                <span class="room-members">@room.MemberCount members</span>
            </div>
        }
    </aside>

    <section class="chat-area">
        @if (Store.SelectedRoomId != null)
        {
            <div class="chat-header">
                <h4>@Store.SelectedRoom?.Name</h4>
                <div class="chat-actions">
                    @if (Store.SelectedRoom?.IsVoiceEnabled == true || Store.SelectedRoom?.IsVideoEnabled == true)
                    {
                        <button class="btn-secondary btn-small" @onclick="NavigateToVoice">
                            Join Call
                        </button>
                    }
                    <button class="btn-secondary btn-small" @onclick="ToggleMembers">Members</button>
                </div>
            </div>

            <div class="chat-messages">
                @foreach (var msg in Store.Messages)
                {
                    <div class="message @(msg.SenderId == Auth.CurrentUser?.Id ? "own" : "") @(msg.IsDeleted ? "deleted" : "")">
                        <div class="message-header">
                            <span class="message-sender">@msg.SenderName</span>
                            <span class="message-time">@msg.SentAt.ToLocalTime().ToString("HH:mm")</span>
                            @if (msg.SenderId == Auth.CurrentUser?.Id || Store.CurrentUserRole >= UserRole.Moderator)
                            {
                                <button class="btn-delete" @onclick="() => DeleteMessage(msg.Id)">&#x2715;</button>
                            }
                        </div>
                        @if (!msg.IsDeleted)
                        {
                            <div class="message-content">
                                @if (msg.MentionedUserIds.Length > 0)
                                {
                                    <span class="mention-badge">@msg.MentionedUserIds.Length mention(s)</span>
                                }
                                @msg.Content
                            </div>
                            @if (msg.Attachments.Length > 0)
                            {
                                <div class="message-attachments">
                                    @foreach (var att in msg.Attachments)
                                    {
                                        <a href="@att.Url" target="_blank" class="attachment-link">@att.FileName</a>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="message-content deleted-text">Message deleted</div>
                        }
                    </div>
                }
            </div>

            <div class="chat-input">
                <textarea @bind="_messageText" @onkeydown="HandleKeyDown"
                          placeholder="Type a message..." rows="1"></textarea>
                <button class="btn-primary" @onclick="SendMessage"
                        disabled="@string.IsNullOrWhiteSpace(_messageText)">Send</button>
            </div>
        }
        else
        {
            <div class="no-room-selected">
                <p>Select a room to start chatting</p>
            </div>
        }
    </section>

    @if (_showMembers && Store.SelectedRoomId != null)
    {
        <aside class="members-panel">
            <div class="members-header">
                <h4>Members</h4>
                <button class="btn-secondary btn-small" @onclick="ToggleMembers">&#x2715;</button>
            </div>
            @foreach (var member in Store.Members)
            {
                <div class="member-item">
                    <span class="member-name">
                        @member.DisplayName
                        @if (member.IsOnline)
                        {
                            <span class="online-dot"></span>
                        }
                    </span>
                    <span class="member-role">@member.Role</span>
                    @if (Store.CurrentUserRole >= UserRole.Moderator && member.UserId != Auth.CurrentUser?.Id)
                    {
                        <div class="member-actions">
                            <button class="btn-small btn-danger" @onclick="() => KickUser(member.UserId)">Kick</button>
                            @if (Store.CurrentUserRole >= UserRole.Admin)
                            {
                                <select @onchange="(e) => ChangeRole(member.UserId, e)">
                                    @foreach (var role in Enum.GetValues<UserRole>())
                                    {
                                        <option value="@role" selected="@(member.Role == role)">@role</option>
                                    }
                                </select>
                            }
                        </div>
                    }
                </div>
            }
        </aside>
    }
</div>

@if (!string.IsNullOrEmpty(Store.Error))
{
    <div class="toast-error">@Store.Error</div>
}

@code {
    private string _messageText = "";
    private bool _showCreateRoom;
    private bool _showMembers;
    private string _newRoomName = "";
    private string? _newRoomDesc;
    private bool _newRoomVoice;
    private bool _newRoomVideo;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;

        Store.OnChange += OnStoreChanged;
        await Store.LoadRoomsAsync();
    }

    private async Task SelectRoom(Guid roomId) => await Store.SelectRoomAsync(roomId);

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText)) return;
        var text = _messageText;
        _messageText = "";
        await Store.SendMessageAsync(text);
    }

    private async Task DeleteMessage(Guid messageId) => await Store.DeleteMessageAsync(messageId);

    private async Task KickUser(Guid userId) => await Store.KickUserAsync(userId);

    private async Task ChangeRole(Guid userId, ChangeEventArgs e)
    {
        if (e.Value != null && Enum.TryParse<UserRole>(e.Value.ToString(), out var role))
        {
            await Store.SetUserRoleAsync(userId, role);
        }
    }

    private async Task CreateRoom()
    {
        if (string.IsNullOrWhiteSpace(_newRoomName)) return;
        await Store.CreateRoomAsync(_newRoomName, _newRoomDesc, _newRoomVoice, _newRoomVideo);
        _showCreateRoom = false;
        _newRoomName = "";
        _newRoomDesc = null;
        _newRoomVoice = false;
        _newRoomVideo = false;
    }

    private void ShowCreateRoom() => _showCreateRoom = true;
    private void ToggleMembers() => _showMembers = !_showMembers;
    private void NavigateToVoice() => Nav.NavigateTo($"/voice?room={Store.SelectedRoomId}");

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Store.OnChange -= OnStoreChanged;
    }
}
