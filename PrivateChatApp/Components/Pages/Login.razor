@page "/login"
@inject ApiClientService Api
@inject AuthStateProvider Auth
@inject ChatClientService Chat
@inject NavigationManager Nav

<div class="auth-container">
    <div class="auth-card">
        <h2>Sign In</h2>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-text">@_error</div>
        }

        <div class="form-group">
            <label>Username</label>
            <input @bind="_userName" @bind:event="oninput" placeholder="Enter username" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" @bind="_password" @bind:event="oninput"
                   @onkeydown="HandleKeyDown" placeholder="Enter password" />
        </div>

        <button class="btn-primary full-width" @onclick="HandleLogin" disabled="@_loading">
            @(_loading ? "Signing in..." : "Sign In")
        </button>

        <p class="auth-switch">
            Don't have an account? <a href="/register">Register</a>
        </p>
    </div>
</div>

@code {
    private string _userName = "";
    private string _password = "";
    private string? _error;
    private bool _loading;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        _error = null;
        _loading = true;

        try
        {
            var response = await Api.LoginAsync(_userName, _password);
            if (response.Success)
            {
                Auth.SetAuth(response.Token!, response.User!);
                await Chat.ConnectAsync();
                Nav.NavigateTo("/");
            }
            else
            {
                _error = response.Error;
            }
        }
        catch (Exception ex)
        {
            _error = $"Connection error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
