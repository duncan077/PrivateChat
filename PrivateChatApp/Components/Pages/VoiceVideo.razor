@page "/voice"
@implements IAsyncDisposable
@inject CallStore Store
@inject AuthStateProvider Auth
@inject WebRtcBridge WebRtc
@inject NavigationManager Nav

<div class="voice-layout">
    <div class="voice-header">
        <h4>Voice / Video</h4>
        @if (_roomId != Guid.Empty)
        {
            <span class="room-label">Room: @_roomName</span>
        }
    </div>

    @* Remote video cells are created/removed by webrtc-manager.js inside #videoGrid *@
    <div class="video-grid" id="videoGrid">
        <div class="video-cell local-cell">
            <video id="localVideo" autoplay muted playsinline></video>
            <span class="video-label">You</span>
        </div>
    </div>

    <div class="voice-controls">
        @if (!Store.IsInCall)
        {
            <button class="btn-primary btn-large" @onclick="JoinCall" disabled="@(_roomId == Guid.Empty)">
                Join Call
            </button>
        }
        else
        {
            <button class="btn-control @(Store.IsMuted ? "active" : "")" @onclick="ToggleMute">
                @(Store.IsMuted ? "Unmute" : "Mute")
            </button>
            <button class="btn-control @(Store.IsCameraOff ? "active" : "")" @onclick="ToggleCamera">
                @(Store.IsCameraOff ? "Camera On" : "Camera Off")
            </button>
            <button class="btn-control @(Store.IsScreenSharing ? "active" : "")" @onclick="ToggleScreenShare">
                @(Store.IsScreenSharing ? "Stop Share" : "Share Screen")
            </button>
            <button class="btn-danger btn-large" @onclick="LeaveCall">Leave</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(Store.Error))
    {
        <div class="toast-error">@Store.Error</div>
    }
</div>

@code {
    private Guid _roomId;
    private string _roomName = "";

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var roomParam = query["room"];
        if (Guid.TryParse(roomParam, out var roomId))
        {
            _roomId = roomId;
            _roomName = roomId.ToString()[..8] + "...";
        }

        Store.OnChange += OnStoreChanged;
        Store.OnWebRtcSignal += OnWebRtcSignal;
    }

    private async Task JoinCall()
    {
        if (_roomId == Guid.Empty) return;

        var session = await Store.JoinCallAsync(_roomId);
        if (session == null) return;

        // Initialize the WebRTC JS layer with the Janus session
        await WebRtc.InitAsync(
            session.JanusSessionId,
            session.JanusHandleId,
            session.JanusRoomId,
            session.ServerBaseUrl,
            Auth.Token!,
            Auth.CurrentUser!.Id.ToString(),
            session.IceServers
        );
    }

    private async Task LeaveCall()
    {
        await WebRtc.StopAsync();
        await Store.LeaveCallAsync();
    }

    private async Task ToggleMute() => await WebRtc.ToggleMuteAsync();
    private async Task ToggleCamera() => await WebRtc.ToggleCameraAsync();

    private async Task ToggleScreenShare()
    {
        if (Store.IsScreenSharing)
            await WebRtc.StopScreenShareAsync();
        else
            await WebRtc.StartScreenShareAsync();
    }

    private async void OnWebRtcSignal(Guid fromUserId, string signalType, string payload)
    {
        try
        {
            await WebRtc.DeliverSignalAsync(fromUserId, signalType, payload);
        }
        catch { }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Store.OnChange -= OnStoreChanged;
        Store.OnWebRtcSignal -= OnWebRtcSignal;

        // Clean up call if still active when navigating away
        if (Store.IsInCall)
        {
            try
            {
                await WebRtc.StopAsync();
                await Store.LeaveCallAsync();
            }
            catch { }
        }
    }
}
