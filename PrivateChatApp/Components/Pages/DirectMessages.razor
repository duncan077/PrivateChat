@page "/dm"
@implements IDisposable
@inject DirectMessageStore Store
@inject AuthStateProvider Auth

<div class="dm-layout">
    <aside class="contacts-list">
        <div class="contacts-header">
            <h4>Contacts</h4>
        </div>
        @foreach (var contact in Store.Contacts)
        {
            <div class="contact-item @(contact.Id == Store.SelectedContactId ? "active" : "")"
                 @onclick="() => SelectContact(contact)">
                <span class="contact-name">@contact.DisplayName</span>
                <span class="contact-username">@@@contact.UserName</span>
            </div>
        }

        @if (Store.Contacts.Length == 0)
        {
            <div class="empty-state">No conversations yet</div>
        }
    </aside>

    <section class="dm-chat-area">
        @if (Store.SelectedContact != null)
        {
            <div class="dm-header">
                <h4>@Store.SelectedContact.DisplayName</h4>
                <span class="dm-username">@@@Store.SelectedContact.UserName</span>
            </div>

            <div class="dm-messages">
                @foreach (var msg in Store.Messages)
                {
                    <div class="dm-message @(msg.SenderId == Auth.CurrentUser?.Id ? "own" : "")">
                        <div class="dm-message-header">
                            <span class="dm-sender">@msg.SenderName</span>
                            <span class="dm-time">@msg.SentAt.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                        <div class="dm-content">@msg.Content</div>
                        @if (msg.Attachments.Length > 0)
                        {
                            <div class="dm-attachments">
                                @foreach (var att in msg.Attachments)
                                {
                                    <a href="@att.Url" target="_blank" class="dm-att-link">@att.FileName</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="dm-input">
                <textarea @bind="_messageText" @onkeydown="HandleKeyDown"
                          placeholder="Type a message..." rows="1"></textarea>
                <button class="btn-primary" @onclick="SendMessage"
                        disabled="@string.IsNullOrWhiteSpace(_messageText)">Send</button>
            </div>
        }
        else
        {
            <div class="no-contact-selected">
                <p>Select a contact to start messaging</p>
            </div>
        }
    </section>
</div>

@if (!string.IsNullOrEmpty(Store.Error))
{
    <div class="toast-error">@Store.Error</div>
}

@code {
    private string _messageText = "";

    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += OnStoreChanged;
        await Store.LoadContactsAsync();
    }

    private async Task SelectContact(UserInfo contact) => await Store.SelectContactAsync(contact);

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText)) return;
        var text = _messageText;
        _messageText = "";
        await Store.SendMessageAsync(text);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Store.OnChange -= OnStoreChanged;
    }
}
