<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ChatApp.Media</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChatApp.Media.Tests" />
  </ItemGroup>

  <!--
    FFmpeg shared libraries, staged by tools/fetch-ffmpeg.ps1 (they are far too large to
    commit). The glob quietly yields nothing when they have not been fetched, so the
    build still succeeds — FFmpegLoader then reports an actionable diagnostic at runtime
    instead of the build failing for someone who only needs the chat features.
  -->
  <ItemGroup>
    <None Include="..\third_party\ffmpeg\win-x64\*.dll" Condition="'$(OS)' == 'Windows_NT'">
      <Link>runtimes\win-x64\native\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\third_party\ffmpeg\linux-x64\*.so*" Condition="'$(OS)' != 'Windows_NT'">
      <Link>runtimes\linux-x64\native\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- FFmpeg bindings. Native binaries are resolved at startup, not bundled here. -->
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />

    <!--
      WASAPI capture/playback on Windows. NAudio resolves to its netstandard2.0 asset
      here, so it restores for the platform-neutral TFM; the Windows-only surface is
      guarded by OperatingSystem.IsWindows() at every call site.
    -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!--
      ICE, DTLS, SRTP, RTP and RTCP in pure C#. Replaces libdatachannel, which needed a
      vendored binding fork and platform-specific natives, and which silently omitted
      incoming depacketization and the RTCP receiving session. SIPSorcery hands over
      whole depacketized frames and packetizes on send.
    -->
    <PackageReference Include="SIPSorcery" Version="10.0.13" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatApp.Core\ChatApp.Core.csproj" />

  </ItemGroup>

</Project>
