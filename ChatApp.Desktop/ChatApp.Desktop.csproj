<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChatApp.Desktop</RootNamespace>
    <AssemblyName>ChatFlow</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows and Linux build from this head; RID is chosen at publish time. -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Version>1.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
    <!-- WMI adapter enumeration for the GPU preference setting; Windows-only at runtime. -->
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatApp.Ui\ChatApp.Ui.csproj" />
    <ProjectReference Include="..\ChatApp.Media\ChatApp.Media.csproj" />
  </ItemGroup>
</Project>
