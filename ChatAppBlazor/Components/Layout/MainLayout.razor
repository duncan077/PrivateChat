@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateProvider Auth
@inject ChatClientService Chat
@inject ChatRoomStore Rooms
@inject DirectMessageStore DirectMessages
@inject CallStore Call
@inject WebRtcBridge WebRtc
@inject GrpcChannelProvider Grpc
@inject NavigationManager Nav
@inject UpdateService Updater
@inject ApiClientService Api
@inject MembersPanelStore MembersPanel
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ISystemNotificationService SystemNotifications
@inject IJSRuntime JS
<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-root @(_isMobileShell ? "app-root-mobile" : "app-root-desktop")">
    @if (Updater.HasUpdate)
    {
        <div class="update-banner">
            @if (Updater.State == UpdateState.Idle)
            {
                <span class="update-banner-text">
                    &#x1F4E6; Update available: v@(Updater.AvailableUpdate!.Version)
                    @if (!string.IsNullOrWhiteSpace(Updater.AvailableUpdate.ReleaseNotes))
                    {
                        <span class="update-banner-notes"> - @Updater.AvailableUpdate.ReleaseNotes</span>
                    }
                </span>
                <div class="update-banner-actions">
                    <button class="btn-update" @onclick="InstallUpdate">Update</button>
                    <button class="btn-update-dismiss" @onclick="DismissUpdate">Dismiss</button>
                </div>
            }
            else if (Updater.State == UpdateState.Downloading)
            {
                <span class="update-banner-text">&#x23EC; Downloading update... @((int)Updater.DownloadProgress)%</span>
                <div class="update-banner-progress">
                    <div class="update-banner-progress-fill" style="width:@((int)Updater.DownloadProgress)%"></div>
                </div>
            }
            else if (Updater.State == UpdateState.Extracting)
            {
                <span class="update-banner-text">&#x1F4E6; Extracting update...</span>
            }
            else if (Updater.State == UpdateState.Relaunching)
            {
                <span class="update-banner-text">&#x1F504; Relaunching...</span>
            }
            else if (Updater.State == UpdateState.Failed)
            {
                <span class="update-banner-text">
                    &#x26A0; Update failed: @Updater.ErrorMessage
                </span>
                <div class="update-banner-actions">
                    <button class="btn-update" @onclick="InstallUpdate">Retry update</button>
                    <button class="btn-update-dismiss" @onclick="DismissUpdate">Dismiss</button>
                </div>
            }
        </div>
    }

    @if (!_initialized)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fill-screen">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1">Initializing...</MudText>
        </MudStack>
    }
    else if (!Auth.IsAuthenticated)
    {
        <ErrorBoundary>
            <ChildContent>
                @if (_showRegister)
                {
                    <Register />
                }
                else
                {
                    <Login />
                }
            </ChildContent>
            <ErrorContent Context="ex">
                <MudAlert Severity="Severity.Error">Auth error: @ex.Message</MudAlert>
            </ErrorContent>
        </ErrorBoundary>
    }
    else
    {
        <MudLayout Class="@(_isMobileShell ? "app-shell-mobile" : "app-shell-desktop")">
            <MudAppBar Elevation="0" Dense="@(!_isMobileShell)" Color="Color.Surface" Class="app-shell-bar">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="ml-2 app-brand">PrivateChat</MudText>
                <MudText Typo="Typo.caption" Class="app-shell-subtitle">secure team messaging</MudText>
                <MudSpacer />
                @if (!Chat.IsConnected)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Reconnecting...</MudChip>
                }
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Color="Color.Inherit"
                           StartIcon="@(MembersPanel.IsVisible ? Icons.Material.Filled.PeopleAlt : Icons.Material.Filled.PeopleOutline)"
                           OnClick="ToggleMembersPanel">
                    @(MembersPanel.IsVisible ? "Hide Members" : "Show Members")
                </MudButton>
                @if (!_isMobileShell)
                {
                    var currentAvatarUrl = GetAvatarUrl(Auth.CurrentUser?.AvatarUrl);
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="mr-2">
                        <MudAvatar Size="Size.Small" Color="Color.Secondary">
                            @if (!string.IsNullOrWhiteSpace(currentAvatarUrl))
                            {
                                <img src="@currentAvatarUrl" alt="Profile" class="avatar-image-fill" />
                            }
                            else
                            {
                                @GetAvatarInitial(Auth.CurrentUser?.DisplayName, Auth.CurrentUser?.UserName)
                            }
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                            @Auth.CurrentUser?.DisplayName
                        </MudChip>
                    </MudStack>
                }
                <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                               Color="Color.Inherit"
                               OnClick="OpenProfileSettings"
                               title="Edit profile" />
                <MudIconButton Icon="@Icons.Material.Filled.ExitToApp" Color="Color.Inherit"
                               OnClick="Logout" title="Logout" />
            </MudAppBar>

            @if (!_isMobileShell || _drawerOpen)
            {
                <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always"
                           Variant="@(_isMobileShell ? DrawerVariant.Temporary : DrawerVariant.Mini)"
                           Breakpoint="@(_isMobileShell ? Breakpoint.Lg : Breakpoint.Md)"
                           OpenMiniOnHover="@(!_isMobileShell)" Class="app-shell-drawer">
                    <div class="drawer-content-wrapper">
                    <MudNavMenu Class="app-shell-nav">
                        <MudText Typo="Typo.overline" Class="chat-type-title">Chat</MudText>

                        <MudNavGroup Title="Rooms" Icon="@Icons.Material.Filled.Forum" Expanded="@_roomsGroupExpanded">
                            <div class="chat-type-group-content">
                                @if (Rooms.CurrentUserRole >= UserRole.Admin)
                                {
                                <div class="chat-type-actions">
                                    <MudText Typo="Typo.overline" Class="chat-type-title">Create room</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                                   Variant="Variant.Outlined" Color="Color.Primary"
                                                   OnClick="OpenCreateRoomFromDrawer" title="New room" />
                                </div>
                                }

                                @if (_chatTypeListsLoading && Rooms.Rooms.Length == 0)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="chat-type-loading">
                                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                                        <MudText Typo="Typo.caption">Loading rooms...</MudText>
                                    </MudStack>
                                }
                                else if (Rooms.Rooms.Length == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="chat-type-empty">No rooms yet</MudText>
                                }
                                else
                                {
                                    <MudList T="Guid" Dense="true" Class="chat-type-list">
                                        @foreach (var room in Rooms.Rooms.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
                                        {
                                            var connectedParticipants = GetRoomCallParticipants(room);
                                            <MudListItem @key="room.Id" T="Guid" Value="room.Id"
                                                         Class="@($"chat-type-entry {(IsRoomSelected(room.Id) ? "active" : string.Empty)}")">
                                                <div class="@GetRoomCallDropTargetClass(room)"
                                                     data-room-drop-target="1"
                                                     data-room-id="@room.Id"
                                                     @ondragover:preventDefault="true"
                                                     @ondragenter:preventDefault="true"
                                                     @ondrop:preventDefault="true"
                                                     @ondragover="(DragEventArgs _) => HandleRoomDragOver(room.Id)"
                                                     @ondragenter="(DragEventArgs _) => HandleRoomDragEnter(room.Id)"
                                                     @ondragleave="(DragEventArgs _) => HandleRoomDragLeave(room.Id)"
                                                     @ondrop="(DragEventArgs _) => HandleRoomDropAsync(room.Id)">
                                                    <div class="chat-type-row chat-type-room-header"
                                                         @onclick="() => OpenRoomFromDrawer(room.Id)">
                                                        <MudIcon Icon="@GetRoomIcon(room)" Size="Size.Small" />
                                                        <MudText Typo="Typo.caption" Class="chat-type-label">@room.Name</MudText>
                                                        @{
                                                            var roomUnread = Rooms.GetUnreadCount(room.Id);
                                                        }
                                                        @if (roomUnread > 0)
                                                        {
                                                            <span class="chat-unread-badge @(Rooms.HasUnreadMention(room.Id) ? "mention" : string.Empty)"
                                                                  title="@($"{roomUnread} unread")">
                                                                @(roomUnread >= 99 ? "99+" : roomUnread.ToString())
                                                            </span>
                                                        }
                                                    </div>

                                                    @if (connectedParticipants.Count > 0)
                                                    {
                                                        <div class="chat-type-room-call-list">
                                                            @foreach (var participant in connectedParticipants)
                                                            {
                                                                var participantAvatarUrl = GetAvatarUrl(participant.AvatarUrl);
                                                                var canMoveParticipant = CanMoveRoomParticipant(participant.UserId);
                                                                var canModerateParticipant = CanModerateRoomParticipant(participant.UserId);
                                                                var assignableRoles = GetAssignableRoles(participant.UserId);
                                                                var canOpenActions = CanOpenParticipantActions(room.Id, participant.UserId);

                                                                <div @key="participant.UserId"
                                                                     class="@($"chat-type-room-call-user {(canOpenActions ? "context-enabled" : string.Empty)}")"
                                                                     @onclick:stopPropagation="true"
                                                                     @oncontextmenu:preventDefault="true"
                                                                     @oncontextmenu="(MouseEventArgs e) => HandleParticipantContextMenu(room.Id, participant, e)"
                                                                     @ontouchstart="(TouchEventArgs e) => StartParticipantLongPress(room.Id, participant, e)"
                                                                     @ontouchend="(TouchEventArgs _) => CancelParticipantLongPress()"
                                                                     @ontouchcancel="(TouchEventArgs _) => CancelParticipantLongPress()"
                                                                     @ontouchmove="(TouchEventArgs _) => CancelParticipantLongPress()">
                                                                    <div class="@($"chat-type-room-call-user-main {(canMoveParticipant ? "draggable" : string.Empty)}")"
                                                                         data-room-drag-user="@participant.UserId"
                                                                         data-room-source-room="@room.Id"
                                                                         draggable="@(canMoveParticipant ? "true" : "false")"
                                                                         @onclick:stopPropagation="true"
                                                                         @onmousedown:stopPropagation="true"
                                                                         @onpointerdown:stopPropagation="true"
                                                                         @ondragstart="(DragEventArgs _) => HandleParticipantDragStart(room.Id, participant.UserId)"
                                                                         @ondragend="(DragEventArgs _) => HandleParticipantDragEnd()">
                                                                        <MudAvatar Size="Size.Small"
                                                                                   Color="Color.Secondary"
                                                                                   Class="chat-type-avatar">
                                                                            @if (!string.IsNullOrWhiteSpace(participantAvatarUrl))
                                                                            {
                                                                                <img src="@participantAvatarUrl" alt="Profile" class="avatar-image-fill" />
                                                                            }
                                                                            else
                                                                            {
                                                                                @GetAvatarInitial(participant.DisplayName, participant.UserName)
                                                                            }
                                                                        </MudAvatar>
                                                                        <MudText Typo="Typo.caption" Class="chat-type-room-call-user-name">
                                                                            @participant.DisplayName
                                                                        </MudText>
                                                                    </div>
                                                                    @if (canOpenActions)
                                                                    {
                                                                        <MudIcon Icon="@Icons.Material.Filled.MoreHoriz"
                                                                                 Size="Size.Small"
                                                                                 Class="chat-type-room-call-context-hint" />
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                            </div>
                        </MudNavGroup>

                        <MudNavGroup Title="Private Chats" Icon="@Icons.Material.Filled.Email" Expanded="@_privateChatsGroupExpanded">
                            <div class="chat-type-group-content">
                                <div class="chat-type-actions">
                                    <MudText Typo="Typo.overline" Class="chat-type-title">New private chat</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Small"
                                                   Variant="Variant.Outlined" Color="Color.Primary"
                                                   OnClick="OpenSelectPrivateUserFromDrawer" title="New private chat" />
                                </div>

                                @if (_chatTypeListsLoading && DirectMessages.Contacts.Length == 0)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="chat-type-loading">
                                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                                        <MudText Typo="Typo.caption">Loading contacts...</MudText>
                                    </MudStack>
                                }
                                else if (DirectMessages.Contacts.Length == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="chat-type-empty">No private chats yet</MudText>
                                }
                                else
                                {
                                    <MudList T="Guid" Dense="true" Class="chat-type-list">
                                        @foreach (var contact in DirectMessages.Contacts.OrderBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase))
                                        {
                                            var contactAvatarUrl = GetAvatarUrl(contact.AvatarUrl);
                                            <MudListItem @key="contact.Id" T="Guid" Value="contact.Id"
                                                         OnClick="() => OpenDirectMessageFromDrawer(contact.Id)"
                                                         Class="@($"chat-type-entry {(IsDirectMessageSelected(contact.Id) ? "active" : string.Empty)}")">
                                                <div class="chat-type-row">
                                                    <MudAvatar Size="Size.Small"
                                                               Color="Color.Secondary"
                                                               Class="chat-type-avatar">
                                                        @if (!string.IsNullOrWhiteSpace(contactAvatarUrl))
                                                        {
                                                            <img src="@contactAvatarUrl" alt="Profile" class="avatar-image-fill" />
                                                        }
                                                        else
                                                        {
                                                            @GetAvatarInitial(contact.DisplayName, contact.UserName)
                                                        }
                                                    </MudAvatar>
                                                    <MudText Typo="Typo.caption" Class="chat-type-label">@contact.DisplayName</MudText>
                                                    @{
                                                        var contactUnread = DirectMessages.GetUnreadCount(contact.Id);
                                                    }
                                                    @if (contactUnread > 0)
                                                    {
                                                        <span class="chat-unread-badge" title="@($"{contactUnread} unread")">
                                                            @(contactUnread >= 99 ? "99+" : contactUnread.ToString())
                                                        </span>
                                                    }
                                                </div>
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                            </div>
                        </MudNavGroup>

                    </MudNavMenu>
                    <div class="chat-type-nav-footer">
                        <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                       Size="Size.Small"
                                       Color="Color.Inherit"
                                       OnClick="OpenGlobalSettings"
                                       title="Settings" />
                    </div>
                    </div>
                </MudDrawer>
            }

            <MudMainContent Class="@($"main-content-area app-shell-main {(_isMobileShell ? "app-shell-main-mobile" : string.Empty)}")">
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
                            <MudAlert Severity="Severity.Error">
                                Error: @ex.Message
                            </MudAlert>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2"
                                       OnClick="() => Nav.NavigateTo(Nav.Uri, true)">Reload</MudButton>
                        </MudContainer>
                    </ErrorContent>
                </ErrorBoundary>
            </MudMainContent>
        </MudLayout>

        @* The mobile bottom nav (Rooms / Direct) was removed: the navigation drawer
           already lists both sections, so it duplicated navigation and covered the
           bottom of the screen. _isRoomsRoute / _isDirectMessagesRoute are still
           used for route-dependent behaviour elsewhere in this component. *@

        @* Floating call overlay (PiP when navigating away from call room) *@
        <FloatingCallOverlay />

        @if (_incomingPrivateCallUserId != null && !string.IsNullOrWhiteSpace(_incomingPrivateCallDisplayName))
        {
            <div class="incoming-call-overlay">
                <div class="incoming-call-sheet">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Class="incoming-call-label">Incoming call</MudText>
                        <MudText Typo="Typo.h6" Class="incoming-call-name">@_incomingPrivateCallDisplayName</MudText>
                        <MudText Typo="Typo.caption" Class="incoming-call-ringing">Ringing...</MudText>
                    </MudStack>

                    <MudStack Row Spacing="1" Class="incoming-call-actions">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   OnClick="DeclineIncomingPrivateCall">
                            Decline
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   OnClick="AcceptIncomingPrivateCallAsync">
                            Accept
                        </MudButton>
                    </MudStack>
                </div>
            </div>
        }

        @if (_participantActionsOpen && _participantActionsContext != null)
        {
            <div class="participant-actions-backdrop" @onclick="CloseParticipantActions"></div>
            <div class="participant-actions-sheet"
                 role="menu"
                 style="@GetParticipantActionsStyle()"
                 @onclick:stopPropagation="true">
                <MudText Typo="Typo.overline" Class="participant-actions-title">
                    @(_participantActionsContext.DisplayName)
                </MudText>

                @if (CanAdjustParticipantVolume(_participantActionsContext.UserId))
                {
                    <div class="participant-actions-volume" title="Mic volume (only for you)">
                        <button type="button"
                                class="@(_participantActionsVolume <= 0 ? "volume-mute-btn muted" : "volume-mute-btn")"
                                aria-label="@(_participantActionsVolume <= 0 ? "Unmute" : "Mute")"
                                aria-pressed="@(_participantActionsVolume <= 0)"
                                title="@(_participantActionsVolume <= 0 ? "Unmute" : "Mute")"
                                @onclick="ToggleParticipantMute">
                            <MudIcon Icon="@(_participantActionsVolume <= 0 ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)"
                                     Size="Size.Small" />
                        </button>
                        <input type="range" min="0" max="200" step="5"
                               value="@_participantActionsVolume"
                               aria-label="Mic volume"
                               @oninput="OnParticipantVolumeInput" />
                        <span class="participant-actions-volume-value">@($"{_participantActionsVolume:0}%")</span>
                    </div>
                }

                @if (_participantActionsContext.CanKick)
                {
                    <button type="button"
                            class="participant-actions-btn danger"
                            @onclick="KickParticipantFromActionsAsync">
                        Kick from call
                    </button>
                }

                @if (_participantActionsContext.CanMove && _participantActionsContext.MoveTargets.Count > 0)
                {
                    <div class="participant-actions-section-title">Move to room</div>
                    @foreach (var targetRoom in _participantActionsContext.MoveTargets)
                    {
                        <button type="button"
                                class="participant-actions-btn"
                                @onclick="() => MoveParticipantFromActionsAsync(targetRoom.Id)">
                            @($"#{targetRoom.Name}")
                        </button>
                    }
                }

                @if (_participantActionsContext.AssignableRoles.Count > 0)
                {
                    <div class="participant-actions-section-title">Set role</div>
                    @foreach (var role in _participantActionsContext.AssignableRoles)
                    {
                        <button type="button"
                                class="participant-actions-btn"
                                @onclick="() => SetParticipantRoleFromActionsAsync(role)">
                            @role.ToString()
                        </button>
                    }
                }
            </div>
        }
    }
</div>

@code {
    private bool _initialized;
    private bool _showRegister;
    private bool _drawerOpen = !(OperatingSystem.IsAndroid() || OperatingSystem.IsIOS());
    private bool _roomsGroupExpanded = true;
    private bool _privateChatsGroupExpanded = true;
    private bool _chatTypeListsLoading;
    private bool _chatTypeListsLoaded;
    private readonly bool _isMobileShell = OperatingSystem.IsAndroid() || OperatingSystem.IsIOS();
    private bool _isRoomsRoute = true;
    private bool _isDirectMessagesRoute;
    private bool _keepDrawerOpenOnNextNavigation;
    private Guid? _drawerPendingSelectedRoomId;
    private Guid? _incomingPrivateCallUserId;
    private string? _incomingPrivateCallDisplayName;
    private Guid? _draggedParticipantUserId;
    private Guid? _draggedParticipantSourceRoomId;
    private Guid? _dragOverRoomId;
    private DotNetObjectReference<MainLayout>? _roomParticipantDragDotNetRef;
    private bool _roomParticipantDragBound;
    private CancellationTokenSource? _participantLongPressCts;
    private DrawerParticipantActionContext? _participantActionsContext;
    private double _participantActionsVolume = 100;
    /// <summary>Level to restore when unmuting; only ever holds a non-zero value.</summary>
    private double _participantActionsVolumeBeforeMute = 100;
    private bool _participantActionsOpen;
    private double? _participantActionsClientX;
    private double? _participantActionsClientY;
    private CancellationTokenSource? _roomCallParticipantsSyncCts;
    private bool _roomCallParticipantsSyncInFlight;
    // Enum.GetValues allocates a fresh array on every call; this runs once per participant per
    // drawer render.
    private static readonly UserRole[] AllUserRoles = Enum.GetValues<UserRole>();

    // The hub pushes OnUserJoinedVoiceVideo/OnUserLeftVoiceVideo, so this poll is only a
    // reconciliation safety net. At 5s it issued a roster call for the whole authenticated
    // session — not gated on being in a call, on any call existing, or on visibility.
    private static readonly TimeSpan RoomCallParticipantsSyncInterval = TimeSpan.FromSeconds(30);
    private static readonly TimeSpan ParticipantLongPressDelay = TimeSpan.FromMilliseconds(550);
    private sealed record DrawerRoomParticipant(
        Guid UserId,
        string UserName,
        string DisplayName,
        string? AvatarUrl,
        UserRole Role);
    private sealed record DrawerParticipantActionContext(
        Guid RoomId,
        Guid UserId,
        string DisplayName,
        bool CanMove,
        bool CanKick,
        IReadOnlyList<ChatRoomInfo> MoveTargets,
        IReadOnlyList<UserRole> AssignableRoles);
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary       = "#128a80",
            Secondary     = "#c98c28",
            Surface       = "#ffffff",
            Background    = "#f3f6fb",
            AppbarBackground = "#ffffff",
            DrawerBackground = "#f5f8fc",
            DrawerText    = "#1e2f48",
            TextPrimary   = "#16233a",
            TextSecondary = "#50627c",
            ActionDefault = "#2e4460",
            Error         = "#cc3d48",
            Success       = "#1b9862",
            Warning       = "#cc8220",
            Info          = "#1f78c8"
        },
        PaletteDark = new PaletteDark
        {
            Primary       = "#16a59a",
            Secondary     = "#f1b645",
            Surface       = "#111a2a",
            Background    = "#070d17",
            AppbarBackground = "#0b1220",
            DrawerBackground = "#0b1220",
            DrawerText    = "#ccd6eb",
            TextPrimary   = "#edf3fc",
            TextSecondary = "#8fa4c4",
            ActionDefault = "#c2cede",
            Error         = "#ff5e6e",
            Success       = "#38cc8c",
            Warning       = "#ffb54a",
            Info          = "#52b2ff"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Manrope", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"]
            },
            H6 = new H6Typography
            {
                FontFamily    = ["Sora", "Manrope", "Segoe UI", "sans-serif"],
                FontWeight    = "600",
                LetterSpacing = ".015em"
            },
            Subtitle1 = new Subtitle1Typography
            {
                FontWeight = "600"
            },
            Button = new ButtonTypography
            {
                FontWeight    = "700",
                TextTransform = "none"
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += OnAuthChanged;
        Nav.LocationChanged += OnLocationChanged;
        Chat.OnConnectionStateChanged += OnConnectionChanged;
        Chat.OnMessageReceived += OnIncomingRoomMessage;
        Chat.OnPrivateMessageReceived += OnIncomingPrivateMessage;
        Chat.OnPrivateCallIncoming += OnIncomingPrivateCall;
        Call.OnChange += OnCallChanged;
        Rooms.OnChange += OnRoomsChanged;
        DirectMessages.OnChange += OnDirectMessagesChanged;
        MembersPanel.OnChange += OnMembersPanelChanged;
        _showRegister = IsRegisterPage();
        UpdateCurrentRoute();
        Updater.OnUpdateAvailable += OnUpdateAvailable;
        Updater.OnStateChanged += OnUpdaterStateChanged;
        NotificationNavigationBridge.NavigateRequested += OnNotificationNavigateRequested;

        if (!Auth.IsAuthenticated)
        {
            try
            {
                await Auth.TryAutoLoginAsync(Api, Chat);
            }
            catch
            {
                // Keep app on login when auto-login fails.
            }
        }

        if (Auth.IsAuthenticated)
        {
            await EnsureChatTypeListsLoadedAsync();
            StartRoomCallParticipantsSyncLoop();
            if (_isMobileShell)
            {
                _drawerOpen = false;
            }
        }

        _initialized = true;

        var pendingRoute = NotificationNavigationBridge.ConsumePendingNavigation();
        if (!string.IsNullOrWhiteSpace(pendingRoute))
        {
            NavigateToNotificationRoute(pendingRoute);
        }
    }

