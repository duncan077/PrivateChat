@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateProvider Auth
@inject ChatClientService Chat
@inject ChatRoomStore Rooms
@inject DirectMessageStore DirectMessages
@inject CallStore Call
@inject WebRtcBridge WebRtc
@inject GrpcChannelProvider Grpc
@inject NavigationManager Nav
@inject UpdateService Updater
@inject ApiClientService Api
@inject MembersPanelStore MembersPanel
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ISystemNotificationService SystemNotifications
<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-root @(_isMobileShell ? "app-root-mobile" : "app-root-desktop")">
    @if (Updater.HasUpdate)
    {
        <div class="update-banner">
            @if (Updater.State == UpdateState.Idle)
            {
                <span class="update-banner-text">
                    &#x1F4E6; Update available: v@(Updater.AvailableUpdate!.Version)
                    @if (!string.IsNullOrWhiteSpace(Updater.AvailableUpdate.ReleaseNotes))
                    {
                        <span class="update-banner-notes"> - @Updater.AvailableUpdate.ReleaseNotes</span>
                    }
                </span>
                <div class="update-banner-actions">
                    <button class="btn-update" @onclick="InstallUpdate">Update</button>
                    <button class="btn-update-dismiss" @onclick="DismissUpdate">Dismiss</button>
                </div>
            }
            else if (Updater.State == UpdateState.Downloading)
            {
                <span class="update-banner-text">&#x23EC; Downloading update... @((int)Updater.DownloadProgress)%</span>
                <div class="update-banner-progress">
                    <div class="update-banner-progress-fill" style="width:@((int)Updater.DownloadProgress)%"></div>
                </div>
            }
            else if (Updater.State == UpdateState.Extracting)
            {
                <span class="update-banner-text">&#x1F4E6; Extracting update...</span>
            }
            else if (Updater.State == UpdateState.Relaunching)
            {
                <span class="update-banner-text">&#x1F504; Relaunching...</span>
            }
            else if (Updater.State == UpdateState.Failed)
            {
                <span class="update-banner-text">
                    &#x26A0; Update failed: @Updater.ErrorMessage
                </span>
                <div class="update-banner-actions">
                    <button class="btn-update" @onclick="InstallUpdate">Retry update</button>
                    <button class="btn-update-dismiss" @onclick="DismissUpdate">Dismiss</button>
                </div>
            }
        </div>
    }

    @if (!_initialized)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fill-screen">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1">Initializing...</MudText>
        </MudStack>
    }
    else if (!Auth.IsAuthenticated)
    {
        <ErrorBoundary>
            <ChildContent>
                @if (_showRegister)
                {
                    <Register />
                }
                else
                {
                    <Login />
                }
            </ChildContent>
            <ErrorContent Context="ex">
                <MudAlert Severity="Severity.Error">Auth error: @ex.Message</MudAlert>
            </ErrorContent>
        </ErrorBoundary>
    }
    else
    {
        <MudLayout Class="@(_isMobileShell ? "app-shell-mobile" : "app-shell-desktop")">
            <MudAppBar Elevation="0" Dense="@(!_isMobileShell)" Color="Color.Surface" Class="app-shell-bar">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="ml-2 app-brand">PrivateChat</MudText>
                <MudText Typo="Typo.caption" Class="app-shell-subtitle">secure team messaging</MudText>
                <MudSpacer />
                @if (!Chat.IsConnected)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Reconnecting...</MudChip>
                }
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Color="Color.Inherit"
                           StartIcon="@(MembersPanel.IsVisible ? Icons.Material.Filled.PeopleAlt : Icons.Material.Filled.PeopleOutline)"
                           OnClick="ToggleMembersPanel">
                    @(MembersPanel.IsVisible ? "Hide Members" : "Show Members")
                </MudButton>
                @if (!_isMobileShell)
                {
                    var currentAvatarUrl = GetAvatarUrl(Auth.CurrentUser?.AvatarUrl);
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="mr-2">
                        <MudAvatar Size="Size.Small" Color="Color.Secondary">
                            @if (!string.IsNullOrWhiteSpace(currentAvatarUrl))
                            {
                                <img src="@currentAvatarUrl" alt="Profile" class="avatar-image-fill" />
                            }
                            else
                            {
                                @GetAvatarInitial(Auth.CurrentUser?.DisplayName, Auth.CurrentUser?.UserName)
                            }
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                            @Auth.CurrentUser?.DisplayName
                        </MudChip>
                    </MudStack>
                }
                <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                               Color="Color.Inherit"
                               OnClick="OpenProfileSettings"
                               title="Edit profile" />
                <MudIconButton Icon="@Icons.Material.Filled.ExitToApp" Color="Color.Inherit"
                               OnClick="Logout" title="Logout" />
            </MudAppBar>

            @if (!_isMobileShell || _drawerOpen)
            {
                <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always"
                           Variant="@(_isMobileShell ? DrawerVariant.Temporary : DrawerVariant.Mini)"
                           Breakpoint="@(_isMobileShell ? Breakpoint.Lg : Breakpoint.Md)"
                           OpenMiniOnHover="@(!_isMobileShell)" Class="app-shell-drawer">
                    <MudNavMenu Class="app-shell-nav">
                        <MudText Typo="Typo.overline" Class="chat-type-title">Chat</MudText>

                        <MudNavGroup Title="Rooms" Icon="@Icons.Material.Filled.Forum" Expanded="@_roomsGroupExpanded">
                            <div class="chat-type-group-content">
                                <div class="chat-type-actions">
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="OpenCreateRoomFromDrawer">
                                    </MudButton>
                                </div>

                                @if (_chatTypeListsLoading && Rooms.Rooms.Length == 0)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="chat-type-loading">
                                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                                        <MudText Typo="Typo.caption">Loading rooms...</MudText>
                                    </MudStack>
                                }
                                else if (Rooms.Rooms.Length == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="chat-type-empty">No rooms yet</MudText>
                                }
                                else
                                {
                                    <MudList T="Guid" Dense="true" Class="chat-type-list">
                                        @foreach (var room in Rooms.Rooms.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
                                        {
                                            <MudListItem T="Guid" Value="room.Id"
                                                         OnClick="() => OpenRoomFromDrawer(room.Id)"
                                                         Class="@($"chat-type-entry {(IsRoomSelected(room.Id) ? "active" : string.Empty)}")">
                                                <div class="chat-type-row">
                                                    <MudIcon Icon="@GetRoomIcon(room)" Size="Size.Small" />
                                                    <MudText Typo="Typo.caption" Class="chat-type-label">@room.Name</MudText>
                                                </div>
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                            </div>
                        </MudNavGroup>

                        <MudNavGroup Title="Private Chats" Icon="@Icons.Material.Filled.Email" Expanded="@_privateChatsGroupExpanded">
                            <div class="chat-type-group-content">
                                <div class="chat-type-actions">
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.PersonSearch"
                                               OnClick="OpenSelectPrivateUserFromDrawer">
                                    </MudButton>
                                </div>

                                @if (_chatTypeListsLoading && DirectMessages.Contacts.Length == 0)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="chat-type-loading">
                                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                                        <MudText Typo="Typo.caption">Loading contacts...</MudText>
                                    </MudStack>
                                }
                                else if (DirectMessages.Contacts.Length == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="chat-type-empty">No private chats yet</MudText>
                                }
                                else
                                {
                                    <MudList T="Guid" Dense="true" Class="chat-type-list">
                                        @foreach (var contact in DirectMessages.Contacts.OrderBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase))
                                        {
                                            var contactAvatarUrl = GetAvatarUrl(contact.AvatarUrl);
                                            <MudListItem T="Guid" Value="contact.Id"
                                                         OnClick="() => OpenDirectMessageFromDrawer(contact.Id)"
                                                         Class="@($"chat-type-entry {(IsDirectMessageSelected(contact.Id) ? "active" : string.Empty)}")">
                                                <div class="chat-type-row">
                                                    <MudAvatar Size="Size.Small"
                                                               Color="Color.Secondary"
                                                               Class="chat-type-avatar">
                                                        @if (!string.IsNullOrWhiteSpace(contactAvatarUrl))
                                                        {
                                                            <img src="@contactAvatarUrl" alt="Profile" class="avatar-image-fill" />
                                                        }
                                                        else
                                                        {
                                                            @GetAvatarInitial(contact.DisplayName, contact.UserName)
                                                        }
                                                    </MudAvatar>
                                                    <MudText Typo="Typo.caption" Class="chat-type-label">@contact.DisplayName</MudText>
                                                </div>
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                            </div>
                        </MudNavGroup>

                        <div class="chat-type-nav-footer">
                            <MudDivider Class="my-2" />
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.AccountCircle"
                                       OnClick="OpenProfileSettings"
                                       Class="mb-1">
                                Profile
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Settings"
                                       OnClick="OpenGlobalSettings">
                                Settings
                            </MudButton>
                        </div>
                    </MudNavMenu>
                </MudDrawer>
            }

            <MudMainContent Class="@($"main-content-area app-shell-main {(_isMobileShell ? "app-shell-main-mobile" : string.Empty)}")">
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
                            <MudAlert Severity="Severity.Error">
                                Error: @ex.Message
                            </MudAlert>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2"
                                       OnClick="() => Nav.NavigateTo(Nav.Uri, true)">Reload</MudButton>
                        </MudContainer>
                    </ErrorContent>
                </ErrorBoundary>
            </MudMainContent>
        </MudLayout>

        @if (_isMobileShell)
        {
            <nav class="mobile-bottom-nav">
                <button type="button" class="mobile-bottom-nav-btn @(_isRoomsRoute ? "active" : string.Empty)" @onclick="NavigateToRooms">
                    <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Small" />
                    <span>Rooms</span>
                </button>
                <button type="button" class="mobile-bottom-nav-btn @(_isDirectMessagesRoute ? "active" : string.Empty)" @onclick="NavigateToDirectMessages">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                    <span>Direct</span>
                </button>
            </nav>
        }

        @* Floating call overlay (PiP when navigating away from call room) *@
        <FloatingCallOverlay />

        @if (_incomingPrivateCallUserId != null && !string.IsNullOrWhiteSpace(_incomingPrivateCallDisplayName))
        {
            <div class="incoming-call-overlay">
                <div class="incoming-call-sheet">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Class="incoming-call-label">Incoming call</MudText>
                        <MudText Typo="Typo.h6" Class="incoming-call-name">@_incomingPrivateCallDisplayName</MudText>
                        <MudText Typo="Typo.caption" Class="incoming-call-ringing">Ringing...</MudText>
                    </MudStack>

                    <MudStack Row Spacing="1" Class="incoming-call-actions">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   OnClick="DeclineIncomingPrivateCall">
                            Decline
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   OnClick="AcceptIncomingPrivateCallAsync">
                            Accept
                        </MudButton>
                    </MudStack>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _initialized;
    private bool _showRegister;
    private bool _drawerOpen = !(OperatingSystem.IsAndroid() || OperatingSystem.IsIOS());
    private bool _roomsGroupExpanded = true;
    private bool _privateChatsGroupExpanded = true;
    private bool _chatTypeListsLoading;
    private bool _chatTypeListsLoaded;
    private readonly bool _isMobileShell = OperatingSystem.IsAndroid() || OperatingSystem.IsIOS();
    private bool _isRoomsRoute = true;
    private bool _isDirectMessagesRoute;
    private bool _keepDrawerOpenOnNextNavigation;
    private Guid? _incomingPrivateCallUserId;
    private string? _incomingPrivateCallDisplayName;
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#128a80",
            Secondary = "#d99a2f",
            Surface = "#ffffff",
            Background = "#f4f7fb",
            AppbarBackground = "#ffffff",
            DrawerBackground = "#f7f9fc",
            DrawerText = "#21314d",
            TextPrimary = "#18253b",
            TextSecondary = "#54657f",
            ActionDefault = "#324a6b",
            Error = "#d0464f",
            Success = "#1f9f69",
            Warning = "#d7892b",
            Info = "#237fcf"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#16a59a",
            Secondary = "#f1b645",
            Surface = "#121a29",
            Background = "#070d17",
            AppbarBackground = "#0d1422",
            DrawerBackground = "#0d1422",
            DrawerText = "#cfd9ea",
            TextPrimary = "#eef3fb",
            TextSecondary = "#9eacc6",
            ActionDefault = "#c7d1e2",
            Error = "#ff6375",
            Success = "#3fd495",
            Warning = "#ffb95a",
            Info = "#57b6ff"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Manrope", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"]
            },
            H6 = new H6Typography
            {
                FontFamily = ["Sora", "Manrope", "Segoe UI", "sans-serif"],
                FontWeight = "600",
                LetterSpacing = ".015em"
            },
            Subtitle1 = new Subtitle1Typography
            {
                FontWeight = "600"
            },
            Button = new ButtonTypography
            {
                FontWeight = "700",
                TextTransform = "none"
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += OnAuthChanged;
        Nav.LocationChanged += OnLocationChanged;
        Chat.OnConnectionStateChanged += OnConnectionChanged;
        Chat.OnMessageReceived += OnIncomingRoomMessage;
        Chat.OnPrivateMessageReceived += OnIncomingPrivateMessage;
        Chat.OnPrivateCallIncoming += OnIncomingPrivateCall;
        Call.OnChange += OnCallChanged;
        Rooms.OnChange += OnRoomsChanged;
        DirectMessages.OnChange += OnDirectMessagesChanged;
        _showRegister = IsRegisterPage();
        UpdateCurrentRoute();
        Updater.OnUpdateAvailable += OnUpdateAvailable;
        Updater.OnStateChanged += OnUpdaterStateChanged;
        NotificationNavigationBridge.NavigateRequested += OnNotificationNavigateRequested;

        if (!Auth.IsAuthenticated)
        {
            try
            {
                await Auth.TryAutoLoginAsync(Api, Chat);
            }
            catch
            {
                // Keep app on login when auto-login fails.
            }
        }

        if (Auth.IsAuthenticated)
        {
            await EnsureChatTypeListsLoadedAsync();
            if (_isMobileShell)
            {
                _drawerOpen = false;
            }
        }

        _initialized = true;

        var pendingRoute = NotificationNavigationBridge.ConsumePendingNavigation();
        if (!string.IsNullOrWhiteSpace(pendingRoute))
        {
            NavigateToNotificationRoute(pendingRoute);
        }
    }

    private void OnUpdateAvailable()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnUpdaterStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task InstallUpdate()
    {
        await Updater.DownloadAndInstallAsync();
    }

    private void DismissUpdate()
    {
        Updater.DismissAvailableUpdate();
    }

    private void OnAuthChanged()
    {
        if (Auth.IsAuthenticated)
        {
            _ = EnsureChatTypeListsLoadedAsync();
            if (_isMobileShell)
            {
                _drawerOpen = false;
            }
        }
        else
        {
            _chatTypeListsLoaded = false;
            ClearIncomingPrivateCallPrompt();
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnConnectionChanged(bool connected)
    {
        if (connected && Auth.IsAuthenticated && !_chatTypeListsLoaded)
        {
            _ = EnsureChatTypeListsLoadedAsync();
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _showRegister = IsRegisterPage();
        UpdateCurrentRoute();
        if (_isMobileShell)
        {
            _drawerOpen = _keepDrawerOpenOnNextNavigation;
            _keepDrawerOpenOnNextNavigation = false;
        }

        InvokeAsync(StateHasChanged);
    }

    private bool IsRegisterPage() =>
        Nav.ToBaseRelativePath(Nav.Uri).StartsWith("register", StringComparison.OrdinalIgnoreCase);

    private void UpdateCurrentRoute()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var path = relative.Split('?', '#')[0].Trim('/');
        _isRoomsRoute = string.IsNullOrWhiteSpace(path);
        _isDirectMessagesRoute = path.Equals("dm", StringComparison.OrdinalIgnoreCase);
    }

    private void NavigateToRooms()
    {
        if (_isRoomsRoute)
            return;

        Nav.NavigateTo("/");
    }

    private void NavigateToDirectMessages()
    {
        if (_isDirectMessagesRoute)
            return;

        Nav.NavigateTo("/dm");
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleMembersPanel() => MembersPanel.Toggle();

    private async Task OpenGlobalSettings()
    {
        try { await WebRtc.EnumerateDevicesAsync(); } catch { }
        await Task.Delay(120);

        var parameters = new DialogParameters<CallSettingsDialog>
        {
            { x => x.Store, Call },
            { x => x.WebRtc, WebRtc },
            { x => x.ApplyLiveChanges, Call.IsInCall }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        CloseDrawerOnMobile();
        await DialogService.ShowAsync<CallSettingsDialog>("Settings", parameters, options);
    }

    private async Task OpenProfileSettings()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        CloseDrawerOnMobile();
        await DialogService.ShowAsync<ProfileSettingsDialog>(
            "Edit Profile",
            new DialogParameters<ProfileSettingsDialog>(),
            options);
    }

    private void OnIncomingRoomMessage(ChatMessage message)
    {
        _ = InvokeAsync(async () =>
        {
            if (!Call.NotificationsEnabled)
                return;

            var currentUserId = Auth.CurrentUser?.Id;
            if (currentUserId != null && message.SenderId == currentUserId.Value)
                return;

            if (message.MessageType == ChatMessageType.System)
                return;

            var roomNotificationMode = Rooms.GetRoomNotificationMode(message.RoomId);
            if (roomNotificationMode == RoomNotificationMode.Muted)
                return;

            if (roomNotificationMode == RoomNotificationMode.MentionsOnly
                && (currentUserId == null || message.MentionedUserIds == null || !message.MentionedUserIds.Contains(currentUserId.Value)))
                return;

            if (IsCurrentRoomConversation(message.RoomId))
                return;

            var roomName = Rooms.Rooms.FirstOrDefault(r => r.Id == message.RoomId)?.Name ?? "room";
            await ShowIncomingMessageNotificationAsync(
                locationLabel: $"#{roomName}",
                senderLabel: message.SenderName,
                content: message.Content,
                attachmentCount: message.Attachments?.Length ?? 0,
                navigateUri: $"/?roomId={message.RoomId:D}");
        });
    }

    private void OnIncomingPrivateMessage(PrivateMessage message)
    {
        _ = InvokeAsync(async () =>
        {
            if (!Call.NotificationsEnabled)
                return;

            var currentUserId = Auth.CurrentUser?.Id;
            if (currentUserId == null)
                return;

            // Only notify incoming messages from other users.
            if (message.SenderId == currentUserId.Value)
                return;

            var conversationUserId = message.SenderId;
            if (DirectMessages.IsContactNotificationsMuted(conversationUserId))
                return;

            if (IsCurrentDirectConversation(conversationUserId))
                return;

            var senderName = DirectMessages.Contacts.FirstOrDefault(c => c.Id == conversationUserId)?.DisplayName;
            if (string.IsNullOrWhiteSpace(senderName))
            {
                senderName = !string.IsNullOrWhiteSpace(message.SenderName)
                    ? message.SenderName
                    : "Direct message";
            }

            await ShowIncomingMessageNotificationAsync(
                locationLabel: "direct message",
                senderLabel: senderName,
                content: message.Content,
                attachmentCount: message.Attachments?.Length ?? 0,
                navigateUri: $"/dm?userId={conversationUserId:D}");
        });
    }

    private void OnIncomingPrivateCall(Guid callerUserId)
    {
        _ = InvokeAsync(async () =>
        {
            if (!Call.NotificationsEnabled)
                return;

            var currentUserId = Auth.CurrentUser?.Id;
            if (currentUserId == null || callerUserId == Guid.Empty || callerUserId == currentUserId.Value)
                return;

            if (DirectMessages.IsContactNotificationsMuted(callerUserId))
                return;

            if (Call.IsActiveDirectCallWith(callerUserId))
                return;

            var callerName = DirectMessages.Contacts.FirstOrDefault(c => c.Id == callerUserId)?.DisplayName;
            if (string.IsNullOrWhiteSpace(callerName))
            {
                callerName = $"User {callerUserId.ToString()[..8]}";
            }

            ShowIncomingPrivateCallPrompt(callerUserId, callerName);

            var navigateUri = BuildIncomingCallRoute(callerUserId);
            var deliveredBySystem = await SystemNotifications.ShowChatNotificationAsync(
                title: callerName,
                message: "is calling you",
                navigateUri: navigateUri);

            if (deliveredBySystem)
            {
                return;
            }

            Snackbar.Add($"{callerName} is calling you", Severity.Info, options =>
            {
                options.ShowCloseIcon = true;
                options.VisibleStateDuration = 7000;
                options.HideTransitionDuration = 150;
                options.ShowTransitionDuration = 150;
                options.Action = "Open";
                options.ActionColor = Color.Primary;
                options.OnClick = _ =>
                {
                    CloseDrawerOnMobile();
                    Nav.NavigateTo(navigateUri);
                    return Task.CompletedTask;
                };
            });
        });
    }

    private void OnCallChanged()
    {
        if (_incomingPrivateCallUserId != null
            && Call.IsInCall
            && Call.ActiveCallKind == CallContextKind.DirectMessage
            && Call.ActiveDirectPeerUserId == _incomingPrivateCallUserId.Value)
        {
            ClearIncomingPrivateCallPrompt();
        }

        InvokeAsync(StateHasChanged);
    }

    private void ShowIncomingPrivateCallPrompt(Guid callerUserId, string callerDisplayName)
    {
        _incomingPrivateCallUserId = callerUserId;
        _incomingPrivateCallDisplayName = callerDisplayName;
    }

    private void ClearIncomingPrivateCallPrompt()
    {
        _incomingPrivateCallUserId = null;
        _incomingPrivateCallDisplayName = null;
    }

    private string BuildIncomingCallRoute(Guid callerUserId)
    {
        var nonce = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        return $"/dm?userId={callerUserId:D}&joinCall=true&callNonce={nonce}";
    }

    private void DeclineIncomingPrivateCall()
    {
        ClearIncomingPrivateCallPrompt();
    }

    private Task AcceptIncomingPrivateCallAsync()
    {
        if (_incomingPrivateCallUserId == null || _incomingPrivateCallUserId == Guid.Empty)
        {
            ClearIncomingPrivateCallPrompt();
            return Task.CompletedTask;
        }

        var target = _incomingPrivateCallUserId.Value;
        ClearIncomingPrivateCallPrompt();
        CloseDrawerOnMobile();
        Nav.NavigateTo(BuildIncomingCallRoute(target));
        return Task.CompletedTask;
    }

    private bool IsCurrentRoomConversation(Guid roomId)
    {
        if (!_isRoomsRoute) return false;
        if (Rooms.SelectedRoomId == roomId) return true;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        return TryGetQueryGuid(uri.Query, "roomId", out var queryRoomId) && queryRoomId == roomId;
    }

    private bool IsCurrentDirectConversation(Guid userId)
    {
        if (!_isDirectMessagesRoute) return false;
        if (DirectMessages.SelectedContactId == userId) return true;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        return TryGetQueryGuid(uri.Query, "userId", out var queryUserId) && queryUserId == userId;
    }

    private async Task ShowIncomingMessageNotificationAsync(string locationLabel, string? senderLabel, string? content, int attachmentCount, string? navigateUri = null)
    {
        var sender = string.IsNullOrWhiteSpace(senderLabel) ? "New message" : senderLabel.Trim();
        var snippet = BuildMessageNotificationSnippet(content, attachmentCount);
        var text = $"{sender} in {locationLabel}";
        if (!string.IsNullOrWhiteSpace(snippet))
        {
            text = $"{text}: {snippet}";
        }

        var systemMessage = string.IsNullOrWhiteSpace(snippet)
            ? locationLabel
            : $"{locationLabel}: {snippet}";

        var deliveredBySystem = await SystemNotifications.ShowChatNotificationAsync(
            title: sender,
            message: systemMessage,
            navigateUri: navigateUri);

        if (deliveredBySystem)
        {
            return;
        }

        Snackbar.Add(text, Severity.Info, options =>
        {
            options.ShowCloseIcon = true;
            options.VisibleStateDuration = 5000;
            options.HideTransitionDuration = 150;
            options.ShowTransitionDuration = 150;
            if (!string.IsNullOrWhiteSpace(navigateUri))
            {
                options.Action = "Open";
                options.ActionColor = Color.Primary;
                options.OnClick = _ =>
                {
                    CloseDrawerOnMobile();
                    Nav.NavigateTo(navigateUri);
                    return Task.CompletedTask;
                };
            }
        });
    }

    private void OnNotificationNavigateRequested(string route)
    {
        _ = InvokeAsync(() => NavigateToNotificationRoute(route));
    }

    private void NavigateToNotificationRoute(string route)
    {
        if (string.IsNullOrWhiteSpace(route))
        {
            return;
        }

        CloseDrawerOnMobile();
        Nav.NavigateTo(route.Trim());
    }

    private static string BuildMessageNotificationSnippet(string? content, int attachmentCount)
    {
        var normalized = (content ?? string.Empty)
            .Trim()
            .ReplaceLineEndings(" ");

        if (normalized.Length > 90)
        {
            normalized = $"{normalized[..87]}...";
        }

        if (string.IsNullOrWhiteSpace(normalized))
        {
            if (attachmentCount <= 0) return string.Empty;
            return attachmentCount == 1 ? "[attachment]" : $"[{attachmentCount} attachments]";
        }

        if (attachmentCount <= 0) return normalized;
        return attachmentCount == 1
            ? $"{normalized} (+1 attachment)"
            : $"{normalized} (+{attachmentCount} attachments)";
    }

    private async Task Logout()
    {
        try { await Chat.DisconnectAsync(); } catch { }
        Grpc.ResetChannel();
        Auth.ClearAuth();
    }

    private async Task EnsureChatTypeListsLoadedAsync()
    {
        if (!Auth.IsAuthenticated || _chatTypeListsLoading || _chatTypeListsLoaded)
            return;

        _chatTypeListsLoading = true;
        try
        {
            await Task.WhenAll(
                Rooms.LoadRoomsAsync(),
                DirectMessages.LoadContactsAsync());
            _chatTypeListsLoaded = true;
        }
        finally
        {
            _chatTypeListsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

