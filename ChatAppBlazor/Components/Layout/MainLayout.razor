    private bool IsRoomSelected(Guid roomId)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var isRoomsPage = uri.AbsolutePath.Equals("/", StringComparison.OrdinalIgnoreCase);
        if (!isRoomsPage) return false;

        if (_drawerPendingSelectedRoomId is Guid pendingRoomId && pendingRoomId != Guid.Empty)
        {
            return pendingRoomId == roomId;
        }

        // Store selection is authoritative for live state changes (for example,
        // moderator drag-move that switches current room without immediate route update).
        if (Rooms.SelectedRoomId is Guid selectedRoomId && selectedRoomId != Guid.Empty)
        {
            return selectedRoomId == roomId;
        }

        if (TryGetQueryGuid(uri.Query, "roomId", out var roomIdFromQuery))
        {
            return roomIdFromQuery == roomId;
        }

        return false;
    }

