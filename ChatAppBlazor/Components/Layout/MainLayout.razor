        if (TryGetQueryGuid(uri.Query, "userId", out var userIdFromQuery))
        {
            return userIdFromQuery == userId;
        }

        return DirectMessages.SelectedContactId == userId;
    }

    private IReadOnlyList<DrawerRoomParticipant> GetRoomCallParticipants(ChatRoomInfo room)
    {
        if (room.Id == Guid.Empty)
        {
            return [];
        }

        var participantIds = Call.GetRoomParticipants(room.Id)
            .Where(id => id != Guid.Empty)
            .ToArray();

        if (Call.IsInCall
            && Call.ActiveCallKind == CallContextKind.Room
            && Call.ActiveRoomId == room.Id)
        {
            var activeIds = Call.Participants
                .Where(id => id != Guid.Empty)
                .ToList();

            if (Auth.CurrentUser?.Id is Guid selfId && selfId != Guid.Empty)
            {
                activeIds.Add(selfId);
            }

            participantIds = participantIds
                .Concat(activeIds)
                .Where(id => id != Guid.Empty)
                .Distinct()
                .ToArray();
        }
        else
        {
            participantIds = participantIds
                .Where(id => id != Guid.Empty)
                .Distinct()
                .ToArray();
        }

        if (participantIds.Length == 0)
        {
            return [];
        }

        var participants = new List<DrawerRoomParticipant>(participantIds.Length);
        foreach (var participantId in participantIds)
        {
            var serverMember = Rooms.FindServerMember(participantId);
            if (serverMember != null)
            {
                var displayName = string.IsNullOrWhiteSpace(serverMember.DisplayName)
                    ? serverMember.UserName
                    : serverMember.DisplayName.Trim();

                participants.Add(new DrawerRoomParticipant(
                    participantId,
                    serverMember.UserName,
                    string.IsNullOrWhiteSpace(displayName) ? $"User {participantId.ToString()[..8]}" : displayName,
                    serverMember.AvatarUrl,
                    serverMember.Role));
                continue;
            }

            if (Auth.CurrentUser?.Id == participantId)
            {
                var selfName = !string.IsNullOrWhiteSpace(Auth.CurrentUser.DisplayName)
                    ? Auth.CurrentUser.DisplayName.Trim()
                    : (!string.IsNullOrWhiteSpace(Auth.CurrentUser.UserName)
                        ? Auth.CurrentUser.UserName.Trim()
                        : $"User {participantId.ToString()[..8]}");

                participants.Add(new DrawerRoomParticipant(
                    participantId,
                    Auth.CurrentUser.UserName ?? string.Empty,
                    selfName,
                    Auth.CurrentUser.AvatarUrl,
                    UserRole.Member));
                continue;
            }

            participants.Add(new DrawerRoomParticipant(
                participantId,
                $"user_{participantId.ToString()[..8]}",
                $"User {participantId.ToString()[..8]}",
                null,
                UserRole.Member));
        }

        return participants
            .OrderBy(participant => participant.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(participant => participant.UserName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private bool CanModerateRoomParticipant(Guid userId)
    {
        if (userId == Guid.Empty || userId == Auth.CurrentUser?.Id)
        {
            return false;
        }

        if (Rooms.CurrentUserRole < UserRole.Moderator)
        {
            return false;
        }

        var targetRole = Rooms.FindServerMember(userId)?.Role ?? UserRole.Member;
        return targetRole < Rooms.CurrentUserRole;
    }

    private bool CanMoveRoomParticipant(Guid userId)
    {
        if (userId == Guid.Empty)
        {
            return false;
        }

        if (Rooms.CurrentUserRole < UserRole.Moderator)
        {
            return false;
        }

        if (Rooms.CurrentUserRole >= UserRole.Admin)
        {
            return true;
        }

        if (userId == Auth.CurrentUser?.Id)
        {
            return true;
        }

        var targetRole = Rooms.FindServerMember(userId)?.Role ?? UserRole.Member;
        return targetRole < Rooms.CurrentUserRole;
    }

    private bool CanManageRolesForParticipant(Guid userId)
        => CanModerateRoomParticipant(userId) && Rooms.CurrentUserRole >= UserRole.Admin;

    private IReadOnlyList<UserRole> GetAssignableRoles(Guid userId)
    {
        if (!CanManageRolesForParticipant(userId))
        {
            return [];
        }

        var currentRole = Rooms.FindServerMember(userId)?.Role ?? UserRole.Member;
        return AllUserRoles
            .Where(role => role != UserRole.Owner && role < Rooms.CurrentUserRole && role != currentRole)
            .OrderByDescending(role => role)
            .ToArray();
    }

    /// <summary>
    /// Everyone can adjust another participant's local volume, so the menu opens
    /// for any call participant who isn't yourself; moderation entries inside it
    /// stay permission-gated separately.
    /// </summary>
    private bool CanAdjustParticipantVolume(Guid userId)
        => userId != Guid.Empty && userId != Auth.CurrentUser?.Id;

    private bool CanOpenParticipantActions(Guid roomId, Guid userId)
    {
        if (roomId == Guid.Empty || userId == Guid.Empty)
        {
            return false;
        }

        return CanAdjustParticipantVolume(userId)
            || CanMoveRoomParticipant(userId)
            || CanModerateRoomParticipant(userId)
            || GetAssignableRoles(userId).Count > 0;
    }

    private async Task HandleParticipantContextMenu(Guid roomId, DrawerRoomParticipant participant, MouseEventArgs _)
    {
        CancelParticipantLongPress();
        await OpenParticipantActionsAsync(roomId, participant, _.ClientX, _.ClientY);
    }

    private void StartParticipantLongPress(Guid roomId, DrawerRoomParticipant participant, TouchEventArgs eventArgs)
    {
        CancelParticipantLongPress();
        if (!CanOpenParticipantActions(roomId, participant.UserId))
        {
            return;
        }

        var touchPoint = eventArgs.Touches.FirstOrDefault() ?? eventArgs.ChangedTouches.FirstOrDefault();
        var touchX = touchPoint?.ClientX;
        var touchY = touchPoint?.ClientY;

        var cts = new CancellationTokenSource();
        _participantLongPressCts = cts;
        _ = RunParticipantLongPressAsync(roomId, participant, touchX, touchY, cts.Token);
    }

    private async Task RunParticipantLongPressAsync(
        Guid roomId,
        DrawerRoomParticipant participant,
        double? clientX,
        double? clientY,
        CancellationToken token)
    {
        try
        {
            await Task.Delay(ParticipantLongPressDelay, token);
            if (token.IsCancellationRequested)
            {
                return;
            }

            await InvokeAsync(() => OpenParticipantActionsAsync(roomId, participant, clientX, clientY));
        }
        catch (OperationCanceledException)
        {
            // Ignore canceled long-press gesture.
        }
    }

    private void CancelParticipantLongPress()
    {
        if (_participantLongPressCts == null)
        {
            return;
        }

        try
        {
            _participantLongPressCts.Cancel();
        }
        catch
        {
            // Ignore cancellation races.
        }
        finally
        {
            _participantLongPressCts.Dispose();
            _participantLongPressCts = null;
        }
    }

    private async Task OpenParticipantActionsAsync(
        Guid roomId,
        DrawerRoomParticipant participant,
        double? clientX = null,
        double? clientY = null)
    {
        if (!CanOpenParticipantActions(roomId, participant.UserId))
        {
            return;
        }

        var moveTargets = CanMoveRoomParticipant(participant.UserId)
            ? GetRoomMoveTargets(roomId)
            : [];
        var assignableRoles = GetAssignableRoles(participant.UserId);

        _participantActionsContext = new DrawerParticipantActionContext(
            roomId,
            participant.UserId,
            string.IsNullOrWhiteSpace(participant.DisplayName) ? participant.UserName : participant.DisplayName,
            CanMoveRoomParticipant(participant.UserId),
            CanModerateRoomParticipant(participant.UserId),
            moveTargets,
            assignableRoles);
        _participantActionsClientX = clientX;
        _participantActionsClientY = clientY;
        _participantActionsOpen = true;

        // Open with the stored value rather than waiting on interop, then correct
        // if the bridge answers with something else.
        _participantActionsVolume = 100;
        _participantActionsVolumeBeforeMute = 100;
        StateHasChanged();

        if (CanAdjustParticipantVolume(participant.UserId))
        {
            try
            {
                var current = await WebRtc.GetUserMicVolumeAsync(participant.UserId);
                if (_participantActionsContext?.UserId == participant.UserId)
                {
                    _participantActionsVolume = Math.Clamp(current, 0, 200);
                    if (_participantActionsVolume > 0)
                    {
                        // Someone opened at a real level; that is what unmuting returns to.
                        _participantActionsVolumeBeforeMute = _participantActionsVolume;
                    }
                    StateHasChanged();
                }
            }
            catch
            {
                // Volume readback is cosmetic; the slider still works from 100%.
            }
        }
    }

    private void OnParticipantVolumeInput(ChangeEventArgs e)
    {
        if (_participantActionsContext == null) return;
        if (!double.TryParse(e.Value?.ToString(), out var volume)) return;

        _participantActionsVolume = Math.Clamp(volume, 0, 200);
        if (_participantActionsVolume > 0)
        {
            // Dragging off zero is an unmute, so the level to come back to is this one.
            _participantActionsVolumeBeforeMute = _participantActionsVolume;
        }

        var userId = _participantActionsContext.UserId;
        // Fire-and-forget so dragging stays smooth; the JS side coalesces bursts.
        _ = ApplyParticipantVolumeAsync(userId, _participantActionsVolume);
    }

    /// <summary>
    /// Mutes this participant for the local user, or restores the level they were at.
    ///
    /// Muting deliberately keeps the slider's own value at 0 rather than tracking a
    /// separate flag: the slider, the icon and what is actually applied then cannot
    /// disagree, and dragging away from zero is itself an unmute.
    /// </summary>
    private void ToggleParticipantMute()
    {
        if (_participantActionsContext == null) return;

        if (_participantActionsVolume > 0)
        {
            _participantActionsVolumeBeforeMute = _participantActionsVolume;
            _participantActionsVolume = 0;
        }
        else
        {
            // Falls back to 100 when they were already silent when the sheet opened,
            // so unmuting can never be a no-op.
            _participantActionsVolume = _participantActionsVolumeBeforeMute > 0
                ? _participantActionsVolumeBeforeMute
                : 100;
        }

        _ = ApplyParticipantVolumeAsync(_participantActionsContext.UserId, _participantActionsVolume);
    }

    private async Task ApplyParticipantVolumeAsync(Guid userId, double volume)
    {
        try
        {
            await WebRtc.SetUserMicVolumeAsync(userId, volume);
        }
        catch
        {
            // A dropped slider sample is invisible; the next one lands.
        }
    }

    private string GetParticipantActionsStyle()
    {
        const double defaultX = 220;
        const double defaultY = 180;
        var x = _participantActionsClientX ?? defaultX;
        var y = _participantActionsClientY ?? defaultY;

        // Keep the menu inside the viewport with a small margin; the width bound
        // matches .participant-actions-sheet.
        var clampedX = Math.Max(12, x + 4);
        var clampedY = Math.Max(12, y + 4);

        return $"left:min(calc(100vw - 268px), max(12px, {clampedX:0.##}px));" +
               $"top:min(calc(100vh - 320px), max(12px, {clampedY:0.##}px));";
    }

    private void CloseParticipantActions()
    {
        _participantActionsOpen = false;
        _participantActionsContext = null;
        _participantActionsClientX = null;
        _participantActionsClientY = null;
        CancelParticipantLongPress();
    }

    private async Task KickParticipantFromActionsAsync()
    {
        var context = _participantActionsContext;
        CloseParticipantActions();

        if (context == null)
        {
            return;
        }

        await KickUserFromRoomCallAsync(context.RoomId, context.UserId);
    }

    private async Task MoveParticipantFromActionsAsync(Guid targetRoomId)
    {
        var context = _participantActionsContext;
        CloseParticipantActions();

        if (context == null)
        {
            return;
        }

        await MoveUserBetweenRoomsAsync(context.RoomId, targetRoomId, context.UserId);
    }

    private async Task SetParticipantRoleFromActionsAsync(UserRole role)
    {
        var context = _participantActionsContext;
        CloseParticipantActions();

        if (context == null)
        {
            return;
        }

        await SetUserRoleFromDrawerAsync(context.RoomId, context.UserId, role);
    }

    private IReadOnlyList<ChatRoomInfo> GetRoomMoveTargets(Guid sourceRoomId)
    {
        if (sourceRoomId == Guid.Empty)
        {
            return [];
        }

        return Rooms.Rooms
            .Where(room => room.Id != sourceRoomId && IsVoiceVideoRoom(room))
            .OrderBy(room => room.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static bool IsVoiceVideoRoom(ChatRoomInfo room)
        => room.Id != Guid.Empty && (room.IsVoiceEnabled || room.IsVideoEnabled);

    private string GetRoomCallDropTargetClass(ChatRoomInfo room)
    {
        var classes = new List<string> { "chat-type-room-entry" };
        if (CanDropDraggedParticipantIntoRoom(room.Id))
        {
            classes.Add("chat-type-room-drop-enabled");
        }
        if (_dragOverRoomId == room.Id && CanDropDraggedParticipantIntoRoom(room.Id))
        {
            classes.Add("chat-type-room-drop-hover");
        }
        return string.Join(" ", classes);
    }

    private bool CanDropDraggedParticipantIntoRoom(Guid targetRoomId)
    {
        if (_draggedParticipantUserId is not Guid userId
            || _draggedParticipantSourceRoomId is not Guid sourceRoomId
            || userId == Guid.Empty
            || sourceRoomId == Guid.Empty
            || targetRoomId == Guid.Empty
            || targetRoomId == sourceRoomId)
        {
            return false;
        }

        var targetRoom = Rooms.Rooms.FirstOrDefault(room => room.Id == targetRoomId);
        if (targetRoom == null || !IsVoiceVideoRoom(targetRoom))
        {
            return false;
        }

        return CanMoveRoomParticipant(userId);
    }

    private void HandleParticipantDragStart(Guid sourceRoomId, Guid userId)
    {
        CloseParticipantActions();
        if (!CanMoveRoomParticipant(userId))
        {
            return;
        }

        var sourceRoom = Rooms.Rooms.FirstOrDefault(room => room.Id == sourceRoomId);
        if (sourceRoom == null || !IsVoiceVideoRoom(sourceRoom))
        {
            return;
        }

        _draggedParticipantSourceRoomId = sourceRoomId;
        _draggedParticipantUserId = userId;
        _dragOverRoomId = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleParticipantDragEnd()
    {
        if (_draggedParticipantUserId == null && _draggedParticipantSourceRoomId == null && _dragOverRoomId == null)
        {
            return;
        }

        _draggedParticipantUserId = null;
        _draggedParticipantSourceRoomId = null;
        _dragOverRoomId = null;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnRoomParticipantDragStart(string sourceRoomId, string userId)
    {
        if (Guid.TryParse(sourceRoomId, out var sourceRoomGuid)
            && Guid.TryParse(userId, out var userGuid))
        {
            HandleParticipantDragStart(sourceRoomGuid, userGuid);
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnRoomParticipantDrop(string targetRoomId)
    {
        if (!Guid.TryParse(targetRoomId, out var targetRoomGuid))
        {
            HandleParticipantDragEnd();
            return;
        }

        await HandleRoomDropAsync(targetRoomGuid);
    }

    [JSInvokable]
    public Task OnRoomParticipantDragEnd()
    {
        HandleParticipantDragEnd();
        return Task.CompletedTask;
    }

    private void HandleRoomDragOver(Guid roomId)
    {
        if (!CanDropDraggedParticipantIntoRoom(roomId))
        {
            return;
        }

        if (_dragOverRoomId != roomId)
        {
            _dragOverRoomId = roomId;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void HandleRoomDragEnter(Guid roomId)
    {
        if (CanDropDraggedParticipantIntoRoom(roomId) && _dragOverRoomId != roomId)
        {
            _dragOverRoomId = roomId;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void HandleRoomDragLeave(Guid roomId)
    {
        if (_dragOverRoomId == roomId)
        {
            _dragOverRoomId = null;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleRoomDropAsync(Guid targetRoomId)
    {
        if (!CanDropDraggedParticipantIntoRoom(targetRoomId)
            || _draggedParticipantSourceRoomId is not Guid sourceRoomId
            || _draggedParticipantUserId is not Guid userId)
        {
            HandleParticipantDragEnd();
            return;
        }

        _dragOverRoomId = null;
        _draggedParticipantSourceRoomId = null;
        _draggedParticipantUserId = null;
        await MoveUserBetweenRoomsAsync(sourceRoomId, targetRoomId, userId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task KickUserFromRoomCallAsync(Guid roomId, Guid userId)
    {
        if (roomId == Guid.Empty || !CanModerateRoomParticipant(userId))
        {
            return;
        }

        try
        {
            await Chat.KickUserFromVoiceVideoAsync(roomId, userId, "Kicked from call by moderator");
            await RefreshRoomCallParticipantsSnapshotAsync();
            Snackbar.Add("User removed from call.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to kick user from call: {ex.Message}", Severity.Error);
        }
    }

    private async Task MoveUserBetweenRoomsAsync(Guid sourceRoomId, Guid targetRoomId, Guid userId)
    {
        if (sourceRoomId == Guid.Empty || targetRoomId == Guid.Empty || sourceRoomId == targetRoomId || !CanMoveRoomParticipant(userId))
        {
            return;
        }

        try
        {
            await Chat.MoveUserAsync(sourceRoomId, targetRoomId, userId);

            if (userId == Auth.CurrentUser?.Id)
            {
                _drawerPendingSelectedRoomId = targetRoomId;
                await InvokeAsync(StateHasChanged);

                var keepPreviousRoomSubscription =
                    Call.IsInCall
                    && Call.ActiveCallKind == CallContextKind.Room
                    && Call.ActiveRoomId == sourceRoomId;

                await Rooms.SelectRoomAsync(targetRoomId, keepPreviousRoomSubscription);

                var targetRoute = $"/?roomId={targetRoomId:D}";
                var uri = Nav.ToAbsoluteUri(Nav.Uri);
                var currentRoute = uri.PathAndQuery;
                if (!currentRoute.Equals(targetRoute, StringComparison.OrdinalIgnoreCase))
                {
                    Nav.NavigateTo(targetRoute, replace: true);
                }
            }

            await Rooms.LoadRoomsAsync();
            await RefreshRoomCallParticipantsSnapshotAsync();
            Snackbar.Add("User moved to another room.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to move user: {ex.Message}", Severity.Error);
        }
    }

    private async Task SetUserRoleFromDrawerAsync(Guid roomId, Guid userId, UserRole role)
    {
        if (roomId == Guid.Empty || !CanManageRolesForParticipant(userId) || role >= Rooms.CurrentUserRole || role == UserRole.Owner)
        {
            return;
        }

        try
        {
            await Chat.SetUserRoleAsync(roomId, userId, role);
            await Rooms.LoadServerMembersAsync();
            Snackbar.Add($"Role changed to {role}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to change role: {ex.Message}", Severity.Error);
        }
    }

    private void StartRoomCallParticipantsSyncLoop()
    {
        if (_roomCallParticipantsSyncCts != null)
        {
            return;
        }

        if (!Auth.IsAuthenticated || !Chat.IsConnected)
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _roomCallParticipantsSyncCts = cts;
        _ = RunRoomCallParticipantsSyncLoopAsync(cts.Token);
    }

    private void StopRoomCallParticipantsSyncLoop()
    {
        if (_roomCallParticipantsSyncCts == null)
        {
            return;
        }

        try
        {
            _roomCallParticipantsSyncCts.Cancel();
        }
        catch
        {
            // Ignore cancellation races during shutdown/reconnect.
        }
        finally
        {
            _roomCallParticipantsSyncCts.Dispose();
            _roomCallParticipantsSyncCts = null;
        }
    }

    private async Task RunRoomCallParticipantsSyncLoopAsync(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            if (await IsAppVisibleAsync())
            {
                await RefreshRoomCallParticipantsSnapshotAsync();
            }

            try
            {
                await Task.Delay(RoomCallParticipantsSyncInterval, token);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    private async Task<bool> IsAppVisibleAsync()
    {
        try
        {
            return await JS.InvokeAsync<bool>("webrtcManager.isAppVisible");
        }
        catch
        {
            // WebView navigating or torn down — assume visible rather than stall the sync.
            return true;
        }
    }

    private async Task RefreshRoomCallParticipantsSnapshotAsync()
    {
        if (!Auth.IsAuthenticated || !Chat.IsConnected || _roomCallParticipantsSyncInFlight)
        {
            return;
        }

        _roomCallParticipantsSyncInFlight = true;
        try
        {
            var snapshots = await Api.GetRoomCallParticipantsAsync();
            Call.ApplyRoomParticipantSnapshot(snapshots);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Room call participant snapshot refresh failed: {ex.Message}");
        }
        finally
        {
            _roomCallParticipantsSyncInFlight = false;
        }
    }

    private static bool TryGetQueryGuid(string? query, string key, out Guid value)
    {
        value = Guid.Empty;
        if (string.IsNullOrWhiteSpace(query)) return false;

        var trimmed = query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(trimmed)) return false;

        foreach (var pair in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=');
            var rawKey = separator >= 0 ? pair[..separator] : pair;
            if (!rawKey.Equals(key, StringComparison.OrdinalIgnoreCase))
                continue;

            var rawValue = separator >= 0 ? pair[(separator + 1)..] : string.Empty;
            var decoded = Uri.UnescapeDataString(rawValue);
            return Guid.TryParse(decoded, out value);
        }

        return false;
    }

    private static string GetRoomIcon(ChatRoomInfo room)
    {
        if (room.IsVideoEnabled) return Icons.Material.Filled.Videocam;
        if (room.IsVoiceEnabled) return Icons.Material.Filled.Mic;
        return Icons.Material.Filled.Tag;
    }

    private string? GetAvatarUrl(string? avatarUrl)
    {
        if (string.IsNullOrWhiteSpace(avatarUrl))
            return null;

        return Api.ToAbsoluteUrl(avatarUrl);
    }

    private static string GetAvatarInitial(string? displayName, string? userName = null)
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            if (!string.IsNullOrWhiteSpace(userName))
            {
                return userName.Trim()[0].ToString().ToUpperInvariant();
            }

            return "?";
        }
        return displayName.Trim()[0].ToString().ToUpperInvariant();
    }

    public void Dispose()
    {
        CloseParticipantActions();
        StopRoomCallParticipantsSyncLoop();
        try
        {
            _ = JS.InvokeVoidAsync("roomParticipantDrag.unbindBlazor");
        }
        catch
        {
            // Ignore interop disposal races during app shutdown.
        }
        _roomParticipantDragDotNetRef?.Dispose();
        _roomParticipantDragDotNetRef = null;
        _roomParticipantDragBound = false;
        Auth.OnAuthStateChanged -= OnAuthChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Chat.OnConnectionStateChanged -= OnConnectionChanged;
        Chat.OnMessageReceived -= OnIncomingRoomMessage;
        Chat.OnPrivateMessageReceived -= OnIncomingPrivateMessage;
        Chat.OnPrivateCallIncoming -= OnIncomingPrivateCall;
        Call.OnChange -= OnCallChanged;
        Rooms.OnChange -= OnRoomsChanged;
        DirectMessages.OnChange -= OnDirectMessagesChanged;
        MembersPanel.OnChange -= OnMembersPanelChanged;
        Updater.OnUpdateAvailable -= OnUpdateAvailable;
        Updater.OnStateChanged -= OnUpdaterStateChanged;
        NotificationNavigationBridge.NavigateRequested -= OnNotificationNavigateRequested;
    }
}
