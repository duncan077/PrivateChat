@page "/dm"
@implements IDisposable
@inject DirectMessageStore Store
@inject AuthStateProvider Auth

<div class="dm-page">
    @* ─── Left: Contacts list ─── *@
    <div class="dm-sidebar">
        <MudStack Row AlignItems="AlignItems.Center" Class="pa-3">
            <MudText Typo="Typo.subtitle1" Style="font-weight:600">Messages</MudText>
        </MudStack>

        @if (Store.Contacts.Length == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-3">No conversations yet</MudText>
        }

        <MudList T="Guid" Dense="true">
            @foreach (var contact in Store.Contacts)
            {
                <MudListItem T="Guid" Value="contact.Id"
                             OnClick="() => SelectContact(contact)"
                             Class="@(contact.Id == Store.SelectedContactId ? "mud-selected-item" : "")">
                    <div class="contact-entry">
                        <MudAvatar Size="Size.Small" Color="Color.Secondary">
                            @contact.DisplayName[0]
                        </MudAvatar>
                        <div class="ml-2">
                            <MudText Typo="Typo.body2" Style="font-weight:500">@contact.DisplayName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@@@contact.UserName</MudText>
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    </div>

    @* ─── Right: Chat area ─── *@
    <div class="dm-main">
        @if (Store.SelectedContact != null)
        {
            <div class="chat-toolbar">
                <MudStack Row AlignItems="AlignItems.Center" Class="pa-2 px-3" Style="width:100%">
                    <MudAvatar Size="Size.Small" Color="Color.Secondary">
                        @Store.SelectedContact.DisplayName[0]
                    </MudAvatar>
                    <div class="ml-2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600">@Store.SelectedContact.DisplayName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@@@Store.SelectedContact.UserName</MudText>
                    </div>
                </MudStack>
            </div>

            <div class="chat-messages-area">
                @foreach (var msg in Store.Messages)
                {
                    var isOwn = msg.SenderId == Auth.CurrentUser?.Id;
                    <div class="chat-msg @(isOwn ? "own" : "")">
                        <div class="chat-msg-header">
                            <MudText Typo="Typo.caption" Style="font-weight:600;color:var(--mud-palette-primary)">
                                @msg.SenderName
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @msg.SentAt.ToLocalTime().ToString("HH:mm")
                            </MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="chat-msg-body">@msg.Content</MudText>
                        @if (msg.Attachments.Length > 0)
                        {
                            <div class="chat-msg-attachments">
                                @foreach (var att in msg.Attachments)
                                {
                                    <MudLink Href="@att.Url" Target="_blank" Typo="Typo.caption">@att.FileName</MudLink>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="chat-input-area">
                <MudTextField @bind-Value="_messageText" Placeholder="Type a message..."
                              Variant="Variant.Outlined" Immediate="true" Dense="true"
                              OnKeyDown="HandleKeyDown"
                              Adornment="Adornment.End"
                              AdornmentIcon="Icons.Material.Filled.Send"
                              AdornmentColor="Color.Primary"
                              OnAdornmentClick="SendMessage"
                              Class="chat-input-field" />
            </div>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fill-parent">
                <MudIcon Icon="Icons.Material.Filled.Email" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">Select a contact to start messaging</MudText>
            </MudStack>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Store.Error))
{
    <MudSnackbar Severity="Severity.Error" Visible="true">@Store.Error</MudSnackbar>
}

@code {
    private string _messageText = "";

    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += OnStoreChanged;
        await Store.LoadContactsAsync();
    }

    private async Task SelectContact(UserInfo contact) => await Store.SelectContactAsync(contact);

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText)) return;
        var text = _messageText;
        _messageText = "";
        await Store.SendMessageAsync(text);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Store.OnChange -= OnStoreChanged;
    }
}
