    private async Task HandleAttachmentSelected(InputFileChangeEventArgs e)
    {
        _attachmentDragDepth = 0;
        _isAttachmentDragActive = false;
        _uploadError = null;
        _uploading = true;
        StateHasChanged();

        try
        {
            foreach (var file in e.GetMultipleFiles())
            {
                if (file.Size > MaxUploadBytes)
                {
                    _uploadError = $"'{file.Name}' is larger than 50 MB.";
                    StateHasChanged();
                    continue;
                }

                try
                {
                    await using var stream = file.OpenReadStream(MaxUploadBytes);
                    var attachment = await Api.UploadFileAsync(stream, file.Name, file.ContentType, file.Size);
                    _pendingAttachments.Add(attachment);
                    StateHasChanged();
                }
                catch (Exception fileEx)
                {
                    _uploadError = $"Failed to upload '{file.Name}': {fileEx.Message}";
                    System.Diagnostics.Debug.WriteLine($"[DirectMessages] Upload failed for {file.Name}: {fileEx}");
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            _uploadError = $"Attachment error: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"[DirectMessages] Attachment selection failed: {ex}");
        }
        finally
        {
            _uploading = false;
            _attachmentDragDepth = 0;
            _isAttachmentDragActive = false;
            StateHasChanged();
        }
    }

    private void RemovePendingAttachment(Guid attachmentId)
    {
        _pendingAttachments.RemoveAll(a => a.Id == attachmentId);
    }

    private async Task TryOpenRequestedConversationAsync()
    {
        if (RequestedUserId == null || RequestedUserId == Guid.Empty) return;
        if (RequestedUserId == Auth.CurrentUser?.Id) return;

        var targetUserId = RequestedUserId.Value;
        if (_lastAutoOpenedUserId == targetUserId && Store.SelectedContactId == targetUserId) return;

        var requestedContact = Store.Contacts.FirstOrDefault(c => c.Id == targetUserId) ?? BuildRequestedContact(targetUserId);
        await Store.OpenConversationAsync(requestedContact);
        _lastAutoOpenedUserId = targetUserId;
        _forceScrollToBottom = true;
        _lastRenderedMessageCount = -1;
        _lastRenderedContactId = null;

        if (!ShouldAutoJoinRequestedCall(targetUserId))
        {
            return;
        }

        await JoinPrivateCall();
        _lastAutoJoinCallToken = BuildAutoJoinCallToken(targetUserId);
    }

    private UserInfo BuildRequestedContact(Guid userId)
    {
        var fallbackUserName = $"user_{userId.ToString()[..8]}";
        var userName = string.IsNullOrWhiteSpace(RequestedUserName) ? fallbackUserName : RequestedUserName.Trim();
        var displayName = string.IsNullOrWhiteSpace(RequestedDisplayName) ? userName : RequestedDisplayName.Trim();

        return new UserInfo
        {
            Id = userId,
            UserName = userName,
            DisplayName = displayName,
            IsOnline = false
        };
    }

    private bool ShouldAutoJoinRequestedCall(Guid targetUserId)
    {
        if (targetUserId == Guid.Empty)
        {
            return false;
        }

        if (!IsTruthyQueryFlag(RequestedJoinCall))
        {
            return false;
        }

        if (Call.IsActiveDirectCallWith(targetUserId))
        {
            return false;
        }

        var token = BuildAutoJoinCallToken(targetUserId);
        if (!string.IsNullOrWhiteSpace(token) && string.Equals(_lastAutoJoinCallToken, token, StringComparison.Ordinal))
        {
            return false;
        }

        return true;
    }

    private string BuildAutoJoinCallToken(Guid targetUserId)
    {
        var nonce = string.IsNullOrWhiteSpace(RequestedCallNonce) ? "none" : RequestedCallNonce.Trim();
        var joinFlag = string.IsNullOrWhiteSpace(RequestedJoinCall) ? "none" : RequestedJoinCall.Trim();
        return $"{targetUserId:D}|{joinFlag}|{nonce}";
    }

    private static bool IsTruthyQueryFlag(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        return value.Trim().ToLowerInvariant() switch
        {
            "1" => true,
            "true" => true,
            "yes" => true,
            "y" => true,
            "on" => true,
            _ => false
        };
    }

    private void QueueVisibleLinkPreviewLoads()
    {
        foreach (var message in _virtualMessages?.VisibleItems ?? [])
        {
            var url = ExtractFirstHttpUrl(message.Content);
            if (string.IsNullOrWhiteSpace(url)) continue;
            if (_linkPreviewCache.ContainsKey(url) || _linkPreviewInFlight.Contains(url)) continue;

            _linkPreviewInFlight.Add(url);
            _ = LoadLinkPreviewAsync(url);
        }
    }

    private async Task LoadLinkPreviewAsync(string url)
    {
        try
        {
            var preview = await Api.GetLinkPreviewAsync(url);
            _linkPreviewCache[url] = preview;
            TrimLinkPreviewCacheIfNeeded();
        }
        catch
        {
            _linkPreviewCache[url] = null;
        }
        finally
        {
            _linkPreviewInFlight.Remove(url);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void TrimLinkPreviewCacheIfNeeded()
    {
        if (_linkPreviewCache.Count <= MaxLinkPreviewCacheEntries) return;

        var toRemove = _linkPreviewCache.Count - MaxLinkPreviewCacheEntries;
        foreach (var key in _linkPreviewCache.Keys.Take(toRemove).ToArray())
        {
            _linkPreviewCache.Remove(key);
            _linkPreviewInFlight.Remove(key);
        }
    }

    private LinkPreviewInfo? GetCachedLinkPreview(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        _linkPreviewCache.TryGetValue(url, out var preview);
        return preview;
    }

    private static string? ExtractFirstHttpUrl(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;

        var match = UrlRegex.Match(text);
        if (!match.Success) return null;

        var raw = match.Value.Trim();
        raw = raw.TrimEnd('.', ',', ';', ':', '!', '?', ')', ']', '}', '"', '\'');
        if (!Uri.TryCreate(raw, UriKind.Absolute, out var uri)) return null;
        if (!string.Equals(uri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
            && !string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return uri.ToString();
    }

    private static string GetPreviewTitle(LinkPreviewInfo preview, string href)
    {
        if (!string.IsNullOrWhiteSpace(preview.Title))
        {
            return preview.Title!;
        }

        return FormatPreviewUrl(href);
    }

    private static string FormatPreviewUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            return url.Length > 72 ? url[..72] + "..." : url;
        }

        var host = uri.Host;
        var path = uri.AbsolutePath == "/" ? string.Empty : uri.AbsolutePath;
        var compact = $"{host}{path}";
        if (compact.Length > 72)
        {
            compact = compact[..72] + "...";
        }

        return compact;
    }

    private static string GetAttachmentUrl(AttachmentInfo? attachment)
        => attachment?.Url?.Trim() ?? string.Empty;

    private static string GetAttachmentLabel(AttachmentInfo? attachment)
        => string.IsNullOrWhiteSpace(attachment?.FileName) ? "attachment" : attachment.FileName;

    private static bool IsImageAttachment(AttachmentInfo? attachment)
    {
        var contentType = attachment?.ContentType?.Trim() ?? string.Empty;
        if (contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var ext = GetAttachmentExtension(attachment);
        return ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp" or ".svg";
    }

    private static bool IsVideoAttachment(AttachmentInfo? attachment)
    {
        var contentType = attachment?.ContentType?.Trim() ?? string.Empty;
        if (contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var ext = GetAttachmentExtension(attachment);
        return ext is ".mp4" or ".webm" or ".mov" or ".m4v" or ".ogv" or ".avi" or ".mkv";
    }

    private static string ResolveVideoMime(AttachmentInfo? attachment)
    {
        var contentType = attachment?.ContentType?.Trim() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(contentType))
        {
            return contentType;
        }

        return GetAttachmentExtension(attachment) switch
        {
            ".webm" => "video/webm",
            ".mov" => "video/quicktime",
            ".ogv" => "video/ogg",
            ".m4v" => "video/mp4",
            _ => "video/mp4"
        };
    }

    private static string GetAttachmentExtension(AttachmentInfo? attachment)
    {
        var candidate = !string.IsNullOrWhiteSpace(attachment?.FileName)
            ? attachment.FileName
            : attachment?.Url ?? string.Empty;

        if (string.IsNullOrWhiteSpace(candidate))
        {
            return string.Empty;
        }

        if (Uri.TryCreate(candidate, UriKind.Absolute, out var uri))
        {
            candidate = uri.AbsolutePath;
        }

        var queryIndex = candidate.IndexOf('?');
        if (queryIndex >= 0)
        {
            candidate = candidate[..queryIndex];
        }

        var hashIndex = candidate.IndexOf('#');
        if (hashIndex >= 0)
        {
            candidate = candidate[..hashIndex];
        }

        return (System.IO.Path.GetExtension(candidate) ?? string.Empty).ToLowerInvariant();
    }

    private string? GetAvatarUrl(string? avatarUrl)
    {
        if (string.IsNullOrWhiteSpace(avatarUrl))
        {
            return null;
        }

        return Api.ToAbsoluteUrl(avatarUrl);
    }

    private static string GetAvatarInitial(string? displayName, string? userName)
    {
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            return displayName.Trim()[0].ToString().ToUpperInvariant();
        }

        if (!string.IsNullOrWhiteSpace(userName))
        {
            return userName.Trim()[0].ToString().ToUpperInvariant();
        }

        return "?";
    }

    private Dictionary<string, string> BuildParticipantDirectory()
    {
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var contact in Store.Contacts)
        {
            if (contact.Id == Guid.Empty) continue;
            var name = !string.IsNullOrWhiteSpace(contact.DisplayName)
                ? contact.DisplayName.Trim()
                : contact.UserName?.Trim();
            if (string.IsNullOrWhiteSpace(name)) continue;
            map[contact.Id.ToString()] = name;
        }

        if (Auth.CurrentUser != null)
        {
            var selfName = !string.IsNullOrWhiteSpace(Auth.CurrentUser.DisplayName)
                ? Auth.CurrentUser.DisplayName.Trim()
                : Auth.CurrentUser.UserName?.Trim();
            if (!string.IsNullOrWhiteSpace(selfName))
            {
                map[Auth.CurrentUser.Id.ToString()] = selfName;
            }
        }

        return map;
    }

    private Dictionary<string, string> BuildParticipantAvatarDirectory()
    {
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var contact in Store.Contacts)
        {
            if (contact.Id == Guid.Empty || string.IsNullOrWhiteSpace(contact.AvatarUrl))
            {
                continue;
            }

            map[contact.Id.ToString()] = Api.ToAbsoluteUrl(contact.AvatarUrl);
        }

        if (Auth.CurrentUser != null && !string.IsNullOrWhiteSpace(Auth.CurrentUser.AvatarUrl))
        {
            map[Auth.CurrentUser.Id.ToString()] = Api.ToAbsoluteUrl(Auth.CurrentUser.AvatarUrl);
        }

        return map;
    }

    private void OnStoreChanged()
    {
        _ = SyncParticipantProfilesAsync();
        InvokeAsync(StateHasChanged);
    }

    private void OnCallChanged()
    {
        _ = SyncParticipantProfilesAsync();
        InvokeAsync(StateHasChanged);
    }

    private async Task SyncParticipantProfilesAsync()
    {
        if (!IsCallActiveForSelectedContact || Store.SelectedContactId == null)
        {
            return;
        }

        try
        {
            await WebRtc.UpdateParticipantProfilesAsync(
                BuildParticipantDirectory(),
                BuildParticipantAvatarDirectory());
        }
        catch
        {
            // Ignore transient JS interop errors during rerenders/navigation.
        }
    }

    public void Dispose()
    {
        try
        {
            _ = JS.InvokeVoidAsync("chatAttachmentPaste.dispose");
        }
        catch
        {
            // Ignore JS interop failures during teardown/navigation.
        }
        Store.OnChange -= OnStoreChanged;
        Call.OnChange -= OnCallChanged;
    }
