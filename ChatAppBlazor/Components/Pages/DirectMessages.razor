@page "/dm"
@implements IDisposable
@inject DirectMessageStore Store
@inject AuthStateProvider Auth
@inject ApiClientService Api
@inject IJSRuntime JS
@inject CallStore Call
@inject WebRtcBridge WebRtc
@inject MarkdownRenderService Md
@inject IDialogService Dialogs
@inject NavigationManager Nav

<div class="dm-page">


    @* ─── Right: Chat area ─── *@
    <div class="dm-main">
        @if (Store.SelectedContact != null)
        {
            <div class="chat-toolbar">
                <div class="chat-toolbar-content">
                    <div class="chat-toolbar-title-wrap">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            @{
                                var selectedAvatarUrl = GetAvatarUrl(Store.SelectedContact.AvatarUrl);
                            }
                            <MudAvatar Size="Size.Small" Color="Color.Secondary">
                                @if (!string.IsNullOrWhiteSpace(selectedAvatarUrl))
                                {
                                    <img src="@selectedAvatarUrl" alt="Profile" class="avatar-image-fill" />
                                }
                                else
                                {
                                    @GetAvatarInitial(Store.SelectedContact.DisplayName, Store.SelectedContact.UserName)
                                }
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:600">@Store.SelectedContact.DisplayName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@@@Store.SelectedContact.UserName</MudText>
                            </div>
                        </MudStack>
                    </div>
                    <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1" Class="chat-toolbar-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Search"
                                       Size="Size.Small"
                                       title="Search messages"
                                       OnClick="OpenSearch" />
                        <MudIconButton Icon="@(Store.IsSelectedContactNotificationsMuted ? Icons.Material.Filled.NotificationsOff : Icons.Material.Filled.NotificationsActive)"
                                       Size="Size.Small"
                                       Color="@(Store.IsSelectedContactNotificationsMuted ? Color.Warning : Color.Default)"
                                       title="@(Store.IsSelectedContactNotificationsMuted ? "Unmute chat notifications" : "Mute chat notifications")"
                                       OnClick="ToggleSelectedContactNotifications" />
                        @if (_joiningCall)
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.HourglassTop" Size="Size.Small"
                                       Variant="Variant.Filled" Color="Color.Warning"
                                       Disabled="true">Joining...</MudButton>
                        }
                        else if (IsCallActiveForSelectedContact)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">In Call</MudChip>
                        }
                        else
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Call" Size="Size.Small"
                                       Variant="Variant.Filled" Color="Color.Success"
                                       OnClick="JoinPrivateCall">Join Call</MudButton>
                        }
                    </MudStack>
                </div>
            </div>

            @if (IsCallActiveForSelectedContact && Call.ActiveRoomId is Guid activeContextId && activeContextId != Guid.Empty)
            {
                <div class="call-panel-host">
                    <ActiveCallPanel RoomId="activeContextId" RoomName="@(Store.SelectedContact?.DisplayName ?? string.Empty)" />
                </div>
            }

            <div class="chat-messages-host">
                <div class="chat-messages-area" @ref="_messagesContainerRef">
                    @if (Store.HasMoreHistory && Store.Messages.Count > 0)
                    {
                        <div class="chat-load-older">
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       Disabled="Store.IsLoadingOlder"
                                       OnClick="LoadOlderMessages">
                                @(Store.IsLoadingOlder ? "Loading..." : "Load older messages")
                            </MudButton>
                        </div>
                    }
                    <VirtualMessageList TItem="PrivateMessage" Items="Store.Messages" ItemKey="m => m.Id"
                                            Context="msg" @ref="_virtualMessages" @key="Store.SelectedContactId" WindowChanged="HandleMessageWindowChanged">
                            @{
                                var isOwn = msg.SenderId == Auth.CurrentUser?.Id;
                                var isEditing = _editingMessageId == msg.Id;
                            }
                            <div class="chat-msg @(isOwn ? "own" : "") @(msg.IsDeleted ? "deleted" : "")" @key="msg.Id" id="@($"msg-{msg.Id}")">
                            <div class="chat-msg-header">
                                <MudText Typo="Typo.caption" Style="font-weight:600;color:var(--mud-palette-primary)">
                                    @msg.SenderName
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @msg.SentAt.ToLocalTime().ToString("HH:mm")
                                </MudText>
                                @if (isOwn && msg.IsRead && !msg.IsDeleted)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small"
                                             Class="chat-msg-read-tick" title="Read" />
                                }
                                @if (msg.EditedAt != null && !msg.IsDeleted)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                             title="@($"Edited {msg.EditedAt.Value.ToLocalTime():g}")">(edited)</MudText>
                                }
                                @if (!msg.IsDeleted && !isEditing)
                                {
                                    <div class="chat-msg-actions">
                                        <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Small"
                                                       OnClick="() => BeginReply(msg)"
                                                       Style="padding:2px" title="Reply" />
                                        @if (isOwn)
                                        {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       OnClick="() => BeginEditMessage(msg)"
                                                       Style="padding:2px" title="Edit" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       Color="Color.Error" OnClick="() => DeleteMessage(msg.Id)"
                                                       Style="padding:2px" title="Delete" />
                                        }
                                    </div>
                                }
                            </div>
                            @if (isEditing)
                            {
                                <div class="chat-msg-edit" id="dmEditHost">
                                    <MudTextField @bind-Value="_editText" Immediate="true"
                                                  Variant="Variant.Outlined"
                                                  Lines="1" MaxLines="8" Sizing="InputSizing.Auto"
                                                  OnKeyDown="HandleEditKeyDown"
                                                  Class="chat-input-field" />
                                    <div class="chat-msg-edit-actions">
                                        <MudButton Size="Size.Small" OnClick="CancelEditMessage">Cancel</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                   Disabled="@string.IsNullOrWhiteSpace(_editText)"
                                                   OnClick="SubmitEditMessage">Save</MudButton>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Enter to save · Esc to cancel</MudText>
                                </div>
                            }
                            else if (msg.IsDeleted)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-style:italic">
                                    Message deleted
                                </MudText>
                            }
                            else
                            {
                            @if (msg.ReplyPreview is { } quote)
                            {
                                <div class="chat-msg-quote @(quote.IsUnavailable ? "unavailable" : string.Empty)">
                                    @if (quote.IsUnavailable)
                                    {
                                        <span class="chat-msg-quote-text">Message unavailable</span>
                                    }
                                    else
                                    {
                                        <span class="chat-msg-quote-author">@quote.SenderName</span>
                                        <span class="chat-msg-quote-text">@quote.Snippet</span>
                                    }
                                </div>
                            }
                            <div class="chat-msg-body">@Md.Render(msg.Id, msg.Content)</div>
                            var previewUrl = ExtractFirstHttpUrl(msg.Content);
                            var preview = GetCachedLinkPreview(previewUrl);
                            @if (preview != null && !string.IsNullOrWhiteSpace(preview.Url))
                            {
                                var href = !string.IsNullOrWhiteSpace(preview.CanonicalUrl) ? preview.CanonicalUrl : preview.Url;
                                <a class="chat-link-preview" href="@href" target="_blank" rel="noopener noreferrer">
                                    @if (!string.IsNullOrWhiteSpace(preview.ImageUrl))
                                    {
                                        <img class="chat-link-preview-image" src="@preview.ImageUrl" alt="Link preview image" loading="lazy" />
                                    }
                                    <div class="chat-link-preview-content">
                                        @if (!string.IsNullOrWhiteSpace(preview.SiteName))
                                        {
                                            <span class="chat-link-preview-site">@preview.SiteName</span>
                                        }
                                        <span class="chat-link-preview-title">@GetPreviewTitle(preview, href)</span>
                                        @if (!string.IsNullOrWhiteSpace(preview.Description))
                                        {
                                            <span class="chat-link-preview-description">@preview.Description</span>
                                        }
                                        <span class="chat-link-preview-url">@FormatPreviewUrl(href)</span>
                                    </div>
                                </a>
                            }
                            @if (msg.Attachments.Length > 0)
                            {
                                <div class="chat-msg-attachments">
                                    @foreach (var att in msg.Attachments)
                                    {
                                        var attachmentUrl = GetAttachmentUrl(att);
                                        if (string.IsNullOrWhiteSpace(attachmentUrl))
                                        {
                                            <MudText Typo="Typo.caption">@GetAttachmentLabel(att)</MudText>
                                        }
                                        else if (IsImageAttachment(att))
                                        {
                                            <a class="chat-attachment-link" href="@attachmentUrl" target="_blank" rel="noopener noreferrer">
                                                <img class="chat-attachment-image"
                                                     src="@attachmentUrl"
                                                     alt="@GetAttachmentLabel(att)"
                                                     loading="lazy" />
                                            </a>
                                        }
                                        else if (IsVideoAttachment(att))
                                        {
                                            <video class="chat-attachment-video"
                                                   controls
                                                   preload="metadata"
                                                   onloadedmetadata="window.webrtcManager?.applyAttachmentVideoVolume(this)"
                                                   onplay="window.webrtcManager?.applyAttachmentVideoVolume(this)"
                                                   onvolumechange="window.webrtcManager?.rememberAttachmentVideoVolume(this)">
                                                <source src="@attachmentUrl" type="@ResolveVideoMime(att)" />
                                                Your browser does not support inline video playback.
                                            </video>
                                            <a class="chat-attachment-link chat-attachment-filename" href="@attachmentUrl" target="_blank" rel="noopener noreferrer">
                                                @GetAttachmentLabel(att)
                                            </a>
                                        }
                                        else
                                        {
                                            <MudLink Href="@attachmentUrl" Target="_blank" Typo="Typo.caption">@GetAttachmentLabel(att)</MudLink>
                                        }
                                    }
                                </div>
                            }

                            <ReactionBar Reactions="msg.Reactions"
                                         CurrentUserId="Auth.CurrentUser?.Id"
                                         ResolveUserName="ResolveParticipantName"
                                         Toggle="emoji => Store.ToggleReactionAsync(msg.Id, emoji)" />
                            }
                        </div>
                    </VirtualMessageList>
                </div>
                <button type="button"
                        class="chat-jump-latest-button"
                        title="Jump to latest"
                        @ref="_jumpLatestButtonRef"
                        @onclick="JumpToLatestAsync">
                    Latest
                </button>
            </div>

            <div id="dmAttachmentDropZone"
                 class="chat-input-area @(_isAttachmentDragActive ? "drag-over" : "")"
                 @ondragenter="OnAttachmentDragEnter"
                 @ondragenter:preventDefault
                 @ondragover="OnAttachmentDragOver"
                 @ondragover:preventDefault
                 @ondragleave="OnAttachmentDragLeave"
                 @ondragleave:preventDefault
                 @ondrop="OnAttachmentDrop"
                 @ondrop:preventDefault>
                @if (_pendingAttachments.Count > 0)
                {
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                        @foreach (var attachment in _pendingAttachments)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="pending-attachment-pill">
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                                    @attachment.FileName
                                </MudChip>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               Color="Color.Default" OnClick="() => RemovePendingAttachment(attachment.Id)" />
                            </MudStack>
                        }
                    </MudStack>
                }

                @if (!string.IsNullOrWhiteSpace(_uploadError))
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-2">@_uploadError</MudText>
                }

                @if (Store.TypingSummary is { } typingSummary)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="chat-typing-indicator">@typingSummary</MudText>
                }

                @if (_replyTo != null)
                {
                    <div class="chat-reply-banner">
                        <MudIcon Icon="@Icons.Material.Filled.Reply" Size="Size.Small" />
                        <span class="chat-reply-banner-text">
                            Replying to <b>@_replyTo.SenderName</b> — @ReplySnippet(_replyTo.Content)
                        </span>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="CancelReply" Style="padding:2px" title="Cancel reply" />
                    </div>
                }

                <div class="chat-composer">
                    <ComposerToolbar HostId="dmComposerHost"
                                     Disabled="_uploading"
                                     PreviewActive="_composerPreview"
                                     PreviewActiveChanged="v => _composerPreview = v"
                                     Expanded="_composerExpanded"
                                     ExpandedChanged="v => _composerExpanded = v"
                                     OnOpenStickers="OpenStickerPicker" />

                    @if (_composerPreview)
                    {
                        <div class="chat-composer-preview chat-msg-body @(_composerExpanded ? "expanded" : string.Empty)" @ref="_composerPreviewRef">
                            @if (string.IsNullOrWhiteSpace(_messageText))
                            {
                                <span class="chat-composer-preview-empty">Nothing to preview yet.</span>
                            }
                            else
                            {
                                @Md.Render(_composerPreviewId, _messageText)
                            }
                        </div>
                    }
                    else
                    {
                        <div class="chat-input-mention-host" id="dmComposerHost">
                            <MudTextField @bind-Value="_messageText" @bind-Value:after="OnMessageTextEdited"
                                          Placeholder="Type a message..."
                                          Variant="Variant.Text" Underline="false" Immediate="true"
                                          Lines="1" MaxLines="@(_composerExpanded ? 18 : 8)" Sizing="InputSizing.Auto"
                                          OnKeyDown="HandleKeyDown"
                                          Class="chat-input-field chat-composer-field" />
                        </div>
                    }

                    <div class="chat-composer-bottom">
                        <div class="file-picker-wrapper">
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="file-picker-button"
                                       Disabled="_uploading"
                                       OnClick="TriggerFilePicker">
                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                                <span class="ml-1">@(_uploading ? "Uploading..." : "Attach")</span>
                            </MudButton>
                            <InputFile @ref="_fileInput" OnChange="HandleAttachmentSelected" multiple
                                       style="display:none" id="dmFileInput" />
                        </div>

                        <span class="chat-composer-hint">Enter to send · Shift+Enter for line break</span>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendMessage"
                                   Disabled="@(_uploading || (string.IsNullOrWhiteSpace(_messageText) && _pendingAttachments.Count == 0))">
                            Send
                        </MudButton>
                    </div>
                </div>

                <div class="chat-input-drop-overlay" aria-hidden="@(!_isAttachmentDragActive)">
                    <InputFile OnChange="HandleAttachmentSelected"
                               multiple
                               class="chat-input-drop-file-input" />
                    <div class="chat-input-drop-hint">Drop files to attach</div>
                </div>
            </div>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fill-parent chat-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">Select a contact to start messaging</MudText>
            </MudStack>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Store.Error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="dm-error-banner">@Store.Error</MudAlert>
}

@code {
    private string _messageText = "";
    private bool _uploading;
    private string? _uploadError;
    private readonly List<AttachmentInfo> _pendingAttachments = [];
    private const long MaxUploadBytes = 50L * 1024 * 1024;
    private InputFile? _fileInput;
    private bool _isAttachmentDragActive;
    private int _attachmentDragDepth;
    private bool _attachmentPasteInitialized;
    private Guid? _lastAutoOpenedUserId;
    private string? _lastAutoJoinCallToken;
    private bool _joiningCall;
    private ElementReference _messagesContainerRef;
    private ElementReference _jumpLatestButtonRef;
    private VirtualMessageList<PrivateMessage>? _virtualMessages;
    private bool _forceScrollToBottom;
    private int _lastRenderedMessageCount = -1;
    private int _lastRenderedMessagesVersion = -1;
    private Guid? _lastRenderedContactId;
    private Guid? _editingMessageId;
    private string _editText = string.Empty;
    private PrivateMessage? _replyTo;
    private bool _composerPreview;
    private bool _composerExpanded;
    private ElementReference _composerPreviewRef;
    // Stable id for the preview's render-cache slot; content changes re-render it.
    private readonly Guid _composerPreviewId = Guid.NewGuid();
    private static readonly System.Text.RegularExpressions.Regex UrlRegex = new(
        "(?i)\\bhttps?://[^\\s<>()]+",
        System.Text.RegularExpressions.RegexOptions.Compiled);
    private readonly Dictionary<string, LinkPreviewInfo?> _linkPreviewCache = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _linkPreviewInFlight = new(StringComparer.OrdinalIgnoreCase);
    private const int MaxLinkPreviewCacheEntries = 300;
    private bool IsCallActiveForSelectedContact
        => Store.SelectedContactId != null && Call.IsActiveDirectCallWith(Store.SelectedContactId.Value);

    [SupplyParameterFromQuery(Name = "userId")]
    public Guid? RequestedUserId { get; set; }

    [SupplyParameterFromQuery(Name = "userName")]
    public string? RequestedUserName { get; set; }

    [SupplyParameterFromQuery(Name = "displayName")]
    public string? RequestedDisplayName { get; set; }

    [SupplyParameterFromQuery(Name = "joinCall")]
    public string? RequestedJoinCall { get; set; }

    [SupplyParameterFromQuery(Name = "callNonce")]
    public string? RequestedCallNonce { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += OnStoreChanged;
        Call.OnChange += OnCallChanged;
        await Store.LoadContactsAsync();
        await TryOpenRequestedConversationAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await TryOpenRequestedConversationAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Store.SelectedContact == null)
            return;

        if (!_attachmentPasteInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("chatAttachmentPaste.init", "dmFileInput", "dmAttachmentDropZone");
                _attachmentPasteInitialized = true;
            }
            catch
            {
                // Ignore paste/drop hook initialization failures and keep chat usable.
            }
        }

        try
        {
            await JS.InvokeVoidAsync("chatScrollManager.init", _messagesContainerRef, _jumpLatestButtonRef, 20, 180);
            await JS.InvokeVoidAsync("chatInput.init", "dmComposerHost");
            if (_editingMessageId != null)
            {
                // The inline editor is a fresh textarea each time editing starts, so
                // it needs its own Enter-to-submit hook.
                await JS.InvokeVoidAsync("chatInput.init", "dmEditHost");
            }
            if (_composerPreview)
            {
                // Preview should look exactly like the sent message, highlighting
                // included. The data-hl guard makes repeat calls cheap.
                await JS.InvokeVoidAsync("chatCode.highlightNew", _composerPreviewRef);
            }

            var contactId = Store.SelectedContactId;
            var contactChanged = _lastRenderedContactId != contactId;
            var messageCount = Store.Messages.Count;
            // In-place mutations (edit, delete) leave the count untouched but change
            // message heights, so the version has to gate the scroll pass too.
            var messagesVersion = Store.MessagesVersion;
            var contentChanged = messageCount != _lastRenderedMessageCount ||
                                 messagesVersion != _lastRenderedMessagesVersion;
            var shouldForce = _forceScrollToBottom || contactChanged || firstRender || _lastRenderedMessageCount < 0;

            if (shouldForce || contentChanged)
            {
                await JS.InvokeVoidAsync("chatScrollManager.onMessagesChanged", _messagesContainerRef, shouldForce);
                await JS.InvokeVoidAsync("chatCode.highlightNew", _messagesContainerRef);
            }

            QueueVisibleLinkPreviewLoads();

            _lastRenderedContactId = contactId;
            _lastRenderedMessageCount = messageCount;
            _lastRenderedMessagesVersion = messagesVersion;
            _forceScrollToBottom = false;
        }
        catch
        {
            // Ignore transient JS interop failures during rerenders/navigation.
        }
    }

    private async Task SelectContact(UserInfo contact)
    {
        CancelEditMessage();
        CancelReply();
        _lastRenderedMessagesVersion = -1;
        await Store.SelectContactAsync(contact);
    }

    private async Task DeleteMessage(Guid messageId)
    {
        if (_editingMessageId == messageId)
        {
            CancelEditMessage();
        }

        await Store.DeleteMessageAsync(messageId);
    }

    /// <summary>A DM has exactly two participants, so no roster lookup is needed.</summary>
    private string ResolveParticipantName(Guid userId)
    {
        if (userId == Auth.CurrentUser?.Id) return "You";
        if (userId == Store.SelectedContact?.Id)
        {
            var contact = Store.SelectedContact;
            return string.IsNullOrWhiteSpace(contact.DisplayName) ? contact.UserName : contact.DisplayName;
        }

        return string.Empty;
    }

    private void BeginEditMessage(PrivateMessage msg)
    {
        _editingMessageId = msg.Id;
        _editText = msg.Content;
    }

    private void CancelEditMessage()
    {
        _editingMessageId = null;
        _editText = string.Empty;
    }

    private async Task SubmitEditMessage()
    {
        if (_editingMessageId == null || string.IsNullOrWhiteSpace(_editText)) return;

        if (await Store.EditMessageAsync(_editingMessageId.Value, _editText))
        {
            CancelEditMessage();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelEditMessage();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SubmitEditMessage();
        }
    }

    private async Task JoinPrivateCall()
    {
        if (Store.SelectedContactId == null || _joiningCall)
        {
            return;
        }

        _joiningCall = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var contactId = Store.SelectedContactId.Value;
            var session = await Call.JoinPrivateCallAsync(contactId);
            if (session == null)
            {
                return;
            }

            await WebRtc.InitAsync(
                session.JanusSessionId,
                session.JanusHandleId,
                session.JanusRoomId,
                session.ServerBaseUrl,
                Auth.Token!,
                Auth.CurrentUser!.Id.ToString(),
                !string.IsNullOrWhiteSpace(Auth.CurrentUser.DisplayName)
                    ? Auth.CurrentUser.DisplayName
                    : Auth.CurrentUser.UserName,
                BuildParticipantDirectory(),
                BuildParticipantAvatarDirectory(),
                session.IceServers);

            await WebRtc.ApplyStoredSettingsAsync();
            await WebRtc.UpdateParticipantProfilesAsync(
                BuildParticipantDirectory(),
                BuildParticipantAvatarDirectory());
            Call.SetUseFloatingOverlayInActiveRoom(false);
        }
        catch (Exception ex)
        {
            Call.SetError($"Failed to join private call: {ex.Message}");
        }
        finally
        {
            _joiningCall = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleSelectedContactNotifications()
    {
        if (Store.SelectedContactId == null) return;
        Store.ToggleContactNotificationsMuted(Store.SelectedContactId.Value);
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText) && _pendingAttachments.Count == 0) return;
        var text = _messageText;
        var attachments = _pendingAttachments.ToArray();
        _messageText = string.Empty;
        _pendingAttachments.Clear();
        _forceScrollToBottom = true;
        await InvokeAsync(StateHasChanged);
        // Sending returns you to writing mode; previewing an empty box is noise.
        _composerPreview = false;
        var replyTo = _replyTo;
        _replyTo = null;
        var sent = await Store.SendMessageAsync(text, attachments, replyTo?.Id);
        if (!sent)
        {
            // Failed sends surface Store.Error; put the user's text back instead of
            // losing it to the eager clear above.
            _messageText = text;
            _pendingAttachments.AddRange(attachments);
            _replyTo = replyTo;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Stickers send as an ordinary image attachment with no text.</summary>
    private async Task OpenStickerPicker()
    {
        var dialog = await Dialogs.ShowAsync<StickerPickerDialog>("Stickers",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CustomAssetInfo sticker) return;

        var attachment = new AttachmentInfo
        {
            Id = sticker.Id,
            FileName = $"{sticker.Name}.sticker",
            ContentType = GuessStickerContentType(sticker.Url),
            SizeBytes = 0,
            Url = sticker.Url
        };

        _forceScrollToBottom = true;
        await Store.SendMessageAsync(string.Empty, [attachment]);
        await InvokeAsync(StateHasChanged);
    }

    private static string GuessStickerContentType(string url) =>
