@page "/dm"
@implements IDisposable
@inject DirectMessageStore Store
@inject AuthStateProvider Auth
@inject ApiClientService Api
@inject IJSRuntime JS

<div class="dm-page">


    @* ─── Right: Chat area ─── *@
    <div class="dm-main">
        @if (Store.SelectedContact != null)
        {
            <div class="chat-toolbar">
                <div class="chat-toolbar-content">
                    <div class="chat-toolbar-title-wrap">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="Size.Small" Color="Color.Secondary">
                                @Store.SelectedContact.DisplayName[0]
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:600">@Store.SelectedContact.DisplayName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@@@Store.SelectedContact.UserName</MudText>
                            </div>
                        </MudStack>
                    </div>
                </div>
            </div>

            <div class="chat-messages-area">
                @foreach (var msg in Store.Messages)
                {
                    var isOwn = msg.SenderId == Auth.CurrentUser?.Id;
                    <div class="chat-msg @(isOwn ? "own" : "")">
                        <div class="chat-msg-header">
                            <MudText Typo="Typo.caption" Style="font-weight:600;color:var(--mud-palette-primary)">
                                @msg.SenderName
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @msg.SentAt.ToLocalTime().ToString("HH:mm")
                            </MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="chat-msg-body">@msg.Content</MudText>
                        @if (msg.Attachments.Length > 0)
                        {
                            <div class="chat-msg-attachments">
                                @foreach (var att in msg.Attachments)
                                {
                                    <MudLink Href="@att.Url" Target="_blank" Typo="Typo.caption">@att.FileName</MudLink>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="chat-input-area">
                @if (_pendingAttachments.Count > 0)
                {
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                        @foreach (var attachment in _pendingAttachments)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="pending-attachment-pill">
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                                    @attachment.FileName
                                </MudChip>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               Color="Color.Default" OnClick="() => RemovePendingAttachment(attachment.Id)" />
                            </MudStack>
                        }
                    </MudStack>
                }

                @if (!string.IsNullOrWhiteSpace(_uploadError))
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-2">@_uploadError</MudText>
                }

                <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="chat-composer-row">
                    <div class="file-picker-wrapper">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="file-picker-button"
                                   Disabled="_uploading"
                                   OnClick="TriggerFilePicker">
                            <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                            <span class="ml-1">@(_uploading ? "Uploading..." : "Attach")</span>
                        </MudButton>
                        <InputFile @ref="_fileInput" OnChange="HandleAttachmentSelected" multiple
                                   style="display:none" id="dmFileInput" />
                    </div>

                    <MudTextField @bind-Value="_messageText" Placeholder="Type a message..."
                                  Variant="Variant.Outlined" Immediate="true" Dense="true"
                                  OnKeyDown="HandleKeyDown"
                                  Class="chat-input-field" />

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendMessage"
                               Disabled="@(_uploading || (string.IsNullOrWhiteSpace(_messageText) && _pendingAttachments.Count == 0))">
                        Send
                    </MudButton>
                </MudStack>
            </div>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fill-parent chat-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">Select a contact to start messaging</MudText>
            </MudStack>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Store.Error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="dm-error-banner">@Store.Error</MudAlert>
}

@code {
    private string _messageText = "";
    private bool _uploading;
    private string? _uploadError;
    private readonly List<AttachmentInfo> _pendingAttachments = [];
    private const long MaxUploadBytes = 50L * 1024 * 1024;
    private InputFile? _fileInput;
    private Guid? _lastAutoOpenedUserId;

    [SupplyParameterFromQuery(Name = "userId")]
    public Guid? RequestedUserId { get; set; }

    [SupplyParameterFromQuery(Name = "userName")]
    public string? RequestedUserName { get; set; }

    [SupplyParameterFromQuery(Name = "displayName")]
    public string? RequestedDisplayName { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += OnStoreChanged;
        await Store.LoadContactsAsync();
        await TryOpenRequestedConversationAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await TryOpenRequestedConversationAsync();
    }

    private async Task SelectContact(UserInfo contact) => await Store.SelectContactAsync(contact);

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText) && _pendingAttachments.Count == 0) return;
        var text = _messageText;
        var attachments = _pendingAttachments.ToArray();
        _messageText = "";
        _pendingAttachments.Clear();
        await Store.SendMessageAsync(text, attachments);
    }

    private async Task TriggerFilePicker()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('dmFileInput')?.click()");
        }
        catch (Exception ex)
        {
            _uploadError = $"Could not open file picker: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task HandleAttachmentSelected(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        _uploading = true;
        StateHasChanged();

        try
        {
            foreach (var file in e.GetMultipleFiles())
            {
                if (file.Size > MaxUploadBytes)
                {
                    _uploadError = $"'{file.Name}' is larger than 50 MB.";
                    StateHasChanged();
                    continue;
                }

                try
                {
                    await using var stream = file.OpenReadStream(MaxUploadBytes);
                    var attachment = await Api.UploadFileAsync(stream, file.Name, file.ContentType, file.Size);
                    _pendingAttachments.Add(attachment);
                    StateHasChanged();
                }
                catch (Exception fileEx)
                {
                    _uploadError = $"Failed to upload '{file.Name}': {fileEx.Message}";
                    System.Diagnostics.Debug.WriteLine($"[DirectMessages] Upload failed for {file.Name}: {fileEx}");
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            _uploadError = $"Attachment error: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"[DirectMessages] Attachment selection failed: {ex}");
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private void RemovePendingAttachment(Guid attachmentId)
    {
        _pendingAttachments.RemoveAll(a => a.Id == attachmentId);
    }

    private async Task TryOpenRequestedConversationAsync()
    {
        if (RequestedUserId == null || RequestedUserId == Guid.Empty) return;
        if (RequestedUserId == Auth.CurrentUser?.Id) return;

        var targetUserId = RequestedUserId.Value;
        if (_lastAutoOpenedUserId == targetUserId && Store.SelectedContactId == targetUserId) return;

        var requestedContact = Store.Contacts.FirstOrDefault(c => c.Id == targetUserId) ?? BuildRequestedContact(targetUserId);
        await Store.OpenConversationAsync(requestedContact);
        _lastAutoOpenedUserId = targetUserId;
    }

    private UserInfo BuildRequestedContact(Guid userId)
    {
        var fallbackUserName = $"user_{userId.ToString()[..8]}";
        var userName = string.IsNullOrWhiteSpace(RequestedUserName) ? fallbackUserName : RequestedUserName.Trim();
        var displayName = string.IsNullOrWhiteSpace(RequestedDisplayName) ? userName : RequestedDisplayName.Trim();

        return new UserInfo
        {
            Id = userId,
            UserName = userName,
            DisplayName = displayName,
            IsOnline = false
        };
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Store.OnChange -= OnStoreChanged;
    }
}

