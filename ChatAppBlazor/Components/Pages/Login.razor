@page "/login"
@inject ApiClientService Api
@inject AuthStateProvider Auth
@inject ChatClientService Chat
@inject NavigationManager Nav

<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fill-screen">
    <MudCard Style="width:380px;max-width:90vw" Elevation="4">
        <MudCardHeader>
            <MudText Typo="Typo.h5" Align="Align.Center" Style="width:100%;font-weight:600">Sign In</MudText>
        </MudCardHeader>
        <MudCardContent>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            <MudStack Spacing="3">
                <MudTextField @bind-Value="_userName" Label="Username" Variant="Variant.Outlined"
                              Immediate="true" Disabled="_loading" />

                <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined"
                              InputType="InputType.Password" Immediate="true" Disabled="_loading"
                              OnKeyDown="HandleKeyDown" />
            </MudStack>
        </MudCardContent>
        <MudCardActions Class="d-flex flex-column px-4 pb-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="HandleLogin" Disabled="_loading">
                @(_loading ? "Signing in..." : "Sign In")
            </MudButton>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-3">
                Don't have an account? <MudLink Href="/register">Register</MudLink>
            </MudText>
        </MudCardActions>
    </MudCard>
</MudStack>

@code {
    private string _userName = "";
    private string _password = "";
    private string? _error;
    private bool _loading;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        _error = null;
        _loading = true;

        try
        {
            var response = await Api.LoginAsync(_userName, _password);
            if (response.Success)
            {
                Auth.SetAuth(response.Token!, response.User!);
                await Chat.ConnectAsync();
                Nav.NavigateTo("/");
            }
            else
            {
                _error = response.Error;
            }
        }
        catch (Exception ex)
        {
            _error = $"Connection error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
