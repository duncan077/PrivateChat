@page "/login"
@inject ApiClientService Api
@inject AuthStateProvider Auth
@inject ChatClientService Chat
@inject NavigationManager Nav

<div class="auth-screen">
    <MudCard Class="auth-card" Elevation="0">
        <MudCardHeader>
            <div style="width:100%;text-align:center">
                <div class="auth-logo-mark">PC</div>
                <MudText Typo="Typo.h5" Align="Align.Center" Class="auth-title">Sign In</MudText>
                <MudText Typo="Typo.body2" Class="auth-subtitle">
                    Continue to your secure workspace.
                </MudText>
            </div>
        </MudCardHeader>
        <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
            <MudCardContent>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
                }
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_userName" Label="Username" Variant="Variant.Outlined"
                                  Immediate="true" Disabled="_loading" AdornmentIcon="@Icons.Material.Outlined.Person"
                                  Adornment="Adornment.Start" />
                    <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined"
                                  InputType="InputType.Password" Immediate="true" Disabled="_loading"
                                  AdornmentIcon="@Icons.Material.Outlined.Lock" Adornment="Adornment.Start" />
                    <MudCheckBox @bind-Value="_rememberMe" Disabled="_loading">Remember me</MudCheckBox>
                </MudStack>
            </MudCardContent>
            <MudCardActions Class="d-flex flex-column px-4 pb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           ButtonType="ButtonType.Submit" Disabled="_loading" Size="Size.Large">
                    @(_loading ? "Signing in..." : "Sign In")
                </MudButton>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-3" Style="color:var(--pc-text-muted)">
                    Don't have an account? <MudLink Href="/register">Create one</MudLink>
                </MudText>
            </MudCardActions>
        </form>
    </MudCard>
</div>

@code {
    private string _userName = "";
    private string _password = "";
    private string? _error;
    private bool _loading;
    private bool _rememberMe;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        _error = null;
        _loading = true;

        try
        {
            var response = await Api.LoginAsync(_userName, _password);
            if (response.Success)
            {
                await Auth.SetAuthAsync(response.Token!, response.User!, _rememberMe);
                await Chat.ConnectAsync();
                Nav.NavigateTo("/");
            }
            else
            {
                _error = response.Error;
            }
        }
        catch (Exception ex)
        {
            _error = $"Connection error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
