@page "/voice"
@inject CallStore Store
@inject NavigationManager Nav

@* Legacy route — redirects to main rooms page. Call is now embedded in ChatRooms. *@

<div class="voice-legacy">
    <MudPaper Class="voice-legacy-card pa-5">
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
            @if (Store.IsInCall)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">In Active Call</MudChip>
                <MudText Typo="Typo.body1">You are currently in a call.</MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.CallEnd" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body1" Align="Align.Center">
                    Voice and video calls are now embedded in chat rooms.
                </MudText>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToRooms" Class="mt-1">
                Go to Chat Rooms
            </MudButton>
        </MudStack>
    </MudPaper>
</div>

@code {
    protected override void OnInitialized()
    {
        // Check if there's a room query param and redirect
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var roomParam = query["room"];
        if (!string.IsNullOrEmpty(roomParam))
        {
            Nav.NavigateTo("/");
            return;
        }
    }

    private void GoToRooms() => Nav.NavigateTo("/");
}
