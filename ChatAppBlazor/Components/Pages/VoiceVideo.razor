@page "/voice"
@inject CallStore Store
@inject NavigationManager Nav

@* Legacy route — redirects to main rooms page. Call is now embedded in ChatRooms. *@

<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fill-parent">
    @if (Store.IsInCall)
    {
        <MudText Typo="Typo.body1">You are currently in a call.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToRooms">
            Go to Chat Rooms
        </MudButton>
    }
    else
    {
        <MudIcon Icon="Icons.Material.Filled.CallEnd" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Voice and video calls are now embedded in chat rooms.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToRooms">
            Go to Chat Rooms
        </MudButton>
    }
</MudStack>

@code {
    protected override void OnInitialized()
    {
        // Check if there's a room query param and redirect
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var roomParam = query["room"];
        if (!string.IsNullOrEmpty(roomParam))
        {
            Nav.NavigateTo("/");
            return;
        }
    }

    private void GoToRooms() => Nav.NavigateTo("/");
}
