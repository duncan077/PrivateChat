    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;

        Store.OnChange += OnStoreChanged;
        Store.OnCurrentUserMoved += OnCurrentUserMoved;
        Call.OnChange += OnCallChanged;
        MembersPanel.OnChange += OnMembersPanelChanged;
        _lastIsInAnyCall = Call.IsInCall;
        await Store.LoadRoomsAsync();
        await Store.LoadServerMembersAsync();
        await TryOpenRequestedRoomAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await TryOpenRequestedRoomAsync();

        if (RequestedCreateRoom == 1)
        {
            OpenCreateRoomDialogFromQuery();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsChatVisible || Store.SelectedRoomId == null)
            return;

        if (!_attachmentPasteInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("chatAttachmentPaste.init", "chatFileInput", "chatAttachmentDropZone");
                _attachmentPasteInitialized = true;
            }
            catch
            {
                // Ignore paste/drop hook initialization failures and keep chat usable.
            }
        }

        try
        {
            await JS.InvokeVoidAsync("chatScrollManager.init", _messagesContainerRef, _jumpLatestButtonRef, 20, 180);
            await JS.InvokeVoidAsync("chatInput.init", "chatComposerHost");
            if (_editingMessageId != null)
            {
                // The inline editor is a fresh textarea each time editing starts, so
                // it needs its own Enter-to-submit hook.
                await JS.InvokeVoidAsync("chatInput.init", "chatEditHost");
            }
            if (_composerPreview)
            {
                // Preview should look exactly like the sent message, highlighting
                // included. The data-hl guard makes repeat calls cheap.
                await JS.InvokeVoidAsync("chatCode.highlightNew", _composerPreviewRef);
            }
            var roomId = Store.SelectedRoomId;
            var roomChanged = _lastRenderedMessagesRoomId != roomId;
            var messageCount = Store.Messages.Count;
            // In-place mutations (edit, delete) leave the count untouched but change
            // message heights, so the version has to gate the scroll pass too.
            var messagesVersion = Store.MessagesVersion;
            var contentChanged = messageCount != _lastRenderedMessageCount ||
                                 messagesVersion != _lastRenderedMessagesVersion;
            var shouldForce = _forceScrollToBottom || roomChanged || firstRender || _lastRenderedMessageCount < 0;

            if (shouldForce || contentChanged)
            {
                await JS.InvokeVoidAsync("chatScrollManager.onMessagesChanged", _messagesContainerRef, shouldForce);
                await JS.InvokeVoidAsync("chatCode.highlightNew", _messagesContainerRef);
            }

            QueueVisibleLinkPreviewLoads();

            _lastRenderedMessagesRoomId = roomId;
            _lastRenderedMessageCount = messageCount;
            _lastRenderedMessagesVersion = messagesVersion;
            _forceScrollToBottom = false;
        }
        catch
        {
            // Ignore transient JS interop failures during rerenders/navigation.
        }
    }

    private async Task SelectRoom(Guid roomId)
    {
        if (Store.SelectedRoomId == roomId) return;

        if (_joining && _joiningRoomId != roomId)
        {
            _joinCallOperationVersion++;
            _joining = false;
            _joiningRoomId = null;
        }

        var previousRoomId = Store.SelectedRoomId;
        var keepPreviousRoomSubscription =
            previousRoomId != null &&
            Call.IsInCall &&
            Call.ActiveRoomId == previousRoomId;

        await Store.SelectRoomAsync(roomId, keepPreviousRoomSubscription);
        await Call.RefreshRoomParticipantsAsync(roomId);
        _messageText = string.Empty;
        _pendingAttachments.Clear();
        _uploadError = null;
        ClearMentionSuggestions();
        CancelEditMessage();
        CancelReply();
        _forceScrollToBottom = true;
        _lastRenderedMessageCount = -1;
        _lastRenderedMessagesVersion = -1;
        _lastRenderedMessagesRoomId = null;
    }

    private void OnMessageTextEdited()
    {
        UpdateMentionSuggestions();

        // Fire-and-forget: the store throttles, and a failed typing ping is not worth
        // blocking keystrokes or surfacing.
        if (!string.IsNullOrWhiteSpace(_messageText))
        {
            _ = Store.NotifyTypingAsync();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText) && _pendingAttachments.Count == 0) return;
        var text = _messageText;
        var mentionedUserIds = ExtractMentionedUserIds(text);
        var attachments = _pendingAttachments.ToArray();
        _messageText = string.Empty;
        ClearMentionSuggestions();
        _pendingAttachments.Clear();
        _forceScrollToBottom = true;
        await InvokeAsync(StateHasChanged);
        // Sending returns you to writing mode; previewing an empty box is noise.
        _composerPreview = false;
        var replyTo = _replyTo;
        _replyTo = null;
        var sent = await Store.SendMessageAsync(text, attachments, mentionedUserIds, replyTo?.Id);
        if (!sent)
        {
            // Failed sends surface Store.Error; put the user's text back instead of
            // losing it to the eager clear above.
            _messageText = text;
            _pendingAttachments.AddRange(attachments);
            _replyTo = replyTo;
            await InvokeAsync(StateHasChanged);
        }
    }

