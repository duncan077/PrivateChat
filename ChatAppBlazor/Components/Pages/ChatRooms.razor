    /// <summary>
    /// Re-render ChatRooms when call active state changes OR when the selected room's
    /// connected call participants change. Ignore mute/PTT/camera/screenshare toggles.
    /// </summary>
    private void OnCallChanged()
    {
        var wasInAnyCall = _lastIsInAnyCall;
        _lastIsInAnyCall = Call.IsInCall;

        if (!wasInAnyCall && Call.IsInCall)
        {
            _showAllMembersDuringCall = false;
            CancelPendingInactiveStop();
        }

        if (wasInAnyCall && !Call.IsInCall)
        {
            _ = StopWebRtcSilentlyAsync();
        }

        var isActive = Call.IsInCall && Call.ActiveRoomId == Store.SelectedRoomId;
        var floatingModeChanged = _lastUseFloatingOverlayInActiveRoom != Call.UseFloatingOverlayInActiveRoom;
        if (floatingModeChanged)
        {
            _lastUseFloatingOverlayInActiveRoom = Call.UseFloatingOverlayInActiveRoom;
        }
        var participantsSignature = BuildCallParticipantsSignature();
        var participantsChanged = !string.Equals(_lastCallParticipantsSignature, participantsSignature, StringComparison.Ordinal);

        if (participantsChanged)
        {
            _lastCallParticipantsSignature = participantsSignature;
        }

        if (isActive != _lastCallActive || participantsChanged || floatingModeChanged)
        {
            _lastCallActive = isActive;
            if (!isActive)
            {
                _lastParticipantDirectorySignature = string.Empty;
                _lastUseFloatingOverlayInActiveRoom = false;
            }
            _ = SyncParticipantDirectoryAsync(force: true);
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopWebRtcSilentlyAsync()
    {
        CancelPendingInactiveStop();
        var cts = new CancellationTokenSource();
        _pendingInactiveStopCts = cts;

        try
        {
            // Guard against transient call-state flips caused by out-of-order presence events.
            await Task.Delay(4500, cts.Token);
            if (cts.IsCancellationRequested || Call.IsInCall)
            {
                return;
            }

            // If the host app is in background/second plane, do not tear down WebRTC
            // based on transient call-store state flips. Let reconnect logic recover.
            var appVisible = await IsAppVisibleAsync();
            if (!appVisible)
            {
                return;
            }

            await WebRtc.StopAsync("call-store-inactive-confirmed");
        }
        catch (OperationCanceledException)
        {
            // Expected when call state recovers before the guard window elapses.
        }
        catch
        {
            // Ignore teardown races when call state changes remotely.
        }
        finally
        {
            if (ReferenceEquals(_pendingInactiveStopCts, cts))
            {
                _pendingInactiveStopCts = null;
            }

            cts.Dispose();
        }
    }

    private async Task<bool> IsAppVisibleAsync()
    {
        try
        {
            return await JS.InvokeAsync<bool>("eval", "document.visibilityState === 'visible' && !document.hidden");
        }
        catch
        {
            // Be conservative: if visibility cannot be queried, avoid tearing down call state.
            return false;
        }
    }

    private void CancelPendingInactiveStop()
    {
        if (_pendingInactiveStopCts == null)
        {
            return;
        }

        try
        {
            _pendingInactiveStopCts.Cancel();
        }
        catch
        {
            // Ignore cancellation races.
        }
    }

    private string BuildCallParticipantsSignature()
    {
        if (Store.SelectedRoomId == null)
        {
            return string.Empty;
        }

        var roomId = Store.SelectedRoomId.Value;
        var ids = Call.GetRoomParticipants(roomId)
            .Where(id => id != Guid.Empty)
            .Distinct()
            .OrderBy(id => id)
            .Select(id => id.ToString("D"));

        return string.Join("|", ids);
    }

    private bool IsMemberConnectedToActiveCall(Guid userId)
    {
        if (!Call.IsInCall || Call.ActiveRoomId == null) return false;
        if (userId == Guid.Empty) return false;

        var roomId = Call.ActiveRoomId.Value;
        if (userId == Auth.CurrentUser?.Id)
        {
            return true;
        }

        return Call.IsUserConnectedInRoom(roomId, userId);
    }

    private bool IsMemberConnectedToRoomCall(Guid userId)
    {
        if (Store.SelectedRoomId == null) return false;
        if (userId == Guid.Empty) return false;

        var roomId = Store.SelectedRoomId.Value;
        if (userId == Auth.CurrentUser?.Id)
        {
            return (Call.IsInCall && Call.ActiveRoomId == roomId) || Call.IsUserConnectedInRoom(roomId, userId);
        }

        return Call.IsUserConnectedInRoom(roomId, userId);
    }

