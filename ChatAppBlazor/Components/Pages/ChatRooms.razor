    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_showMentionSuggestions && _mentionSuggestions.Count > 0)
        {
            if (string.Equals(e.Key, "ArrowDown", StringComparison.Ordinal))
            {
                MoveMentionSuggestionSelection(1);
                return;
            }

            if (string.Equals(e.Key, "ArrowUp", StringComparison.Ordinal))
            {
                MoveMentionSuggestionSelection(-1);
                return;
            }

            if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
            {
                ClearMentionSuggestions();
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (string.Equals(e.Key, "Enter", StringComparison.Ordinal) || string.Equals(e.Key, "Tab", StringComparison.Ordinal))
            {
                SelectMentionSuggestion(_mentionSuggestions[_activeMentionSuggestionIndex]);
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void MoveMentionSuggestionSelection(int delta)
    {
        if (_mentionSuggestions.Count == 0) return;

        var next = _activeMentionSuggestionIndex + delta;
        if (next < 0) next = _mentionSuggestions.Count - 1;
        if (next >= _mentionSuggestions.Count) next = 0;
        _activeMentionSuggestionIndex = next;
        _ = InvokeAsync(StateHasChanged);
    }

    private void SelectMentionSuggestion(MentionSuggestion suggestion)
    {
        if (_mentionQueryStartIndex < 0)
        {
            ClearMentionSuggestions();
            return;
        }

        var prefix = _messageText[.._mentionQueryStartIndex];
        var suffixStart = Math.Min(_messageText.Length, _mentionQueryStartIndex + 1 + _mentionQuery.Length);
        var suffix = suffixStart < _messageText.Length ? _messageText[suffixStart..] : string.Empty;

        if (string.IsNullOrEmpty(suffix))
        {
            _messageText = $"{prefix}@{suggestion.UserName} ";
        }
        else
        {
            var spacer = char.IsWhiteSpace(suffix[0]) ? string.Empty : " ";
            _messageText = $"{prefix}@{suggestion.UserName}{spacer}{suffix}";
        }

        ClearMentionSuggestions();
    }

    private void UpdateMentionSuggestions()
    {
        _mentionSuggestions.Clear();
        _showMentionSuggestions = false;
        _activeMentionSuggestionIndex = 0;
        _mentionQueryStartIndex = -1;
        _mentionQuery = string.Empty;

        if (Store.SelectedRoomId == null || string.IsNullOrWhiteSpace(_messageText))
        {
            return;
        }

        var atIndex = _messageText.LastIndexOf('@');
        if (atIndex < 0)
        {
            return;
        }

        if (atIndex > 0 && !char.IsWhiteSpace(_messageText[atIndex - 1]))
        {
            return;
        }

        var query = _messageText[(atIndex + 1)..];
        if (query.Any(char.IsWhiteSpace))
        {
            return;
        }

        var candidates = Store.Members
            .Where(member => member.UserId != Guid.Empty && !string.IsNullOrWhiteSpace(member.UserName))
            .Where(member => member.UserId != Auth.CurrentUser?.Id)
            .GroupBy(member => member.UserName.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .Where(member => string.IsNullOrWhiteSpace(query)
                || member.UserName.StartsWith(query, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(member => member.IsOnline)
            .ThenBy(member => member.UserName, StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .Select(member => new MentionSuggestion(
                member.UserId,
                member.UserName.Trim(),
                string.IsNullOrWhiteSpace(member.DisplayName) ? member.UserName.Trim() : member.DisplayName.Trim()))
            .ToList();

        if (string.IsNullOrWhiteSpace(query)
            || MentionAllToken.StartsWith(query, StringComparison.OrdinalIgnoreCase))
        {
            candidates.Insert(0, new MentionSuggestion(Guid.Empty, MentionAllToken, "Mention everyone in room"));
        }

        if (candidates.Count == 0)
        {
            return;
        }

        _mentionQueryStartIndex = atIndex;
        _mentionQuery = query;
        _mentionSuggestions.AddRange(candidates);
        _showMentionSuggestions = true;
    }

    private void ClearMentionSuggestions()
    {
        _mentionSuggestions.Clear();
        _showMentionSuggestions = false;
        _activeMentionSuggestionIndex = 0;
        _mentionQueryStartIndex = -1;
        _mentionQuery = string.Empty;
    }

    private Guid[] ExtractMentionedUserIds(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return [];
        }

        var usernameLookup = Store.Members
            .Where(member => member.UserId != Guid.Empty && !string.IsNullOrWhiteSpace(member.UserName))
            .GroupBy(member => member.UserName.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.First().UserId, StringComparer.OrdinalIgnoreCase);

        if (usernameLookup.Count == 0)
        {
            return [];
        }

        var mentionedUserIds = new HashSet<Guid>();
        foreach (System.Text.RegularExpressions.Match match in MentionTokenRegex.Matches(content))
        {
            var username = match.Groups[2].Value;
            if (username.Equals(MentionAllToken, StringComparison.OrdinalIgnoreCase))
            {
                foreach (var member in Store.Members)
                {
                    if (member.UserId == Guid.Empty || member.UserId == Auth.CurrentUser?.Id)
                    {
                        continue;
                    }

                    mentionedUserIds.Add(member.UserId);
                }

                continue;
            }

            if (usernameLookup.TryGetValue(username, out var mentionedUserId) && mentionedUserId != Guid.Empty)
            {
                mentionedUserIds.Add(mentionedUserId);
            }
        }

        return [.. mentionedUserIds];
    }

