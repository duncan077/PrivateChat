    private Guid GetMoveTargetRoomId(Guid userId)
    {
        var moveTargets = GetMoveTargetRooms(userId);
        if (moveTargets.Count == 0)
        {
            return Guid.Empty;
        }

        if (_moveTargetsByUserId.TryGetValue(userId, out var selectedTarget)
            && moveTargets.Any(room => room.Id == selectedTarget))
        {
            return selectedTarget;
        }

        var defaultTarget = moveTargets[0].Id;
        _moveTargetsByUserId[userId] = defaultTarget;
        return defaultTarget;
    }

