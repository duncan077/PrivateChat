        if (Store.CurrentUserRole < UserRole.Moderator)
        {
            return false;
        }

        var targetMember = Store.ServerMembers.FirstOrDefault(member => member.UserId == userId);
        return targetMember != null && targetMember.Role < Store.CurrentUserRole;
