    private Task OpenPrivateMessage(ServerMemberInfo member)
    {
        if (member.UserId == Guid.Empty || member.UserId == Auth.CurrentUser?.Id) return Task.CompletedTask;

        var userName = string.IsNullOrWhiteSpace(member.UserName)
            ? $"user_{member.UserId.ToString()[..8]}"
            : member.UserName.Trim();
        var displayName = string.IsNullOrWhiteSpace(member.DisplayName)
            ? userName
            : member.DisplayName.Trim();

        var dmTarget = $"/dm?userId={member.UserId:D}&userName={Uri.EscapeDataString(userName)}&displayName={Uri.EscapeDataString(displayName)}";
        Nav.NavigateTo(dmTarget);
        return Task.CompletedTask;
    }

