                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="() => MoveUserAndClose(moderationTarget.UserId)">
                                        Move User
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        }
                    </MudStack>
                }
            </MudPaper>
        </div>
    }
</div>

