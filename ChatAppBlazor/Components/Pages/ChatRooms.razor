@page "/"
@implements IDisposable
@inject ChatRoomStore Store
@inject CallStore Call
@inject AuthStateProvider Auth
@inject WebRtcBridge WebRtc
@inject NavigationManager Nav
@inject ApiClientService Api
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject MembersPanelStore MembersPanel

<div class="rooms-page">
   

    @* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Center: Chat + Call Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ *@
    <div class="rooms-main">
        @if (Store.SelectedRoomId != null)
        {
            @* Chat header *@
            <div class="chat-toolbar">
                <div class="chat-toolbar-content">
                    <div class="chat-toolbar-title-wrap">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600">@Store.SelectedRoom?.Name</MudText>
                    </div>

                    <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1" Class="chat-toolbar-actions">
                        <MudIconButton Icon="@GetSelectedRoomNotificationIcon()"
                                       Size="Size.Small"
                                       Color="@GetSelectedRoomNotificationColor()"
                                       title="@GetSelectedRoomNotificationTooltip()"
                                       OnClick="CycleSelectedRoomNotificationMode" />
                        @if ((Store.SelectedRoom?.IsVoiceEnabled == true || Store.SelectedRoom?.IsVideoEnabled == true))
                        {
                            @if (_joining)
                            {
                                <MudButton StartIcon="@Icons.Material.Filled.HourglassTop" Size="Size.Small"
                                           Variant="Variant.Filled" Color="Color.Warning"
                                           Disabled="true">Joining...</MudButton>
                            }
                            else if (Call.IsInCall && Call.ActiveRoomId == Store.SelectedRoomId)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">In Call</MudChip>
                            }
                            else
                            {
                                <MudButton StartIcon="@Icons.Material.Filled.Call" Size="Size.Small"
                                           Variant="Variant.Filled" Color="Color.Success"
                                           OnClick="JoinCall">Join Call</MudButton>
                            }
                        }
                        @if (IsCallActiveForSelectedRoom)
                        {
                            <MudIconButton Icon="@(Call.UseFloatingOverlayInActiveRoom ? Icons.Material.Filled.VideoCall : Icons.Material.Filled.Chat)"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           title="@(Call.UseFloatingOverlayInActiveRoom ? "Show full call" : "Open chat and float call")"
                                           OnClick="ToggleChatCallLayout" />
                        }
                        @if (Store.SelectedRoom?.OwnerId == Auth.CurrentUser?.Id)
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.DeleteForever" Size="Size.Small"
                                       Variant="Variant.Text" Color="Color.Error"
                                       OnClick="DeleteSelectedRoom">Delete Room</MudButton>
                        }
                    </MudStack>
                </div>
            </div>

            @* Active call panel (keep mounted while any call is active so remote audio sinks stay alive) *@
            @if (HasActiveCall)
            {
                <div class="call-panel-host @(IsInlineCallVisible ? string.Empty : "keep-alive-hidden")"
                     aria-hidden="@(!IsInlineCallVisible)">
                    <ActiveCallPanel RoomId="Call.ActiveRoomId!.Value" RoomName="@GetActiveCallRoomName()" />
                </div>
            }

            @* Messages *@
            @if (IsChatVisible)
            {
                <div class="chat-messages-host">
                    <div class="chat-messages-area @(IsInlineCallVisible ? "call-active" : "")" @ref="_messagesContainerRef">
                        @foreach (var msg in Store.Messages)
                        {
                            var isOwn = msg.SenderId == Auth.CurrentUser?.Id;
                            <div class="chat-msg @(isOwn ? "own" : "") @(msg.IsDeleted ? "deleted" : "")">
                                <div class="chat-msg-header">
                                    <MudText Typo="Typo.caption" Style="font-weight:600;color:var(--mud-palette-primary)">
                                        @msg.SenderName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @msg.SentAt.ToLocalTime().ToString("HH:mm")
                                    </MudText>
                                    @if (isOwn || Store.CurrentUserRole >= UserRole.Moderator)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       Color="Color.Error" OnClick="() => DeleteMessage(msg.Id)"
                                                       Style="padding:2px" title="Delete" />
                                    }
                                </div>
                                @if (!msg.IsDeleted)
                                {
                                    <MudText Typo="Typo.body2" Class="chat-msg-body">@msg.Content</MudText>
                                    var previewUrl = ExtractFirstHttpUrl(msg.Content);
                                    var preview = GetCachedLinkPreview(previewUrl);
                                    @if (preview != null && !string.IsNullOrWhiteSpace(preview.Url))
                                    {
                                        var href = !string.IsNullOrWhiteSpace(preview.CanonicalUrl) ? preview.CanonicalUrl : preview.Url;
                                        <a class="chat-link-preview" href="@href" target="_blank" rel="noopener noreferrer">
                                            @if (!string.IsNullOrWhiteSpace(preview.ImageUrl))
                                            {
                                                <img class="chat-link-preview-image" src="@preview.ImageUrl" alt="Link preview image" loading="lazy" />
                                            }
                                            <div class="chat-link-preview-content">
                                                @if (!string.IsNullOrWhiteSpace(preview.SiteName))
                                                {
                                                    <span class="chat-link-preview-site">@preview.SiteName</span>
                                                }
                                                <span class="chat-link-preview-title">@GetPreviewTitle(preview, href)</span>
                                                @if (!string.IsNullOrWhiteSpace(preview.Description))
                                                {
                                                    <span class="chat-link-preview-description">@preview.Description</span>
                                                }
                                                <span class="chat-link-preview-url">@FormatPreviewUrl(href)</span>
                                            </div>
                                        </a>
                                    }
                                    @if (msg.Attachments.Length > 0)
                                    {
                                        <div class="chat-msg-attachments">
                                            @foreach (var att in msg.Attachments)
                                            {
                                                var attachmentUrl = GetAttachmentUrl(att);
                                                if (string.IsNullOrWhiteSpace(attachmentUrl))
                                                {
                                                    <MudText Typo="Typo.caption">@GetAttachmentLabel(att)</MudText>
                                                }
                                                else if (IsImageAttachment(att))
                                                {
                                                    <a class="chat-attachment-link" href="@attachmentUrl" target="_blank" rel="noopener noreferrer">
                                                        <img class="chat-attachment-image"
                                                             src="@attachmentUrl"
                                                             alt="@GetAttachmentLabel(att)"
                                                             loading="lazy" />
                                                    </a>
                                                }
                                                else if (IsVideoAttachment(att))
                                                {
                                                    <video class="chat-attachment-video"
                                                           controls
                                                           preload="metadata"
                                                           onloadedmetadata="window.webrtcManager?.applyAttachmentVideoVolume(this)"
                                                           onplay="window.webrtcManager?.applyAttachmentVideoVolume(this)"
                                                           onvolumechange="window.webrtcManager?.rememberAttachmentVideoVolume(this)">
                                                        <source src="@attachmentUrl" type="@ResolveVideoMime(att)" />
                                                        Your browser does not support inline video playback.
                                                    </video>
                                                    <a class="chat-attachment-link chat-attachment-filename" href="@attachmentUrl" target="_blank" rel="noopener noreferrer">
                                                        @GetAttachmentLabel(att)
                                                    </a>
                                                }
                                                else
                                                {
                                                    <MudLink Href="@attachmentUrl" Target="_blank" Typo="Typo.caption">@GetAttachmentLabel(att)</MudLink>
                                                }
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-style:italic">
                                        Message deleted
                                    </MudText>
                                }
                            </div>
                        }
                    </div>
                    <button type="button"
                            class="chat-jump-latest-button"
                            title="Jump to latest"
                            @ref="_jumpLatestButtonRef"
                            @onclick="JumpToLatestAsync">
                        Latest
                    </button>
                </div>

                @* Input *@
                <div class="chat-input-area @(IsInlineCallVisible ? "call-active" : "") @(_isAttachmentDragActive ? "drag-over" : "")"
                     @ondragenter="OnAttachmentDragEnter"
                     @ondragenter:preventDefault
                     @ondragover="OnAttachmentDragOver"
                     @ondragover:preventDefault
                     @ondragleave="OnAttachmentDragLeave"
                     @ondragleave:preventDefault
                     @ondrop="OnAttachmentDrop"
                     @ondrop:preventDefault>
                    @if (_pendingAttachments.Count > 0)
                    {
                        <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                            @foreach (var attachment in _pendingAttachments)
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="pending-attachment-pill">
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                                        @attachment.FileName
                                    </MudChip>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   Color="Color.Default" OnClick="() => RemovePendingAttachment(attachment.Id)" />
                                </MudStack>
                            }
                        </MudStack>
                    }

                    @if (!string.IsNullOrWhiteSpace(_uploadError))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-2">@_uploadError</MudText>
                    }

                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="chat-composer-row">
                        <div class="file-picker-wrapper">
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="file-picker-button"
                                       Disabled="_uploading"
                                       OnClick="TriggerFilePicker">
                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                                <span class="ml-1">@(_uploading ? "Uploading..." : "Attach")</span>
                            </MudButton>
                            <InputFile @ref="_fileInput" OnChange="HandleAttachmentSelected" multiple
                                       style="display:none" id="chatFileInput" />
                        </div>

                        <div class="chat-input-mention-host">
                            <MudTextField @bind-Value="_messageText" @bind-Value:after="OnMessageTextEdited" Placeholder="Type a message... (&#64;username)"
                                          Variant="Variant.Outlined" Immediate="true" Dense="true"
                                          OnKeyDown="HandleKeyDown"
                                          Class="chat-input-field" />

                            @if (_showMentionSuggestions && _mentionSuggestions.Count > 0)
                            {
                                <div class="chat-mention-suggestions" role="listbox" aria-label="Mention suggestions">
                                    @for (var i = 0; i < _mentionSuggestions.Count; i++)
                                    {
                                        var suggestion = _mentionSuggestions[i];
                                        var isActive = i == _activeMentionSuggestionIndex;
                                        <button type="button"
                                                class="chat-mention-suggestion-item @(isActive ? "active" : string.Empty)"
                                                title="@($"@{suggestion.UserName}")"
                                                @onclick="() => SelectMentionSuggestion(suggestion)">
                                            <span class="chat-mention-suggestion-name">@($"@{suggestion.UserName}")</span>
                                            <span class="chat-mention-suggestion-display">@suggestion.DisplayName</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendMessage"
                                   Disabled="@(_uploading || (string.IsNullOrWhiteSpace(_messageText) && _pendingAttachments.Count == 0))">
                            Send
                        </MudButton>
                    </MudStack>

                    <div class="chat-input-drop-overlay" aria-hidden="@(!_isAttachmentDragActive)">
                        <InputFile OnChange="HandleAttachmentSelected"
                                   multiple
                                   class="chat-input-drop-file-input" />
                        <div class="chat-input-drop-hint">Drop files to attach</div>
                    </div>
                </div>
            }
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fill-parent chat-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">Select a room to start chatting</MudText>
            </MudStack>
        }
    </div>

    @* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Right: Members panel Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ *@
    @if (MembersPanel.IsVisible)
    {
    <div class="members-sidebar">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pa-3 members-sidebar-header">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:600">Server Members</MudText>
                    @if (Store.SelectedRoomId != null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Room: @Store.SelectedRoom?.Name
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Select a room to move users or kick from chat.
                        </MudText>
                    }
                </MudStack>

            </MudStack>

            @if (Call.IsInCall)
            {
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-3 pb-2 members-sidebar-filter">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">In-call filter</MudText>
                    <MudSwitch T="bool"
                               Value="_showAllMembersDuringCall"
                               ValueChanged="OnShowAllMembersDuringCallChanged"
                               Color="Color.Primary">
                        Show all
                    </MudSwitch>
                </MudStack>
            }
            <MudList T="Guid" Dense="true" Class="members-list">
                @foreach (var member in GetVisibleMembers())
                {
                    var roomMember = Store.GetSelectedRoomMember(member.UserId);
                    var isCurrentUser = member.UserId == Auth.CurrentUser?.Id;
                    var canModerateTarget = CanModerateTarget(member.UserId);
                    var memberAvatarUrl = GetMemberAvatarUrl(member.AvatarUrl);

                    <MudListItem T="Guid" Value="member.UserId" Class="member-list-item">
                        <div class="member-entry member-entry-clickable"
                             title="Double-click to send a private message"
                             @ondblclick="() => OpenPrivateMessage(member)">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="member-entry-main">
                                <MudAvatar Size="Size.Small" Color="Color.Primary">
                                    @if (!string.IsNullOrWhiteSpace(memberAvatarUrl))
                                    {
                                        <img src="@memberAvatarUrl" alt="Profile" class="avatar-image-fill" />
                                    }
                                    else
                                    {
                                        @GetMemberInitial(member.DisplayName, member.UserName)
                                    }
                                </MudAvatar>
                                <div class="member-entry-text">
                                    <MudText Typo="Typo.body2" Class="member-name-row">
                                        <span class="member-name-label">@member.DisplayName</span>
                                        @if (member.IsOnline)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Circle"
                                                     Size="Size.Small"
                                                     Color="Color.Success"
                                                     title="Online"
                                                     Class="member-status-dot" />
                                        }
                                        @if (IsMemberConnectedToActiveCall(member.UserId))
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Videocam"
                                                     Size="Size.Small"
                                                     Color="Color.Info"
                                                     title="Connected to call"
                                                     Class="member-status-call" />
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="member-meta-row">
                                        <span>Role: @member.Role</span>
                                      
                                    </MudText>
                                </div>
                            </MudStack>

                            @if (!isCurrentUser)
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="0" Class="member-entry-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.MarkChatUnread"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   title="Send private message"
                                                   OnClick="() => OpenPrivateMessage(member)" />
                                    @if (canModerateTarget)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings"
                                                       Size="Size.Small"
                                                       Color="Color.Secondary"
                                                       title="Moderation settings"
                                                       OnClick="() => OpenModerationPopup(member.UserId)" />
                                    }
                                </MudStack>
                            }
                        </div>
                    </MudListItem>
                }
            </MudList>
    </div>
    }

    @if (_showCreateRoom)
    {
        <div class="create-room-overlay" @onclick="CancelCreateRoom">
            <MudPaper Class="create-room-sheet" Elevation="8" @onclick:stopPropagation="true">
                <MudText Typo="Typo.h6">Create Room</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Set up a room for your team.</MudText>

                <MudStack Spacing="2" Class="mt-3">
                    <MudTextField @bind-Value="_newRoomName"
                                  Label="Room Name"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Required="true" />

                    <MudTextField @bind-Value="_newRoomDesc"
                                  Label="Description (optional)"
                                  Variant="Variant.Outlined"
                                  Lines="2" />

                    <MudSwitch T="bool" @bind-Value="_newRoomVoice" Color="Color.Primary">
                        Enable Voice
                    </MudSwitch>

                    <MudSwitch T="bool" @bind-Value="_newRoomVideo" Color="Color.Primary">
                        Enable Video
                    </MudSwitch>

                    @if (!string.IsNullOrWhiteSpace(Store.Error))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@Store.Error</MudAlert>
                    }

                    <MudStack Row Justify="Justify.FlexEnd" Spacing="1" Class="mt-1">
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelCreateRoom">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateRoom"
                                   Disabled="string.IsNullOrWhiteSpace(_newRoomName)">
                            Create
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </div>
    }

    @if (GetModerationTarget() is { } moderationTarget)
    {
        var canModerateTarget = CanModerateTarget(moderationTarget.UserId);
        var canManageRoles = CanManageRoles(moderationTarget.UserId);
        var canKickFromChat = CanKickFromChat(moderationTarget.UserId);
        var canKickFromCall = CanKickFromCall(moderationTarget.UserId);
        var moveTargets = GetMoveTargetRooms(moderationTarget.UserId);

        <div class="moderation-popup-overlay" @onclick="CloseModerationPopup">
            <MudPaper Class="moderation-popup-sheet" Elevation="10" @onclick:stopPropagation="true">
                <div class="moderation-popup-header">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">Moderation</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @moderationTarget.DisplayName (@moderationTarget.Role)
                        </MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   OnClick="CloseModerationPopup" />
                </div>

                @if (!canModerateTarget)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        You can no longer moderate this user.
                    </MudAlert>
                }
                else
                {
                    <MudStack Spacing="2">
                        <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                            @if (canKickFromCall)
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Warning"
                                           OnClick="() => KickUserFromCallAndClose(moderationTarget.UserId)">
                                    Kick From Call
                                </MudButton>
                            }

                            @if (canKickFromChat)
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           OnClick="() => KickUserFromChatAndClose(moderationTarget.UserId)">
                                    Kick From Chat
                                </MudButton>
                            }
                        </MudStack>

                        @if (canManageRoles)
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Global role</MudText>
                                <MudSelect T="UserRole"
                                           Value="moderationTarget.Role"
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           ValueChanged="(role) => ChangeRole(moderationTarget.UserId, role)">
                                    @foreach (var role in GetAssignableRoles())
                                    {
                                        <MudSelectItem T="UserRole" Value="role">@role</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudStack>
                        }

                        @if (moveTargets.Count > 0)
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Move to room</MudText>
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                    <MudSelect T="Guid"
                                               Dense="true"
                                               Variant="Variant.Outlined"
                                               Value="GetMoveTargetRoomId(moderationTarget.UserId)"
                                               ValueChanged="(target) => SetMoveTargetRoom(moderationTarget.UserId, target)"
                                               Style="min-width:160px">
                                        @foreach (var targetRoom in moveTargets)
                                        {
                                            <MudSelectItem T="Guid" Value="targetRoom.Id">@targetRoom.Name</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="() => MoveUserAndClose(moderationTarget.UserId)">
                                        Move User
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        }
                    </MudStack>
                }
            </MudPaper>
        </div>
    }
</div>

@code {
    private sealed record MentionSuggestion(Guid UserId, string UserName, string DisplayName);
    private const string MentionAllToken = "all";

    private string _messageText = "";
    private bool _showCreateRoom;
    private bool _joining;
    private bool _showAllMembersDuringCall = true;
    private bool _lastIsInAnyCall;
    private string _newRoomName = "";
    private string? _newRoomDesc;
    private bool _newRoomVoice;
    private bool _newRoomVideo;
    private bool _uploading;
    private string? _uploadError;
    private readonly List<AttachmentInfo> _pendingAttachments = [];
    private readonly Dictionary<Guid, Guid> _moveTargetsByUserId = [];
    private Guid? _moderationTargetUserId;
    private ElementReference _messagesContainerRef;
    private ElementReference _jumpLatestButtonRef;
    private bool _forceScrollToBottom;
    private int _lastRenderedMessageCount = -1;
    private Guid? _lastRenderedMessagesRoomId;
    private const long MaxUploadBytes = 50L * 1024 * 1024;
    private InputFile? _fileInput;
    private bool _isAttachmentDragActive;
    private int _attachmentDragDepth;

    // Track call state to avoid re-rendering on every mute/PTT/camera change
    private bool _lastCallActive;
    private bool _lastUseFloatingOverlayInActiveRoom;
    private string _lastParticipantDirectorySignature = string.Empty;
    private string _lastCallParticipantsSignature = string.Empty;
    private CancellationTokenSource? _pendingInactiveStopCts;
    private bool IsCallActiveForSelectedRoom => Call.IsInCall && Call.ActiveRoomId == Store.SelectedRoomId;
    private bool HasActiveCall => Call.IsInCall && Call.ActiveRoomId is Guid activeId && activeId != Guid.Empty;
    private bool IsInlineCallVisible => IsCallActiveForSelectedRoom && !Call.UseFloatingOverlayInActiveRoom;
    private bool IsChatVisible => Store.SelectedRoomId != null && (!IsCallActiveForSelectedRoom || Call.UseFloatingOverlayInActiveRoom);
    private Guid? _lastAutoOpenedRoomId;
    private static readonly System.Text.RegularExpressions.Regex UrlRegex = new(
        "(?i)\\bhttps?://[^\\s<>()]+",
        System.Text.RegularExpressions.RegexOptions.Compiled);
    private readonly Dictionary<string, LinkPreviewInfo?> _linkPreviewCache = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _linkPreviewInFlight = new(StringComparer.OrdinalIgnoreCase);
    private const int MaxLinkPreviewCacheEntries = 300;
    private readonly List<MentionSuggestion> _mentionSuggestions = [];
    private bool _showMentionSuggestions;
    private int _activeMentionSuggestionIndex;
    private int _mentionQueryStartIndex = -1;
    private string _mentionQuery = string.Empty;
    private static readonly System.Text.RegularExpressions.Regex MentionTokenRegex = new(
        "(^|\\s)@([A-Za-z0-9_.-]+)",
        System.Text.RegularExpressions.RegexOptions.Compiled);

    [SupplyParameterFromQuery(Name = "roomId")]
    public Guid? RequestedRoomId { get; set; }

    [SupplyParameterFromQuery(Name = "createRoom")]
    public int? RequestedCreateRoom { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;

        Store.OnChange += OnStoreChanged;
        Call.OnChange += OnCallChanged;
        MembersPanel.OnChange += OnMembersPanelChanged;
        _lastIsInAnyCall = Call.IsInCall;
        await Store.LoadRoomsAsync();
        await Store.LoadServerMembersAsync();
        await TryOpenRequestedRoomAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await TryOpenRequestedRoomAsync();

        if (RequestedCreateRoom == 1)
        {
            OpenCreateRoomDialogFromQuery();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsChatVisible || Store.SelectedRoomId == null)
            return;

        try
        {
            await JS.InvokeVoidAsync("chatScrollManager.init", _messagesContainerRef, _jumpLatestButtonRef, 20, 180);
            var roomId = Store.SelectedRoomId;
            var roomChanged = _lastRenderedMessagesRoomId != roomId;
            var messageCount = Store.Messages.Count;
            var countChanged = messageCount != _lastRenderedMessageCount;
            var shouldForce = _forceScrollToBottom || roomChanged || firstRender || _lastRenderedMessageCount < 0;

            if (shouldForce || countChanged)
            {
                await JS.InvokeVoidAsync("chatScrollManager.onMessagesChanged", _messagesContainerRef, shouldForce);
            }

            QueueVisibleLinkPreviewLoads();

            _lastRenderedMessagesRoomId = roomId;
            _lastRenderedMessageCount = messageCount;
            _forceScrollToBottom = false;
        }
        catch
        {
            // Ignore transient JS interop failures during rerenders/navigation.
        }
    }

