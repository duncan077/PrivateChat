    private async Task JoinCall()
    {
        if (Store.SelectedRoomId == null || _joining) return;

        _joining = true;
        StateHasChanged();

        try
        {
            var selectedRoomId = Store.SelectedRoomId.Value;
            var isSwitchingRooms = Call.IsInCall && Call.ActiveRoomId != selectedRoomId;
            if (isSwitchingRooms)
            {
                try
                {
                    await WebRtc.StopAsync("join-switch-room");
                }
                catch
                {
                    // Continue and let JoinCallAsync replace server-side call state.
                }
            }

            // 1. Get Janus session from server
            var session = await Call.JoinCallAsync(selectedRoomId);
            if (session == null)
            {
                _joining = false;
                return;
            }

            // 2. Initialize the WebRTC JS layer with the Janus session
            await WebRtc.InitAsync(
                session.JanusSessionId,
                session.JanusHandleId,
                session.JanusRoomId,
                session.ServerBaseUrl,
                Auth.Token!,
                Auth.CurrentUser!.Id.ToString(),
                !string.IsNullOrWhiteSpace(Auth.CurrentUser.DisplayName)
                    ? Auth.CurrentUser.DisplayName
                    : Auth.CurrentUser.UserName,
                BuildParticipantDirectory(),
                BuildParticipantAvatarDirectory(),
                session.IceServers
            );

            // Re-apply persisted call preferences after each fresh init.
            await WebRtc.ApplyStoredSettingsAsync();
            await SyncParticipantDirectoryAsync(force: true);
            Call.SetUseFloatingOverlayInActiveRoom(false);
        }
        catch (Exception ex)
        {
            Call.SetError($"Failed to join call: {ex.Message}");
        }
        finally
        {
            _joining = false;
        }
    }

