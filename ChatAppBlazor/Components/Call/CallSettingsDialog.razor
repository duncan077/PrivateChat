@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" /> Call Settings
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudSelect T="string" @bind-Value="_selectedMicId" Label="Microphone" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem T="string" Value="@("")">Default</MudSelectItem>
                @foreach (var mic in Store.Microphones)
                {
                    <MudSelectItem T="string" Value="@mic.DeviceId">@mic.Label</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" @bind-Value="_selectedCameraId" Label="Camera" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem T="string" Value="@("")">Default</MudSelectItem>
                @foreach (var cam in Store.Cameras)
                {
                    <MudSelectItem T="string" Value="@cam.DeviceId">@cam.Label</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" @bind-Value="_selectedResolution" Label="Resolution" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem T="string" Value="@("1920x1080")">1080p (1920x1080)</MudSelectItem>
                <MudSelectItem T="string" Value="@("1280x720")">720p (1280x720)</MudSelectItem>
                <MudSelectItem T="string" Value="@("640x480")">480p (640x480)</MudSelectItem>
                <MudSelectItem T="string" Value="@("480x360")">360p (480x360)</MudSelectItem>
            </MudSelect>

            <MudSelect T="int" @bind-Value="_selectedFps" Label="Frame Rate" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem T="int" Value="15">15 fps</MudSelectItem>
                <MudSelectItem T="int" Value="24">24 fps</MudSelectItem>
                <MudSelectItem T="int" Value="30">30 fps</MudSelectItem>
                <MudSelectItem T="int" Value="60">60 fps</MudSelectItem>
            </MudSelect>

            <MudSelect T="int" @bind-Value="_selectedBitrate" Label="Bitrate" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem T="int" Value="500">500 kbps (Low)</MudSelectItem>
                <MudSelectItem T="int" Value="1000">1 Mbps</MudSelectItem>
                <MudSelectItem T="int" Value="2000">2 Mbps (Default)</MudSelectItem>
                <MudSelectItem T="int" Value="4000">4 Mbps</MudSelectItem>
                <MudSelectItem T="int" Value="6000">6 Mbps</MudSelectItem>
                <MudSelectItem T="int" Value="8000">8 Mbps (High)</MudSelectItem>
            </MudSelect>

            <div>
                <MudText Typo="Typo.body2" Class="mb-1">Mic Volume: @($"{_volume:P0}")</MudText>
                <MudSlider T="double" Value="_volume" Min="0" Max="2" Step="0.1"
                           Color="Color.Primary" ValueChanged="OnVolumeChanged" />
            </div>

            <MudDivider Class="my-1" />

            @* Push-to-talk *@
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">Push to Talk</MudText>
                <MudSwitch T="bool" Value="_pttEnabled" Color="Color.Primary"
                           ValueChanged="OnPttToggled" />
            </MudStack>

            @if (_pttEnabled)
            {
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Shortcut:</MudText>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@FormatShortcut(_pttKey)</MudChip>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Keyboard" OnClick="StartPttCapture">
                            @(_capturingPtt ? "Listening..." : "Set Shortcut")
                        </MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                                   OnClick="ResetPttShortcut">
                            Reset to default (Space)
                        </MudButton>
                        @if (_capturingPtt)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                                       OnClick="StopPttCapture">Cancel</MudButton>
                        }
                    </MudStack>

                    @if (_capturingPtt)
                    {
                        <div class="ptt-capture-box"
                             tabindex="0"
                             @ref="_pttCaptureBox"
                             @onkeydown="CapturePttShortcut"
                             @onkeydown:preventDefault="true"
                             @onkeydown:stopPropagation="true">
                            Press a key or combo (example: Ctrl + Shift + V). Press Esc to cancel.
                        </div>
                    }

                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Hold the shortcut to unmute. Release to mute.
                    </MudText>
                </MudStack>
            }

            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="RefreshDevices"
                       StartIcon="@Icons.Material.Filled.Refresh" FullWidth="true" Size="Size.Small">
                Refresh Devices
            </MudButton>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Apply">Apply</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public CallStore Store { get; set; } = null!;
    [Parameter] public WebRtcBridge WebRtc { get; set; } = null!;

    private string _selectedMicId = "";
    private string _selectedCameraId = "";
    private string _selectedResolution = "1280x720";
    private int _selectedFps = 30;
    private int _selectedBitrate = 2000;
    private double _volume = 1.0;
    private bool _pttEnabled;
    private string _pttKey = "Space";
    private bool _capturingPtt;
    private ElementReference _pttCaptureBox;
    private readonly HashSet<string> _captureModifiers = [];

    protected override void OnInitialized()
    {
        _selectedMicId = Store.SelectedMicId ?? "";
        _selectedCameraId = Store.SelectedCameraId ?? "";
        _selectedResolution = Store.SelectedResolution;
        _selectedFps = Store.SelectedFps;
        _selectedBitrate = Store.SelectedBitrate;
        _volume = Store.Volume;
        _pttEnabled = Store.PushToTalkEnabled;
        _pttKey = string.IsNullOrWhiteSpace(Store.PushToTalkKey) ? "Space" : Store.PushToTalkKey;
    }

    private async Task Apply()
    {
        Store.ApplyCallSettings(_selectedMicId, _selectedCameraId, _selectedResolution, _selectedFps, _selectedBitrate);
        Store.SetPushToTalkPreference(_pttEnabled, _pttKey);

        await WebRtc.UpdateSettingsAsync(
            string.IsNullOrEmpty(_selectedMicId) ? null : _selectedMicId,
            string.IsNullOrEmpty(_selectedCameraId) ? null : _selectedCameraId,
            _selectedResolution,
            _selectedFps,
            _selectedBitrate
        );

        // Apply push-to-talk setting
        await WebRtc.SetPushToTalkAsync(_pttEnabled, _pttKey);

        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task RefreshDevices()
    {
        await WebRtc.EnumerateDevicesAsync();
    }

    private async Task OnVolumeChanged(double vol)
    {
        _volume = vol;
        Store.SetVolumePreference(vol);
        await WebRtc.SetVolumeAsync(vol);
    }

    private async Task OnPttToggled(bool enabled)
    {
        _pttEnabled = enabled;
        if (!enabled) _capturingPtt = false;
        Store.SetPushToTalkPreference(enabled, _pttKey);
        await WebRtc.SetPushToTalkAsync(enabled, _pttKey);
    }

    private async Task StartPttCapture()
    {
        _capturingPtt = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1);
        try { await _pttCaptureBox.FocusAsync(); } catch { }
    }

    private void StopPttCapture()
    {
        _capturingPtt = false;
        _captureModifiers.Clear();
    }

    private async Task CapturePttShortcut(KeyboardEventArgs e)
    {
        if (!_capturingPtt) return;

        if (string.Equals(e.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            _capturingPtt = false;
            _captureModifiers.Clear();
            return;
        }

        // Track held modifiers while listening; don't finalize on modifier-only keydown.
        if (e.CtrlKey) _captureModifiers.Add("Ctrl");
        if (e.AltKey) _captureModifiers.Add("Alt");
        if (e.ShiftKey) _captureModifiers.Add("Shift");
        if (e.MetaKey) _captureModifiers.Add("Meta");

        var code = e.Code ?? string.Empty;
        if (string.IsNullOrWhiteSpace(code) || IsModifierCode(code))
        {
            return;
        }

        var binding = BuildShortcutBinding(e);
        if (string.IsNullOrWhiteSpace(binding)) return;

        _pttKey = binding;
        _capturingPtt = false;
        _captureModifiers.Clear();
        Store.SetPushToTalkPreference(_pttEnabled, _pttKey);
        await WebRtc.SetPushToTalkAsync(_pttEnabled, _pttKey);
    }

    private string BuildShortcutBinding(KeyboardEventArgs e)
    {
        var parts = new List<string>();
        if (_captureModifiers.Contains("Ctrl")) parts.Add("Ctrl");
        if (_captureModifiers.Contains("Alt")) parts.Add("Alt");
        if (_captureModifiers.Contains("Shift")) parts.Add("Shift");
        if (_captureModifiers.Contains("Meta")) parts.Add("Meta");

        var code = e.Code ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(code))
        {
            parts.Add(code);
        }

        return string.Join("+", parts);
    }

    private static bool IsModifierCode(string code) =>
        code is "ControlLeft" or "ControlRight" or "ShiftLeft" or "ShiftRight" or "AltLeft" or "AltRight" or "MetaLeft" or "MetaRight";

    private static string ModifierFromCode(string code) => code switch
    {
        "ControlLeft" or "ControlRight" => "Ctrl",
        "ShiftLeft" or "ShiftRight" => "Shift",
        "AltLeft" or "AltRight" => "Alt",
        "MetaLeft" or "MetaRight" => "Meta",
        _ => code
    };

    private async Task ResetPttShortcut()
    {
        _pttKey = "Space";
        _capturingPtt = false;
        _captureModifiers.Clear();
        Store.SetPushToTalkPreference(_pttEnabled, _pttKey);
        await WebRtc.SetPushToTalkAsync(_pttEnabled, _pttKey);
    }

    private static string FormatShortcut(string binding)
    {
        if (string.IsNullOrWhiteSpace(binding)) return "Space";
        var tokens = binding.Split('+', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (tokens.Length == 0) return "Space";

        return string.Join(" + ", tokens.Select(FormatShortcutToken));
    }

    private static string FormatShortcutToken(string token)
    {
        return token switch
        {
            "Ctrl" => "Ctrl",
            "Alt" => "Alt",
            "Shift" => "Shift",
            "Meta" => "Meta",
            "Space" => "Space",
            _ when token.StartsWith("Key", StringComparison.Ordinal) && token.Length == 4
                => token[3].ToString().ToUpperInvariant(),
            _ when token.StartsWith("Digit", StringComparison.Ordinal) && token.Length == 6
                => token[5].ToString(),
            _ when token.StartsWith("Numpad", StringComparison.Ordinal)
                => token.Replace("Numpad", "Num ", StringComparison.Ordinal),
            _ when token.StartsWith("Arrow", StringComparison.Ordinal)
                => token.Replace("Arrow", string.Empty, StringComparison.Ordinal),
            "Backquote" => "`",
            "CapsLock" => "Caps Lock",
            _ => token
        };
    }
}
