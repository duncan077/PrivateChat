@implements IDisposable
@inject CallStore Store
@inject ChatRoomStore Rooms
@inject DirectMessageStore DirectMessages
@inject WebRtcBridge WebRtc
@inject NavigationManager Nav
@inject IJSRuntime JS

@* ─── Floating PiP overlay shown when in a call but NOT on the call room page ─── *@

@if (Store.IsInCall && (!_isOnCallContextPage || Store.UseFloatingOverlayInActiveRoom))
{
    <div id="floatingCallOverlay" class="floating-call-overlay @(_minimized ? "minimized" : "")">
        <div id="floatingCallOverlayHeader" class="float-header">
            <MudText Typo="Typo.caption" Class="float-title">In Call</MudText>
            <MudStack Row Spacing="0">
                <MudIconButton Icon="@(_minimized ? Icons.Material.Filled.OpenInFull : Icons.Material.Filled.CloseFullscreen)"
                               Size="Size.Small" Color="Color.Inherit"
                               OnClick="ToggleMinimize" title="@(_minimized ? "Expand" : "Minimize")" />
                <MudIconButton Icon="@Icons.Material.Filled.CallEnd"
                               Size="Size.Small" Color="Color.Error"
                               OnClick="LeaveCall" title="Leave Call" />
            </MudStack>
        </div>

        @if (!_minimized)
        {
            <div id="floatVideoContainer" class="float-video-area">
                <video id="floatLocalVideo" autoplay muted playsinline></video>
            </div>

            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1" Class="float-controls">
                <MudIconButton Icon="@(Store.IsMuted ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)"
                               Size="Size.Small"
                               Color="@(Store.IsMuted ? Color.Error : Color.Default)"
                               OnClick="ToggleMute" />
                <MudIconButton Icon="@(Store.IsCameraOff ? Icons.Material.Filled.VideocamOff : Icons.Material.Filled.Videocam)"
                               Size="Size.Small"
                               Color="@(Store.IsCameraOff ? Color.Error : Color.Default)"
                               OnClick="ToggleCamera" />
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           OnClick="GoToCall">Return</MudButton>
            </MudStack>
        }
    </div>
}

@code {
    private bool _minimized;
    private bool _isOnCallContextPage;
    private bool? _lastFloatVideoVisible;

    protected override void OnInitialized()
    {
        Store.OnChange += OnStoreChanged;
        Rooms.OnChange += OnRoomsChanged;
        Nav.LocationChanged += OnLocationChanged;
        CheckIfOnCallRoom();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldShowFloatVideo = Store.IsInCall
            && (!_isOnCallContextPage || Store.UseFloatingOverlayInActiveRoom)
            && !_minimized;
        if (!firstRender && _lastFloatVideoVisible == shouldShowFloatVideo)
        {
            return;
        }

        _lastFloatVideoVisible = shouldShowFloatVideo;
        if (shouldShowFloatVideo)
        {
            try
            {
                await JS.InvokeVoidAsync("overlayDrag.initFloatingCallDrag", "floatingCallOverlay", "floatingCallOverlayHeader");
                await WebRtc.MoveVideoToFloatAsync("floatVideoContainer");
            }
            catch { }
            return;
        }

        try
        {
            await WebRtc.ClearFloatVideoAsync("floatVideoContainer");
        }
        catch { }
    }

    private void CheckIfOnCallRoom()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var pathOnly = relative.Split('?', '#')[0].Trim('/').ToLowerInvariant();
        if (!Store.IsInCall)
        {
            _isOnCallContextPage = false;
            return;
        }

        if (Store.ActiveCallKind == CallContextKind.DirectMessage)
        {
            var activePeer = Store.ActiveDirectPeerUserId;
            var onDmRoute = pathOnly == "dm";
            var directStoreSelected = activePeer != null && DirectMessages.SelectedContactId == activePeer;
            var querySelected = activePeer != null && TryGetQueryGuid("userId", out var queryUserId) && queryUserId == activePeer.Value;
            _isOnCallContextPage = onDmRoute && (directStoreSelected || querySelected);
            return;
        }

        var isRoomsRoute = string.IsNullOrEmpty(pathOnly);
        _isOnCallContextPage = isRoomsRoute && Rooms.SelectedRoomId == Store.ActiveRoomId;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CheckIfOnCallRoom();
        InvokeAsync(StateHasChanged);
    }

    private void OnRoomsChanged()
    {
        CheckIfOnCallRoom();
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleMute() => await WebRtc.ToggleMuteAsync();
    private async Task ToggleCamera() => await WebRtc.ToggleCameraAsync();
    private void ToggleMinimize() => _minimized = !_minimized;

    private async Task GoToCall()
    {
        if (Store.ActiveCallKind == CallContextKind.DirectMessage
            && Store.ActiveDirectPeerUserId is Guid activePeerId
            && activePeerId != Guid.Empty)
        {
            Store.SetUseFloatingOverlayInActiveRoom(false);
            Nav.NavigateTo($"/dm?userId={Uri.EscapeDataString(activePeerId.ToString())}");
            return;
        }

        var activeRoomId = Store.ActiveRoomId;
        if (activeRoomId == null || activeRoomId == Guid.Empty)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            Store.SetUseFloatingOverlayInActiveRoom(false);
            await Rooms.SelectRoomAsync(activeRoomId.Value, keepPreviousRoomSubscription: true);
        }
        catch
        {
            // Navigation still ensures ChatRooms attempts opening the call room from query.
        }

        Nav.NavigateTo($"/?roomId={Uri.EscapeDataString(activeRoomId.Value.ToString())}");
    }

    private async Task LeaveCall()
    {
        await WebRtc.StopAsync("ui-leave-floating-overlay");
        await Store.LeaveCallAsync();
    }

    private void OnStoreChanged()
    {
        CheckIfOnCallRoom();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Store.OnChange -= OnStoreChanged;
        Rooms.OnChange -= OnRoomsChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private bool TryGetQueryGuid(string key, out Guid value)
    {
        value = Guid.Empty;
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = uri.Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            return false;
        }

        var trimmed = query.TrimStart('?');
        foreach (var pair in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=');
            var rawKey = separator >= 0 ? pair[..separator] : pair;
            if (!rawKey.Equals(key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var rawValue = separator >= 0 ? pair[(separator + 1)..] : string.Empty;
            var decoded = Uri.UnescapeDataString(rawValue);
            return Guid.TryParse(decoded, out value);
        }

        return false;
    }
}
