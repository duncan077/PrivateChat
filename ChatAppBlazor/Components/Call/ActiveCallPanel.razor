@implements IAsyncDisposable
@inject CallStore Store
@inject WebRtcBridge WebRtc

@* ─── Embedded call panel shown inside ChatRooms when IsInCall ─── *@
@* ChatRooms handles joining + WebRtc.InitAsync. This is purely the controls UI. *@

<div class="call-panel-container">
    @* Video grid *@
    <div id="videoGrid" class="call-video-grid">
        <div class="video-cell local-cell">
            <video id="localVideo" autoplay muted playsinline></video>
            <MudChip T="string" Size="Size.Small" Class="video-label-chip">You</MudChip>
        </div>
    </div>

    @* Screen-share annotation tools.
       The anchor/host pair exists for fullscreen: element fullscreen renders only
       the fullscreened cell's subtree, so webrtc-manager physically moves the host
       div into the fullscreen cell (and back to the anchor on exit) to keep the
       tools reachable. Blazor keeps patching the host's children by node
       reference, so the temporary reparenting is invisible to it. *@
    <div id="annotationToolbarAnchor" style="display:none"></div>
    <div id="annotationToolbarHost" class="annotation-toolbar-host">
        <AnnotationToolbar />
    </div>

    @* Controls toolbar *@
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="call-controls-bar">
        @if (Store.PushToTalkEnabled)
        {
            <MudChip T="string" Size="Size.Small" Color="@(Store.IsMuted ? Color.Warning : Color.Success)"
                     Variant="Variant.Filled" Class="ptt-indicator">
                PTT @(Store.IsMuted ? "Ready" : "Talking")
            </MudChip>
        }

        <MudIconButton Icon="@(Store.IsMuted ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)"
                       Color="@(Store.IsMuted ? Color.Error : Color.Default)"
                       Variant="Variant.Filled"
                       OnClick="ToggleMute" />

        @* Both are disabled until the publisher is negotiated. Pressing them earlier
           started the local capture and published nothing, so the preview lit up while
           nobody else received a frame. *@
        <MudTooltip Text="@MediaControlTooltip">
            <MudIconButton Icon="@(Store.IsCameraOff ? Icons.Material.Filled.VideocamOff : Icons.Material.Filled.Videocam)"
                           Color="@(Store.IsCameraOff ? Color.Error : Color.Default)"
                           Variant="Variant.Filled"
                           Disabled="@(!Store.IsPublisherReady)"
                           OnClick="ToggleCamera" />
        </MudTooltip>

        <MudTooltip Text="@MediaControlTooltip">
            <MudIconButton Icon="@(Store.IsScreenSharing ? Icons.Material.Filled.StopScreenShare : Icons.Material.Filled.ScreenShare)"
                           Color="@(Store.IsScreenSharing ? Color.Warning : Color.Default)"
                           Variant="Variant.Filled"
                           Disabled="@(!Store.IsPublisherReady)"
                           OnClick="ToggleScreenShare" />
        </MudTooltip>

        <MudTooltip Text="@(Store.HideNonVideoParticipants ? "Show all participants" : "Hide participants without video (audio stays on)")">
            <MudIconButton Icon="@(Store.HideNonVideoParticipants ? Icons.Material.Filled.PersonOff : Icons.Material.Filled.People)"
                           Color="@(Store.HideNonVideoParticipants ? Color.Primary : Color.Default)"
                           Variant="Variant.Filled"
                           OnClick="ToggleHideNonVideo" />
        </MudTooltip>

        <MudIconButton Icon="@Icons.Material.Filled.CallEnd"
                       Color="Color.Error"
                       Variant="Variant.Filled"
                       OnClick="LeaveCall" />
    </MudStack>

</div>

@code {
    [Parameter] public Guid RoomId { get; set; }
    [Parameter] public string RoomName { get; set; } = "";

    private string MediaControlTooltip => Store.IsPublisherReady
        ? "Camera and screen share"
        : "Connecting to the call - available in a moment";

    protected override void OnInitialized()
    {
        Store.OnChange += OnStoreChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await WebRtc.RebindVideoElementsAsync();
            // Blazor recreated #videoGrid, so the filter class must be re-stamped.
            await WebRtc.SetHideNonVideoTilesAsync(Store.HideNonVideoParticipants);
            await Store.RefreshAnnotationStateAsync();
        }
        catch
        {
            // Ignore transient JS interop errors while navigating.
        }
    }

    private async Task LeaveCall()
    {
        try { await WebRtc.StopAsync("ui-leave-active-panel"); } catch { }
        await Store.LeaveCallAsync();
    }

    private async Task ToggleMute()
    {
        try { await WebRtc.ToggleMuteAsync(); } catch { }
    }

    private async Task ToggleCamera()
    {
        try { await WebRtc.ToggleCameraAsync(); } catch { }
    }

    private async Task ToggleScreenShare()
    {
        try
        {
            if (Store.IsScreenSharing)
                await WebRtc.StopScreenShareAsync();
            else
                await WebRtc.StartScreenShareAsync();
        }
        catch { }
    }

    private async Task ToggleHideNonVideo()
    {
        Store.ToggleHideNonVideoParticipants();
        try { await WebRtc.SetHideNonVideoTilesAsync(Store.HideNonVideoParticipants); } catch { }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Store.OnChange -= OnStoreChanged;
        // DO NOT stop the call on dispose — the call persists via singleton WebRtcBridge
    }
}
